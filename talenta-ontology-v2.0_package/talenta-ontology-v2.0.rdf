    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#minConstructionHeight">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="de">Gibt die minimale Konstruktionshöhe an. Einheit in [m].</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the minimum construction height.

Unit in [m].</rdfs:comment>
        <rdfs:label xml:lang="de">Konstruktionshöhe min.</rdfs:label>
        <rdfs:label xml:lang="en">minimum construction height</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/bridge#minCoveredHeight -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#minCoveredHeight">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="en">Specifies the minimum covered height.

Unit in [m].</rdfs:comment>
        <rdfs:label xml:lang="de">Min. Überschüttungshöhe</rdfs:label>
        <rdfs:label xml:lang="en">minimum covered height</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/bridge#overalLength -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#overalLength">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="de">Gibt die Gesamtlänge der Brücke an. Einheit in [m].</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the total length of the bridge.

Unit in [m].</rdfs:comment>
        <rdfs:label xml:lang="de">Gesamtlänge</rdfs:label>
        <rdfs:label xml:lang="en">overall length</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/bridge#overallWidth -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#overallWidth">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="de">Gibt die Gesamtbreite der Brücke an. Einheit in [m].</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the total width of the bridge. 

Unit in [m].</rdfs:comment>
        <rdfs:label xml:lang="de">Gesamtbreite</rdfs:label>
        <rdfs:label xml:lang="en">overall width</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/bridge#spacingSuperStructure -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#spacingSuperStructure">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="de">Gibt den Zwischenraum der Überbauten an. Einheit in [m].</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the space between the superstructures. 

Unit in [m].</rdfs:comment>
        <rdfs:label xml:lang="de">Zwischenraum Überbauten</rdfs:label>
        <rdfs:label xml:lang="en">spacing between superstructures</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/bridge#underTraffic -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#underTraffic">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="de">Gibt an ob die Brücke einer Verkehrslast ausgesetzt ist bzw. befahren wird.

true = Unter Vekehr / befahren
false = Nicht unter Verkehr / gesperrt</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates whether the bridge is exposed to a traffic load.

true = Under traffic / traffic
false = Not under traffic / blocked</rdfs:comment>
        <rdfs:label xml:lang="de">Stadium</rdfs:label>
        <rdfs:label xml:lang="en">under traffic</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#alignmentWidth -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#alignmentWidth">
        <rdfs:comment xml:lang="en">Distance to alignment reference point</rdfs:comment>
        <rdfs:comment xml:lang="de">Entfernung zum Alignment-Referenzpunkt</rdfs:comment>
        <rdfs:label xml:lang="en">alignment width</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#assessmentYear -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#assessmentYear">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brstr#StructuralAssessment"/>
        <rdfs:comment xml:lang="en">The year in which the bridge structure has been assessed regarding the structural capability</rdfs:comment>
        <rdfs:label xml:lang="de">Einstufung (Jahr)</rdfs:label>
        <rdfs:label xml:lang="en">assessment year</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#breakingLimit -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#breakingLimit">
        <rdfs:comment xml:lang="en">Defines the breaking limit of a construction component.</rdfs:comment>
        <rdfs:label xml:lang="de">Bruchgrenze</rdfs:label>
        <rdfs:label xml:lang="en">breaking limit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#degreeOfFreedom -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#degreeOfFreedom">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brstr#LoadBearingComponent"/>
        <rdfs:comment xml:lang="en">The degree of freedom at which a LoadBearingComponent can move or rotate.</rdfs:comment>
        <rdfs:label xml:lang="de">Freiheitsgrad</rdfs:label>
        <rdfs:label xml:lang="en">degree of freedom</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#effectiveSupportCapacity -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#effectiveSupportCapacity">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brstr#LoadBearingComponent"/>
        <rdfs:comment xml:lang="de">Folgende Werte sind möglich:

- Dezimalwert in [m]

- &apos;reduced&apos; für reduzierte Stützweite (kennzeichnet zu variierenden Wert)</rdfs:comment>
        <rdfs:comment xml:lang="en">The following values are possible:

- Decimal value in [m].

- &apos;reduced&apos; for reduced span (indicates value to be varied)</rdfs:comment>
        <rdfs:label xml:lang="de">Effektive Stützweite</rdfs:label>
        <rdfs:label xml:lang="en">effective support capacity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#movement -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#movement">
        <rdfs:subPropertyOf rdf:resource="https://wisib.de/ontologie/brstr#degreeOfFreedom"/>
        <rdfs:comment xml:lang="en">Defines at which extend a LoadBearingComponent can move</rdfs:comment>
        <rdfs:label xml:lang="en">movement</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#rotation -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#rotation">
        <rdfs:subPropertyOf rdf:resource="https://wisib.de/ontologie/brstr#degreeOfFreedom"/>
        <rdfs:comment xml:lang="en">Defines at which extend a LoadBearingComponent can rotate</rdfs:comment>
        <rdfs:label xml:lang="en">rotation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#singleTrackLaneWidth -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#singleTrackLaneWidth">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brstr#StructuralAssessmentSTANAG2021"/>
        <rdfs:comment xml:lang="en">The width of a single track lane</rdfs:comment>
        <rdfs:label xml:lang="de">Einbahnverkehr</rdfs:label>
        <rdfs:label xml:lang="en">single track lane width</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#spanWidth -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#spanWidth">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brstr#Span"/>
        <rdfs:comment xml:lang="en">Width which is spanned by a component (bridge, vault, roof, floor slab) between the elements supporting this component (abutment, pier, column, support, load-bearing wall) without other support.</rdfs:comment>
        <rdfs:label xml:lang="de">Stützweite</rdfs:label>
        <rdfs:label xml:lang="en">span width</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#structuralCapabilityLevel -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#structuralCapabilityLevel">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brstr#StructuralAssessment"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Structural capability grade based on German standard</rdfs:comment>
        <rdfs:label xml:lang="de">Tragfähigkeit (nach entsprechender Norm)</rdfs:label>
        <rdfs:label xml:lang="en">structural capability level</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#supportHeight -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#supportHeight">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brstr#LoadBearingComponent"/>
        <rdfs:comment xml:lang="de">Gibt die Höhe der Stütze bzw. des stützenden Elements im Vergleich zum Nullpunkt an.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the height of the column or supporting element compared to the zero point.</rdfs:comment>
        <rdfs:label xml:lang="de">Stützungshöhe</rdfs:label>
        <rdfs:label xml:lang="en">support height</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#twoTrackLaneWidth -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#twoTrackLaneWidth">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brstr#StructuralAssessmentSTANAG2021"/>
        <rdfs:comment xml:lang="en">The width of a two track lanes</rdfs:comment>
        <rdfs:label xml:lang="de">Zweibahnverkehr</rdfs:label>
        <rdfs:label xml:lang="en">two track lane width</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#xDegreeOfFreedom -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#xDegreeOfFreedom">
        <rdfs:subPropertyOf rdf:resource="https://wisib.de/ontologie/brstr#degreeOfFreedom"/>
        <rdfs:comment xml:lang="en">The degree of freedom at which a LoadBearingComponent can move or rotate along to the x-axis.</rdfs:comment>
        <rdfs:label xml:lang="en">degree of freedom along to X-axis</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#xMovement -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#xMovement">
        <rdfs:subPropertyOf rdf:resource="https://wisib.de/ontologie/brstr#movement"/>
        <rdfs:subPropertyOf rdf:resource="https://wisib.de/ontologie/brstr#xDegreeOfFreedom"/>
        <rdfs:comment xml:lang="en">Defines at which extend a LoadBearingComponent can move along the x-axis.</rdfs:comment>
        <rdfs:label xml:lang="de">Freiheitsgrad (x-Bewegungsrichtung)</rdfs:label>
        <rdfs:label xml:lang="en">X movement</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#xRotation -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#xRotation">
        <rdfs:subPropertyOf rdf:resource="https://wisib.de/ontologie/brstr#rotation"/>
        <rdfs:subPropertyOf rdf:resource="https://wisib.de/ontologie/brstr#xDegreeOfFreedom"/>
        <rdfs:comment xml:lang="en">Defines at which extend a LoadBearingComponent can rotate along the x-axis.</rdfs:comment>
        <rdfs:label xml:lang="de">Freiheitsgrad (x-Rotationsrichtung)</rdfs:label>
        <rdfs:label xml:lang="en">X rotation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#yDegreeOfFreedom -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#yDegreeOfFreedom">
        <rdfs:subPropertyOf rdf:resource="https://wisib.de/ontologie/brstr#degreeOfFreedom"/>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#yMovement -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#yMovement">
        <rdfs:subPropertyOf rdf:resource="https://wisib.de/ontologie/brstr#movement"/>
        <rdfs:subPropertyOf rdf:resource="https://wisib.de/ontologie/brstr#yDegreeOfFreedom"/>
        <rdfs:comment xml:lang="en">Defines at which extend a LoadBearingComponent can move along the y-axis.</rdfs:comment>
        <rdfs:label xml:lang="de">Freiheitsgrad (y-Bewegungsrichtung)</rdfs:label>
        <rdfs:label xml:lang="en">Y movement</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#yRotation -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#yRotation">
        <rdfs:subPropertyOf rdf:resource="https://wisib.de/ontologie/brstr#rotation"/>
        <rdfs:subPropertyOf rdf:resource="https://wisib.de/ontologie/brstr#yDegreeOfFreedom"/>
        <rdfs:comment xml:lang="en">Defines at which extend a LoadBearingComponent can rotate along the y-axis.</rdfs:comment>
        <rdfs:label xml:lang="de">Freiheitsgrad (y-Rotationsrichtung)</rdfs:label>
        <rdfs:label xml:lang="en">Y rotation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#yieldStrength -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#yieldStrength">
        <rdfs:comment xml:lang="en">Defines the yield strength of a construction component.</rdfs:comment>
        <rdfs:label xml:lang="de">Streckgrenze</rdfs:label>
        <rdfs:label xml:lang="en">yield strength</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#zDegreeOfFreedom -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#zDegreeOfFreedom">
        <rdfs:subPropertyOf rdf:resource="https://wisib.de/ontologie/brstr#degreeOfFreedom"/>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#zMovement -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#zMovement">
        <rdfs:subPropertyOf rdf:resource="https://wisib.de/ontologie/brstr#movement"/>
        <rdfs:subPropertyOf rdf:resource="https://wisib.de/ontologie/brstr#zDegreeOfFreedom"/>
        <rdfs:comment xml:lang="en">Defines at which extend a LoadBearingComponent can move along the z-axis.</rdfs:comment>
        <rdfs:label xml:lang="de">Freiheitsgrad (z-Bewegungsrichtung)</rdfs:label>
        <rdfs:label xml:lang="en">Z movement</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brstr#zRotation -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brstr#zRotation">
        <rdfs:subPropertyOf rdf:resource="https://wisib.de/ontologie/brstr#rotation"/>
        <rdfs:subPropertyOf rdf:resource="https://wisib.de/ontologie/brstr#zDegreeOfFreedom"/>
        <rdfs:comment xml:lang="en">Defines at which extend a LoadBearingComponent can rotate along the z-axis.</rdfs:comment>
        <rdfs:label xml:lang="de">Freiheitsgrad (z-Rotationsrichtung)</rdfs:label>
        <rdfs:label xml:lang="en">Z rotation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://dbpedia.org/ontology/AdministrativeRegion -->

    <owl:Class rdf:about="http://dbpedia.org/ontology/AdministrativeRegion">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#BridgeInfrastructure"/>
    </owl:Class>
    


    <!-- http://dbpedia.org/ontology/City -->

    <owl:Class rdf:about="http://dbpedia.org/ontology/City">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#BridgeInfrastructure"/>
    </owl:Class>
    


    <!-- http://dbpedia.org/ontology/Organisation -->

    <owl:Class rdf:about="http://dbpedia.org/ontology/Organisation">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#BridgeInfrastructure"/>
    </owl:Class>
    


    <!-- http://dbpedia.org/page/Orientation_(geometry) -->

    <owl:Class rdf:about="http://dbpedia.org/page/Orientation_(geometry)">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#BridgeInfrastructure"/>
    </owl:Class>
    


    <!-- http://http://www.opengis.net/ont/geosparql#Geometry -->

    <owl:Class rdf:about="http://http://www.opengis.net/ont/geosparql#Geometry">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
    </owl:Class>
    


    <!-- http://http://www.opengis.net/ont/geosparql#Polygon -->

    <owl:Class rdf:about="http://http://www.opengis.net/ont/geosparql#Polygon">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#TransportationSystemThing"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/5087/1/Time/TimeOntologyThing -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/5087/1/Time/TimeOntologyThing">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#TransportationSystemThing"/>
        <dc:description>Class added for organizational purposes, to identify classes defined in the Time Ontology.</dc:description>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Cardinality_unit -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Cardinality_unit">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Unit"/>
        <rdfs:comment>Just as the meter is the unit of measure for length, a gci:Cardinality_unit is the unit of measure for the size of a set. The gci:Cardinality_unit is a ratio scale: gci:Cardinality_scale, which is a subclass of om:Ratio_scale and is has a zero element (namely zero).</rdfs:comment>
        <rdfs:comment>Reused from GCI Foundation Ontology</rdfs:comment>
        <rdfs:label>Cardinality Unit</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Population -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Population">
        <owl:equivalentClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Population"/>
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/OMThing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#defined_by"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#for_time_interval"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2006/time#DateTimeDescription"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The govstat Population is specialized for indicator use to include what defines a member of the population, the location of the population, and the time the population was measured.</rdfs:comment>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Population_measure -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Population_measure">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/CardinalityMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasUnit"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Cardinality_unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Reused from GCI Foundation ontology</rdfs:comment>
        <rdfs:label>Population Measure</rdfs:label>
        <rdfs:label>gci:Cardinality_unit is the unit of measure for the size of a set. The gci:Cardinality_unit is a ratio scale: gci:Cardinality_scale, which is a subclass of om:Ratio_scale and is has a zero element (namely zero).</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Population_size -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Population_size">
        <owl:equivalentClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Distinct_count"/>
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Quantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasValue"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Population_measure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/govstat.owl#cardinality_of"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Population"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Reused from GCI Foundation ontology: http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl</rdfs:comment>
        <rdfs:comment>gci:Population_size is a subclass of om:Quantity.  Its om:unit_of_measure is the gci:population_cardinality_unit. It is also a subclass of gs:Cardinality which provides the cardinality_of property that links to a gs:Population.</rdfs:comment>
        <rdfs:label>Population Size</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Application_area -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Application_area">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Binary_prefix -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Binary_prefix">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Cardinal_scale -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Cardinal_scale">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Measurement_scale"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#element"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Fixed_point"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">cardinal scale</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Cardinality -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Cardinality">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Parameter"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#cardinality_of"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Population"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Cardinality of the Population.
Note that there is no property that links Cardinality to a Variable.</rdfs:comment>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Cardinality_scale -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Cardinality_scale">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Ratio_scale"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#zero_element"/>
                <owl:hasValue rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#fixed_zero_cardinality"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Cardinality_unit -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Cardinality_unit">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Singular_unit"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#unit_of_measure"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Cardinality_scale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#City -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#City">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
        <rdfs:subClassOf rdf:resource="http://schema.org/City"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Compound_unit -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Compound_unit">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_of_measure"/>
        <rdfs:label xml:lang="en">compound unit</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#DifferenceIndicator -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#DifferenceIndicator">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Indicator"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#term_1"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Quantity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#term_2"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Quantity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Difference between term_1 and term_2 (term_1 - term_2)</rdfs:comment>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Dimension -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Dimension">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Distinct_count -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Distinct_count">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Parameter"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#distinct_count_of"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Population"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Distinct_count class that is a Parameter that represents
         the number of distinct values of a property of the members of a
         Population</rdfs:comment>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Feature -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Feature">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#hasGeometry"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Fixed_point -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Fixed_point">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Point"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#definition"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Fixed_point"/>
                            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Measure"/>
                            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Quantity"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">fixed point</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Fixed_zero_point -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Fixed_zero_point">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Fixed_point"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#numerical_value"/>
                <owl:hasValue>0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">fixed zero point</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Geometry -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Geometry">
        <rdfs:subClassOf rdf:resource="http://http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://http://www.opengis.net/ont/geosparql#asWKT"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#TransportationSystemThing"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Indicator -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Indicator">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Quantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#for_city"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#City"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#for_time_interval"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2006/time#DateTimeInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:description xml:lang="en">An indicator is a quantity that is a ratio of a numerator and denominator that are also quantities. It has a city and time period associated with it. The numerator and denominator quantities can have different units of measure. One example of a unit of measure is the size of a population. A population_cardinality_unit is defined to be an individual of a Cardinality_unit that is a subclass of a Singular_unit.</dc:description>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Interval_scale -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Interval_scale">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Cardinal_scale"/>
        <rdfs:label xml:lang="en">interval scale</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Mean -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Mean">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Parameter"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#mean_of"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Population"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Standard_deviation"/>
        <rdfs:comment xml:lang="en">Mean represents the mean value of a property all members of the Population have and is specified by the parameter_of_var property.</rdfs:comment>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Measure -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Measure">
        <owl:equivalentClass rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Measure"/>
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#hasUnit"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_of_measure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#unit_of_measure"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_of_measure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#hasNumericalValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#numerical_value"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A measure combines a number to a unit of measure or an interval or ratio scale. For example, &quot;3 m&quot; is a measure.</rdfs:comment>
        <rdfs:label xml:lang="en">measure</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Measurement_scale -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Measurement_scale">
        <owl:equivalentClass rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Scale"/>
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Interval_scale"/>
            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Nominal_scale"/>
            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Ordinal_scale"/>
            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Ratio_scale"/>
        </owl:disjointUnionOf>
        <rdfs:comment xml:lang="en">Measurement scales are concepts used for the expression of quantities. Four types of measurement scales are: nominal scales, ordinal scales, interval scales and ratio scales. The latter two scales are also called cardinal scales. An example of a scale is the Celsius scale, a temperature scale.</rdfs:comment>
        <rdfs:label xml:lang="en">measurement scale</rdfs:label>
        <om-1:alternative_label xml:lang="en">scale</om-1:alternative_label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Measurement_scale_category -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Measurement_scale_category">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Monetary_unit -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Monetary_unit">
        <owl:equivalentClass rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/AmountOfMoneyUnit"/>
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Singular_unit"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Nominal_scale -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Nominal_scale">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Measurement_scale"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#element"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Measurement_scale_category"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">nominal scale</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Observation -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Observation">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#member_of"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Population"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#has_characteristic"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Variable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Observation</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Ordered_measurement_scale_category -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Ordered_measurement_scale_category">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Ordinal_scale -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Ordinal_scale">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Measurement_scale"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#element"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Ordered_measurement_scale_category"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">ordinal scale</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Parameter -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Parameter">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Quantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#parameter_of_var"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Variable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Parameter is the Class of all  measures that can be made of a Population, both statistical, e.g., Mean, Starndard_devation, and others, e.g., Cardinality, Sum.</rdfs:comment>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Phenomenon -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Phenomenon">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
        <rdfs:comment xml:lang="en">A phenomenon is the qualitative object (e.g., food, star, molecule) that has quantifiable (standardized) aspects (e.g, length, mass, time).</rdfs:comment>
        <rdfs:label xml:lang="en">phenomenon</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Point -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Point">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
        <rdfs:comment xml:lang="en">A point is an element of an interval scale or a ratio scale, for example, 273.16 on the Kelvin scale indicates the triple point of water thermodynamic temperature.</rdfs:comment>
        <rdfs:label xml:lang="en">point</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Population -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Population">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#defined_by"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#for_time_interval"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2006/time#DateTimeInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#is_composed_of"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#is_described_by"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#definition"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Feature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:description xml:lang="en">The core class is the Population to be measured. A Population is linked to a parameter (e.g., mean, standard deviation, cardinality) by the is_described_by property, and the parameter is a sub class of Parameter. Depending on the subclass of Parameter, there is a reverse link back to the Population.
  
parameter links back to the using cardinality_of. parameter links back using the   property. parameter links back using the mean_of property.</dc:description>
        <rdfs:label xml:lang="en">Population</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Prefix -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Prefix">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Binary_prefix"/>
            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#SI_prefix"/>
        </owl:disjointUnionOf>
        <rdfs:comment xml:lang="en">A prefix is a name that precedes a basic unit of measure to indicate a decimal multiple or fraction of the unit. Each prefix has a unique symbol that is prepended to the unit symbol. For example, an electric current of 0.000 000 001 ampere is written by using the SI-prefix nano as 1 nanoampere or 1 nA.</rdfs:comment>
        <rdfs:label xml:lang="en">prefix</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Quantity -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Quantity">
        <owl:equivalentClass rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Quantity"/>
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#commonlyHasUnit"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_of_measure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#hasPhenomenon"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#hasValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Measure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#unit_of_measure"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_of_measure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#value"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Measure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A quantity is a representation of a quantifiable (standardized) aspect (such as length, mass, and time) of a phenomenon (e.g., a star, food, or a molecule). Quantities are classified according to similarity in (implicit) metrological aspect, e.g. the length of my speedboat and the length of my racing car are classified as length.</rdfs:comment>
        <rdfs:label xml:lang="en">quantity</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#RatioIndicator -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#RatioIndicator">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Indicator"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#denominator"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Quantity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#numerator"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Quantity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#unit_of_measure"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_division"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Ratio_scale -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Ratio_scale">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Cardinal_scale"/>
        <rdfs:label xml:lang="en">ratio scale</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#SI_prefix -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#SI_prefix">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Prefix"/>
        <rdfs:label xml:lang="en">SI prefix</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Sample -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Sample">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#is_composed_of"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Observation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#is_described_by"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Statistic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#is_part_of"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Population"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Sample_cardinality -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Sample_cardinality">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Statistic"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Sample_mean -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Sample_mean">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Statistic"/>
        <owl:disjointWith rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Sample_standard_deviation"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Sample_standard_deviation -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Sample_standard_deviation">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Statistic"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Sample_sum -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Sample_sum">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Statistic"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Singular_unit -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Singular_unit">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Standard_deviation -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Standard_deviation">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Parameter"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#std_of"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Population"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Statistic -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Statistic">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#is_an_estimate_of"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Sum -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Sum">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Parameter"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#sum_of"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Population"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Sum defines the sum over a variable possessed by members of the Population.</rdfs:comment>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#SumIndicator -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#SumIndicator">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Indicator"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#term_1"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Quantity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#term_2"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Quantity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Sum of term_1 and term_2 (term_1 + term_2)</rdfs:comment>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#System_of_units -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#System_of_units">
        <owl:equivalentClass rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/System_of_units"/>
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_division -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_division">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#denominator"/>
                        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#numerator"/>
                        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Compound_unit"/>
        <rdfs:label xml:lang="en">unit division</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_exponentiation -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_exponentiation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#base"/>
                        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#exponent"/>
                        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Compound_unit"/>
        <rdfs:label xml:lang="en">unit exponentiation</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_multiple_or_submultiple -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_multiple_or_submultiple">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_of_measure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#definition"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Measure"/>
                            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Quantity"/>
                            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_of_measure"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">unit multiple or submultiple</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_multiplication -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_multiplication">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#term_1"/>
                        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#term_2"/>
                        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Compound_unit"/>
        <rdfs:label xml:lang="en">unit multiplication</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_of_measure -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_of_measure">
        <owl:equivalentClass rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Unit"/>
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Singular_unit"/>
            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_division"/>
            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_exponentiation"/>
            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_multiple_or_submultiple"/>
            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_multiplication"/>
        </owl:disjointUnionOf>
        <rdfs:comment xml:lang="en">A unit of measure is a definite magnitude of a quantity, defined and adopted by convention and/or by law. It is used as a standard for measurement of the same quantity, where any other value of the quantity can be expressed as a simple multiple of the unit of measure. For example, length is a quantity; the metre is a unit of length that represents a definite predetermined length. When we say 10 metre (or 10 m), we actually mean 10 times the definite predetermined length called &quot;metre&quot;.</rdfs:comment>
        <rdfs:label xml:lang="en">unit of measure</rdfs:label>
        <om-1:alternative_label xml:lang="en">unit</om-1:alternative_label>
        <om-1:alternative_label xml:lang="en">unit of measurement</om-1:alternative_label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Variable -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Variable">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#is_characteristic_of"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Observation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#has_Name"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The property that is being measured in the population.  Since Protege is not Full DL, cannot make the property a subclass of Variable, so have to specify it as a string name using has_Name.</rdfs:comment>
        <rdfs:label xml:lang="en">Variable</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#Vectorial_or_tensorial_character -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Vectorial_or_tensorial_character">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#ISO21972Thing"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/Change/ChangeOntologyThing -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/Change/ChangeOntologyThing">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#TransportationSystemThing"/>
        <rdfs:comment>Added for organizational purposes to group the classes defined in the Change Ontology.</rdfs:comment>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/Change/Manifestation -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/Change/Manifestation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/manifestationOf"/>
                        <owl:someValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/TimeVaryingConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/manifestationOf"/>
                        <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/TimeVaryingConcept"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/ChangeOntologyThing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/manifestationOf"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/TimeVaryingConcept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/existsAt"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/icity/Change/TimeVaryingConcept"/>
                    <rdf:Description rdf:about="http://www.w3.org/2006/time#TemporalEntity"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:disjointWith>
        <terms:description>A Manifestation of some TimeVaryingConcept at a particular point/interval in time.
A Manifestation exists at some Instant.
The class of Manifestations is equivalent to the class of things that are manifestations of some TimeVaryingConcept - and only time varying concents - in the manifestationOf relation.</terms:description>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/Change/TimeVaryingConcept -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/Change/TimeVaryingConcept">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/hasManifestation"/>
                        <owl:someValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/Manifestation"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/hasManifestation"/>
                        <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/Manifestation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/ChangeOntologyThing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/existsAt"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2006/time#Interval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/hasManifestation"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/Manifestation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/icity/Change/Manifestation"/>
                    <rdf:Description rdf:about="http://www.w3.org/2006/time#TemporalEntity"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:disjointWith>
        <terms:description>A class that is subject to change is defined as a type of TimeVaryingConcept (e.g. Vehicle may be a subclass of TimeVaryingConcept). The TimeVaryingConcept itself is invariant and defined by properties that do not change over time. As per (Krieger, 2008), we view TimeVaryingConcepts as perdurants (things that occur over time, i.e. processes).
A TimeVaryingConcept has Manifestations that demonstrate their changing (variant) properties over time.
Different types (subclasses) of TimeVaryingConcept may be defined based on the Manifestations that are part of them. For example, VehiclePD s have manifestations that are Vehicles.
A TimeVaryingConcept exists at some Interval.
The class of TimeVaryingConcepts is equivalent to the class of things that have some Manifestations - and only Manifestations - in the hasManifestation relation.</terms:description>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/Acceleration -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/Acceleration">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Quantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasValue"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasUnit"/>
                        <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/AccelerationUnit"/>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>acceleration</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/AccelerationUnit -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/AccelerationUnit">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Unit"/>
        <rdfs:label>acceleration unit</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/AmountOfMoney -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/AmountOfMoney">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Quantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasValue"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasUnit"/>
                        <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/AmountOfMoneyUnit"/>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>amount of money</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/AmountOfMoneyUnit -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/AmountOfMoneyUnit">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Unit"/>
        <rdfs:label>amount of money unit</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/Area -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/Area">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Quantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasValue"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasUnit"/>
                        <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/AreaUnit"/>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Area expresses the two-dimensional size of a defined part of a surface, typically a region bounded by a closed curve. It is a derived quantity in the International System of Units. Area is length squared.</rdfs:comment>
        <rdfs:label>area</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/AreaUnit -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/AreaUnit">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Unit"/>
        <rdfs:label>area unit</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/Capacity -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/Capacity">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/OMThing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#defined_by"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/CapacityRate -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/CapacityRate">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Quantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasValue"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasUnit"/>
                        <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/CardinalityUnitPerTime"/>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/govstat.owl#cardinality_of"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Capacity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/CapacitySize -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/CapacitySize">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Quantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasValue"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/CardinalityMeasure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/govstat.owl#cardinality_of"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Capacity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/CardinalityMeasure -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/CardinalityMeasure">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Measure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasUnit"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Cardinality_unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/CardinalityUnitPerTime -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/CardinalityUnitPerTime">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/UnitDivision"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasDenominator"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/TimeUnit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasNumerator"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Cardinality_unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/Duration -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/Duration">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Time"/>
        <rdfs:label>duration</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/Function -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/Function">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/OMThing"/>
        <rdfs:label>function</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/Geo_Position_unit -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/Geo_Position_unit">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Unit"/>
        <rdfs:comment>Reference systems to indicate geographic position.</rdfs:comment>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/Length -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/Length">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Quantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasValue"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/icity/OM/Measure"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasUnit"/>
                                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/LengthUnit"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Length is the amount of space between two geographical points along a curve. It is a base quantity in the International System of Units and other systems of units. Length is speed times time. The metre, a base unit of length in the International System of Units, is defined in terms of speed of light during a certain time interval.</rdfs:comment>
        <rdfs:label>length</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/LengthUnit -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/LengthUnit">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Unit"/>
        <rdfs:label>length unit</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/Mass -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/Mass">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Quantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasValue"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasUnit"/>
                        <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/MassUnit"/>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Mass is the amount of matter of a phenomenon. It is a base quantity in the International System of Units. Mass is force divided by acceleration.</rdfs:comment>
        <rdfs:label>mass</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/MassUnit -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/MassUnit">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Unit"/>
        <rdfs:label>mass unit</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/Measure -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/Measure">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/OMThing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasUnit"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>measure</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/MonetaryValue -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/MonetaryValue">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Measure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasUnit"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/AmountOfMoneyUnit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasRelativeYear"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A Monetary Value has a numerical value that is relative to a particular date (year).
A Monetary Value is measured with some currency.</rdfs:comment>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/OMThing -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/OMThing">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#TransportationSystemThing"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/Quantity -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/Quantity">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/OMThing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasValue"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Measure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>quantity</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/Ratio -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/Ratio">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Quantity"/>
        <rdfs:label>ratio</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/Scale -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/Scale">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/OMThing"/>
        <rdfs:label>scale</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/Speed -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/Speed">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Quantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasValue"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasUnit"/>
                        <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/SpeedUnit"/>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Speed is the time rate of motion measured by the distance moved over in unit time.</rdfs:comment>
        <rdfs:label>speed</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/SpeedUnit -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/SpeedUnit">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Unit"/>
        <rdfs:label>speed unit</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/System_of_units -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/System_of_units">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/OMThing"/>
        <rdfs:comment>In order to achieve a coherent, interdependent set of units of measure in the wide variety of units that exist, units are organised in systems of units. A system of units is based on a set of units chosen by convention to be the system’s base units, units that are considered to be mutually independent (i.e., can’t be expressed in terms of each other).</rdfs:comment>
        <rdfs:label>system of units</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/Time -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/Time">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Quantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasValue"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasUnit"/>
                        <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/TimeUnit"/>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>time</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/TimeUnit -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/TimeUnit">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Unit"/>
        <rdfs:label>time unit</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/Unit -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/Unit">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/OMThing"/>
        <rdfs:label>unit</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/UnitDivision -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/UnitDivision">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Unit"/>
        <rdfs:label>unit division</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/ValueOfMoney -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/ValueOfMoney">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/AmountOfMoney"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasValue"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/MonetaryValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An amount of money that is defined relative to a particular year.</rdfs:comment>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/Volume -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/Volume">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Quantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasValue"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/hasUnit"/>
                        <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/VolumeUnit"/>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Volume is a measure of how much three-dimensional space any phenomenon occupies. It is a derived quantity in the International System of Units. Volume is length to the power 3.</rdfs:comment>
        <rdfs:label>volume</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/OM/VolumeUnit -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/OM/VolumeUnit">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Unit"/>
        <rdfs:label>volume unit</rdfs:label>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/SSN/SSNThing -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/SSN/SSNThing">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#TransportationSystemThing"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/SpatialLoc/SpatialLocOntologyThing -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/SpatialLoc/SpatialLocOntologyThing">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#TransportationSystemThing"/>
        <rdfs:comment>Created for organizational purposes, to identify the classes imported from geoSPARQL.</rdfs:comment>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/Time/CalendarPeriod -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/Time/CalendarPeriod">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#TransportationSystemThing"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/Time/TimeOntologyThing -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/Time/TimeOntologyThing">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#TransportationSystemThing"/>
        <dc:description>Class added for organizational purposes, to identify classes defined in the Time Ontology.</dc:description>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/Time/TimePeriod -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/Time/TimePeriod">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#TransportationSystemThing"/>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/TransportationSystem/AccessRestriction -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/TransportationSystem/AccessRestriction">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyThing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/TransportationSystem/applicableDuring"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/icity/Time/CalendarPeriod"/>
                            <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/icity/Time/TimePeriod"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Future extensions should capture this semantics in greater detail.
AccessRestriction may apply to certain Vehicle types (bus, cab, eco-friendly), Vehicle properties (number of passengers), or attributes of the traveler themselves (e.g. no bicycles on transit between certain times).</rdfs:comment>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/TransportationSystem/Arc -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/TransportationSystem/Arc">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/manifestationOf"/>
                        <owl:someValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/TransportationSystem/ArcPD"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/manifestationOf"/>
