    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brcomp#seaWaterContact">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Component"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Defines whether a Component has contact with sea water</rdfs:comment>
        <rdfs:label xml:lang="en">sea water contact</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brcomp#tendonDirection -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brcomp#tendonDirection">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Tendon"/>
        <rdfs:comment xml:lang="en">Defines the tendon direction.</rdfs:comment>
        <rdfs:comment xml:lang="de">Gibt die Vorspannungsrichtung an.</rdfs:comment>
        <rdfs:label xml:lang="de">Vorspannungsrichtung</rdfs:label>
        <rdfs:label xml:lang="en">tendon direction</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brcomp#tendonInternal -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brcomp#tendonInternal">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Tendon"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Defines whether a tendon is external or internal. True if the tendon is internal. False if the tendon is external.</rdfs:comment>
        <rdfs:comment xml:lang="de">Gibt an, ob Vorspannung extern oder intern verbaut ist. True bei interner Vorspannung und false bei externer Vorspannung.</rdfs:comment>
        <rdfs:label xml:lang="de">Interne Vorspannung</rdfs:label>
        <rdfs:label xml:lang="en">internal tendon</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brcomp#type -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brcomp#type">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Component"/>
        <rdfs:comment xml:lang="de">Gibt die Bezeichnung des Bauteiltyps an</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the name of the component type.</rdfs:comment>
        <rdfs:label xml:lang="de">Typenbezeichnung</rdfs:label>
        <rdfs:label xml:lang="en">type specification</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/brcomp#width -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/brcomp#width">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Component"/>
        <rdfs:comment xml:lang="de">Gibt die Breite eines Brückenbauteils an.

Einheit in [m].</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the width of a bridge member.

Unit in [m].</rdfs:comment>
        <rdfs:label xml:lang="de">Breite</rdfs:label>
        <rdfs:label xml:lang="en">width</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/bridge#angle -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#angle">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="en">Angle of construction related to site.
Unit in  [°].</rdfs:comment>
        <rdfs:label xml:lang="de">Bauwerkswinkel</rdfs:label>
        <rdfs:label xml:lang="en">construction angle</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/bridge#bridgeArea -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#bridgeArea">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="de">Gibt die Gesamtfläche der Überbauelemente der Brücke an. Einheit in [m²].</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the total area of the superstructure components of the bridge. 
Unit in [m²].</rdfs:comment>
        <rdfs:label xml:lang="de">Brückenfläche</rdfs:label>
        <rdfs:label xml:lang="en">bridge area</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/bridge#bridgeWidth -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#bridgeWidth">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="de">Gibt die Breite der Brücke an (ohne Ausbau). Einheit in [m].</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the width of the bridge (without extension). 
Unit in [m].</rdfs:comment>
        <rdfs:label xml:lang="de">Breite</rdfs:label>
        <rdfs:label xml:lang="en">bridge width</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/bridge#clearHeight -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#clearHeight">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="en">defines the height which needs to fulfil the following criteria:

- free space between the roadway and the lower edge of the superstructure of a bridge or between its piers or columns;

- vertical space in the cross-section of the road to be kept clear of obstacles

Unit in [m].</rdfs:comment>
        <rdfs:label xml:lang="de">Lichte Höhe</rdfs:label>
        <rdfs:label xml:lang="en">clear height</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/bridge#clearWidthSingleSpan -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#clearWidthSingleSpan">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="en">defines the width of a single span which needs to fulfil the following criteria:

- free space between the roadway and the lower edge of the superstructure of a bridge or between its piers or columns;

- vertical space in the cross-section of the road to be kept clear of obstacles

Unit in [m].</rdfs:comment>
        <rdfs:label xml:lang="de">Lichte Weite bei Einfeld</rdfs:label>
        <rdfs:label xml:lang="en">clear width of single span</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/bridge#completedDataAcquisition -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#completedDataAcquisition">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="de">Gibt an, ob die Datenerfassung abgeschlossen worden ist.

true = Datenerf. abgeschlossen
false = Datenerf. nicht abgeschlossen / unvollständig</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates whether data acquisition has been completed.

true = data acquisition completed
false = data acquisition not completed / incomplete</rdfs:comment>
        <rdfs:label xml:lang="de">Datenerf. abgeschl.</rdfs:label>
        <rdfs:label xml:lang="en">completed data acquisition</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/bridge#constructionYear -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#constructionYear">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
        <rdfs:comment xml:lang="en">Year in which the bridge has been constructed.</rdfs:comment>
        <rdfs:label xml:lang="de">Baujahr</rdfs:label>
        <rdfs:label xml:lang="en">construction year</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/bridge#curvature -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#curvature">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="de">Gibt die Krümmung der Brückenplatte an. Krümmung kann entweder mit R in [m] angegeben werden oder als &quot;false&quot; bzw. nicht gekrümmt.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the curvature of the bridge plate. Curvature can either be specified with radius in [m] or as &quot;false&quot; or not curved.</rdfs:comment>
        <rdfs:label xml:lang="de">Krümmung</rdfs:label>
        <rdfs:label xml:lang="en">curvature</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/bridge#fileID -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#fileID">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="en">Referes to the file ID of the corresponding construction file.</rdfs:comment>
        <rdfs:label xml:lang="de">Bauwerksakte-Nr.</rdfs:label>
        <rdfs:label xml:lang="en">file ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://wisib.de/ontologie/bridge#historicPreservation -->

    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#historicPreservation">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="de">Gibt an, ob das Bauwerk unter Denkmalschutz steht.

true = Bauwerk unter Denkmalschutz
false = kein Denkmalschutz</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates whether the building is under monument protection.

true = building under monument protection
false = no monument protection</rdfs:comment>
        <rdfs:label xml:lang="de">Denkmalschutz</rdfs:label>
        <rdfs:label xml:lang="en">historic preservation</rdfs:label>
    </owl:DatatypeProperty>
    


