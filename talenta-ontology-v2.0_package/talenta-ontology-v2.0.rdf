    </owl:ObjectProperty>
    


    <!-- http://ontology.eil.utoronto.ca/icity/Change/existsAt -->

    <owl:ObjectProperty rdf:about="http://ontology.eil.utoronto.ca/icity/Change/existsAt">
        <rdfs:subPropertyOf rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/ChangeOntologyProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <dc:description>Objects (e.g. perdurants and their manifestations) exist at some time interval or time point.</dc:description>
    </owl:ObjectProperty>
    


