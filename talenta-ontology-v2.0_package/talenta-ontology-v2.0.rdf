    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#maxCoveredHeight">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="en">Specifies the maximum covered height. 

Unit in [m].</rdfs:comment>
        <rdfs:label xml:lang="de">Max. Überschüttungshöhe</rdfs:label>
        <rdfs:label xml:lang="en">maximum covered height</rdfs:label>
    </owl:DatatypeProperty>
    


