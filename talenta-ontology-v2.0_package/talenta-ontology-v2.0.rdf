                        <owl:someValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/TransportationSystem/NetworkPD"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/icity/Change/manifestationOf"/>
                        <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/icity/TransportationSystem/NetworkPD"/>
                    </owl:Restriction>
