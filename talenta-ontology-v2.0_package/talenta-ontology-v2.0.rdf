        <rdfs:comment xml:lang="es">Reglas de servicio que definen un conjunto de fechas</rdfs:comment>
        <rdfs:comment xml:lang="en">Service rules which define together a set of dates</rdfs:comment>
        <rdfs:label xml:lang="en">Service rule</rdfs:label>
        <rdfs:label xml:lang="es">regla de servicio</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
