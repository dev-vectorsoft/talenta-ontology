    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bmat#Aluminium -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bmat#Aluminium">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/bmat#BuildingMaterial"/>
        <rdfs:comment xml:lang="en">Building material that mainly consists of the chemical element Aluminium (AL, 13)</rdfs:comment>
        <rdfs:label xml:lang="en">Aluminium</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bmat#BuildingMaterial -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bmat#BuildingMaterial">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#BridgeInfrastructure"/>
        <rdfs:comment xml:lang="en">Material of which construction components or building Components are made of.</rdfs:comment>
        <rdfs:label xml:lang="de">Baustoffklasse</rdfs:label>
        <rdfs:label xml:lang="en">Building material</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bmat#Concrete -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bmat#Concrete">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/bmat#BuildingMaterial"/>
        <rdfs:comment xml:lang="en">Building material which is mixed as a dispersion with the addition of liquid from a binder and aggregates. Concrete contains cement as binder and granules as aggregate. The admixture water initiates the chemical setting process, i.e. hardening.  In order to influence the workability and other properties of the concrete, concrete additives and concrete admixtures are added to the mixture.</rdfs:comment>
        <rdfs:label xml:lang="en">Concrete</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bmat#Mortar -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bmat#Mortar">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/bmat#BuildingMaterial"/>
        <rdfs:comment xml:lang="en">Material used to fill the gaps between blocks and bind them together.</rdfs:comment>
        <rdfs:label xml:lang="en">Mortar</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bmat#NaturalStone -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bmat#NaturalStone">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/bmat#BuildingMaterial"/>
        <rdfs:comment xml:lang="en">Building material made of stone, as found in nature, as long as it is regarded or acquired as an economic good.</rdfs:comment>
        <rdfs:label xml:lang="en">Natural stone</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bmat#ReinforcedConcrete -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bmat#ReinforcedConcrete">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/bmat#BuildingMaterial"/>
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/bmat#Concrete"/>
        <rdfs:comment xml:lang="en">Concrete which aggregates reinforcing Components (preferentially reinforcement steel) for enhanced tensile strength.</rdfs:comment>
        <rdfs:label xml:lang="en">Reinforced concrete</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bmat#ReinforecementSteel -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bmat#ReinforecementSteel">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/bmat#BuildingMaterial"/>
        <rdfs:comment xml:lang="en">Construction material that serves as reinforcement for reinforced concrete components. Is poured with concrete after installation in the formwork.</rdfs:comment>
        <rdfs:label xml:lang="en">Reinforcement steel</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#Abutment -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#Abutment">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="en">Structural component that creates the transition between the bridge structure and the earth dam.</rdfs:comment>
        <rdfs:label xml:lang="en">Abutment component</rdfs:label>
        <rdfs:label xml:lang="de">Widerlagerelement</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#AbutmentBenching -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#AbutmentBenching">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#AbutmentComponent"/>
        <rdfs:comment xml:lang="en">Part of a Abutment on which a Bearing is installed.</rdfs:comment>
        <rdfs:label xml:lang="de">Auflagerbank eines Widerlagers</rdfs:label>
        <rdfs:label xml:lang="en">Benching of an abutment</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#AbutmentChamberWall -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#AbutmentChamberWall">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#AbutmentComponent"/>
        <rdfs:comment xml:lang="en">Front wall of Abutment.</rdfs:comment>
        <rdfs:label xml:lang="en">Chamber wall of an abutment</rdfs:label>
        <rdfs:label xml:lang="de">Kammerwand eines Widerlagers</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#AbutmentComponent -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#AbutmentComponent">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="en">Component that is aggregated in a Abutment.</rdfs:comment>
        <rdfs:label xml:lang="en">Abutment component</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#AbutmentFooting -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#AbutmentFooting">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#AbutmentComponent"/>
        <rdfs:comment xml:lang="en">Abutment footing</rdfs:comment>
        <rdfs:comment xml:lang="en">Footing / foundation of Abutment.</rdfs:comment>
        <rdfs:label xml:lang="de">Fundamentplatte eines Widerlagers</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#AbutmentWingWall -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#AbutmentWingWall">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#AbutmentComponent"/>
        <rdfs:comment xml:lang="en">Side wall of Abutment.</rdfs:comment>
        <rdfs:label xml:lang="de">Fluegelwand eines Widerlagers</rdfs:label>
        <rdfs:label xml:lang="en">Wing wall of an abutment</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#Arch -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#Arch">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#SubStructureComponent"/>
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#SuperStructureComponent"/>
        <rdfs:comment xml:lang="en">No clearly visible separation between the superstructure and the substructure . The arch of the bridge loads the transom diagonally outwards. Both vertical and horizontal forces are transmitted into it.</rdfs:comment>
        <rdfs:label xml:lang="en">Arch</rdfs:label>
        <rdfs:label xml:lang="de">Brückenbogen</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#Asphalt -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#Asphalt">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Coating"/>
        <rdfs:comment xml:lang="en">Natural or technically produced mixture of the binder bitumen and aggregates used in road construction for road pavements.</rdfs:comment>
        <rdfs:label xml:lang="en">Asphalt</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#Bearing -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#Bearing">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="en">Have the task of transferring the forces generated by their own weight, traffic loads and braking and wind forces to the substructure and abutments. A Bearing must be designed in such a way that it allows movements and rotations due to traffic, temperature differences, earthquakes, prestressing, shrinkage and creep, etc.</rdfs:comment>
        <rdfs:label xml:lang="en"> bearing</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#BearingSeat -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#BearingSeat">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="en">Component placed on the Bearing and serves to transfer forces over a larger area.</rdfs:comment>
        <rdfs:label xml:lang="en">Bearing seat</rdfs:label>
        <rdfs:label xml:lang="de">Lagersockel</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#BirdsProtection -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#BirdsProtection">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#FinishingComponent"/>
        <rdfs:comment xml:lang="en">Components for protecting niches or interstices from birds.</rdfs:comment>
        <rdfs:label xml:lang="en">Birds protection</rdfs:label>
        <rdfs:label xml:lang="de">Vogelschutz</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#Cable -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#Cable">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#TensionComponent"/>
        <rdfs:comment xml:lang="en">Steel cable that is installed on a Pylon and takes tensile loads from the superstructure.</rdfs:comment>
        <rdfs:label xml:lang="de">Cable</rdfs:label>
        <rdfs:label xml:lang="de">Seil</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#CableAnchoringDevice -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#CableAnchoringDevice">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#SuperStructureComponent"/>
        <rdfs:comment xml:lang="en">Component for anchoring steel cables of a bridge to Pylon.</rdfs:comment>
        <rdfs:label xml:lang="en">Cable anchoring device</rdfs:label>
        <rdfs:label xml:lang="de">Seilverankerung</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#Cap -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#Cap">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#FinishingComponent"/>
        <rdfs:comment xml:lang="en">Non-traveled edge formation of reinforced concrete or prestressed concrete bridges, which can also be formed as kerbs.

 caps have to fulfil various functions. In addition to protecting the load-bearing bridge structure, they are used for anchoring passive protective devices and as bicycle and/or pedestrian paths. Due to their exposed position, they are exposed to particularly strong attacks, e.g. frost-thaw salt attacks. In addition, there are dynamic loads caused by traffic on the bridges. Even if the bridge caps undergo optical changes as a result of wear, load or weathering during the planned service life, concrete bridge caps are safe and durable if constructive and technical rules are observed.</rdfs:comment>
        <rdfs:label xml:lang="en">Cap</rdfs:label>
        <rdfs:label xml:lang="de">Kappe</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#ConcreteStayTensionComponent -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#ConcreteStayTensionComponent">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#TensionComponent"/>
        <rdfs:comment xml:lang="en">Concrete components subjected to tensile stress.</rdfs:comment>
        <rdfs:label xml:lang="en">Tension component as a concrete stay</rdfs:label>
        <rdfs:label xml:lang="de">Zugglieder aus Stahlbeton</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#ConstructionJoint -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#ConstructionJoint">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Joint"/>
        <rdfs:comment xml:lang="en">Separation lines within components. They occur, for example, in concrete construction as set-down joints between successive concreting sections. Concreting in several stages is often unavoidable due to the construction process. The aim is to create the best possible bond between the adjacent concreting sections. Since the reinforcement runs through the construction joints, a traditional shuttering of the concreting section with wood would be costly. Today, expanded metal is mostly used for this purpose, which can be easily cut and bent to size and guarantees a certain degree of interlocking of the concreting sections. If, for example, a straight line of joints is desired for aesthetic reasons, formwork panels can be used in combination with a reverse bending connection for the reinforcing irons, which allow subsequent interlocking by bending up the reinforcing bars as the concreting process continues. In engineering structures such as bridges, screw connections are used to connect the reinforcement steel over construction joints due to the higher loads.</rdfs:comment>
        <rdfs:label xml:lang="de">Arbeitsfuge</rdfs:label>
        <rdfs:label xml:lang="en">Construction joint</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#CouplingJoint -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#CouplingJoint">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Joint"/>
        <rdfs:comment xml:lang="en">Necessary in prestressed concrete construction if the component has to be constructed in several sections, e.g. in bridge construction. The individual components are coupled to each other at the coupling joints and the tendons are connected to each other, e.g. bolted, depending on the prestressing method</rdfs:comment>
        <rdfs:label xml:lang="en">Coupling joint</rdfs:label>
        <rdfs:label xml:lang="de">Koppelfuge</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#Drainage -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#Drainage">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#FinishingComponent"/>
        <rdfs:comment xml:lang="en">Technical systems that counteract waterlogging on the bridge construction.</rdfs:comment>
        <rdfs:label xml:lang="en">Drainage</rdfs:label>
        <rdfs:label xml:lang="de">Entwaesserung</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#DrilledPile -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#DrilledPile">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#Pile"/>
        <rdfs:comment xml:lang="en">Pile that is drilled to the underground by utilizing specifc drilling systems and machines.</rdfs:comment>
        <rdfs:label xml:lang="de">Bohrpfahl</rdfs:label>
        <rdfs:label xml:lang="en">Drilled pile</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#ElastomericBearings -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#ElastomericBearings">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#FixedBearingComponent"/>
        <rdfs:comment xml:lang="en">Bearings made of chloroprene rubber (CR) or natural rubber (NR).</rdfs:comment>
        <rdfs:label xml:lang="en">Elastomeric bearings</rdfs:label>
        <rdfs:label xml:lang="de">Verformungslager</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#ExpansionJoint -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#ExpansionJoint">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Joint"/>
        <rdfs:comment xml:lang="en">Joint for interrupting components in order to prevent stress cracking.</rdfs:comment>
        <rdfs:label xml:lang="de">Dehnungs-/Bewegungsfuge</rdfs:label>
        <rdfs:label xml:lang="en">Expansion/movement joint</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#FinishingComponent -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#FinishingComponent">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Component"/>
        <rdfs:comment xml:lang="en">Component that is installed during the finishing phase of the bridge construction after the shell construction phase (e.g. railing, bridge cap, etc.). Has no load-bearing capacity.</rdfs:comment>
        <rdfs:label xml:lang="en"> Finishing Component</rdfs:label>
        <rdfs:label xml:lang="de">Ausbauelement einer Bruecke</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#FixedBearingComponent -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#FixedBearingComponent">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#Bearing"/>
        <rdfs:comment xml:lang="en">Fixed bearing</rdfs:comment>
        <rdfs:comment xml:lang="en">Transmits vertical and horizontal forces from any direction.</rdfs:comment>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#Footing -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#Footing">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#FoundationComponent"/>
        <rdfs:comment xml:lang="en">Flat foundation which rests on the ground.</rdfs:comment>
        <rdfs:label xml:lang="en">Footing</rdfs:label>
        <rdfs:label xml:lang="de">Gruendung</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#Foundation -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#Foundation">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="en">Component for the foundation of abutments and central supports and the transfer of bridge loads.</rdfs:comment>
        <rdfs:label xml:lang="en">Foundation</rdfs:label>
        <rdfs:label xml:lang="de">Gruendungselement einer Bruecke</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#FoundationComponent -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#FoundationComponent">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="en">Component that is aggregated to the Foundation.</rdfs:comment>
        <rdfs:label xml:lang="en">Foundation component</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#Girder -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#Girder">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#SuperStructureComponent"/>
        <rdfs:comment xml:lang="en">Support beam used in construction. It is the main horizontal support of a structure which supports smaller beams. Girders often have an I-beam cross section composed of two load-bearing flanges separated by a stabilizing web, but may also have a box shape, Z shape, or other forms. A girder is commonly used to build bridges.</rdfs:comment>
        <rdfs:label xml:lang="en">Girder</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#GirderBracing -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#GirderBracing">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#GirderComponent"/>
        <rdfs:comment xml:lang="en">Bracing component aggregated in a Girder.</rdfs:comment>
        <rdfs:label xml:lang="de">Aussteifung (stabfoermiges Component)</rdfs:label>
        <rdfs:label xml:lang="en">Bracing (bar-shaped component)</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#GirderComponent -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#GirderComponent">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#SuperStructureComponent"/>
        <rdfs:comment xml:lang="en">Component that is aggregated in a Girder.</rdfs:comment>
        <rdfs:label xml:lang="en"> girder</rdfs:label>
        <rdfs:label xml:lang="de">Brueckendeck (gesamter Querschnitt des Fahrbahntragwerks)</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#GirderCrossGirder -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#GirderCrossGirder">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#GirderComponent"/>
        <rdfs:comment xml:lang="de">Querbalken des Brueckendeckquerschnitts</rdfs:comment>
        <rdfs:comment xml:lang="en">cross girder of the bridge beam cross-section</rdfs:comment>
        <rdfs:label xml:lang="en">Cross girder</rdfs:label>
        <rdfs:label xml:lang="de">Querbalken</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#GirderDeck -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#GirderDeck">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#GirderComponent"/>
        <rdfs:comment xml:lang="de">Obere Platte des Brueckendeckquerschnitts</rdfs:comment>
        <rdfs:comment xml:lang="en">Upper plate of the bridge beam cross-section.</rdfs:comment>
        <rdfs:label xml:lang="de">Brückenplatte</rdfs:label>
        <rdfs:label xml:lang="en">Deck</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#GirderDiaphragm -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#GirderDiaphragm">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#GirderComponent"/>
        <rdfs:comment xml:lang="en">Plate-shaped component used for bracing the Girder.</rdfs:comment>
        <rdfs:label xml:lang="en">Stiffening diaphgragm</rdfs:label>
        <rdfs:label xml:lang="de">Versteifungsdiaphragma</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#GirderDownPlate -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#GirderDownPlate">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#GirderComponent"/>
        <rdfs:comment xml:lang="en">Lower plate of the bridge beam cross-section</rdfs:comment>
        <rdfs:comment xml:lang="de">Untere Platte des Brueckendeckquerschnitts</rdfs:comment>
        <rdfs:label xml:lang="en">Girder down plate</rdfs:label>
        <rdfs:label xml:lang="en">Unterplatte</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#GirderMainGirder -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#GirderMainGirder">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#GirderComponent"/>
        <rdfs:comment xml:lang="de">Balken in der Längsrichtung des Brückendeckquerschnitts</rdfs:comment>
        <rdfs:comment xml:lang="en">Girder component in longitudinal direction of the bridge beam cross-section</rdfs:comment>
        <rdfs:label xml:lang="de">Längsbalken</rdfs:label>
        <rdfs:label>Main girder</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#GirderSegment -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#GirderSegment">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#Girder"/>
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#GirderComponent"/>
        <rdfs:comment>&quot;Brueckendeckssegment&quot; ist ein Segment von einem Brueckendeck, das ein Fertigteilkomponent bzw. ein Segment eines Betonierabschnitts abbildet.</rdfs:comment>
        <rdfs:comment xml:lang="en">&quot;Girder segment&quot; is a segment of a bridge deck, which can represent either a prefabrecated component or a section of the construction stage.</rdfs:comment>
        <rdfs:label xml:lang="de">Brueckendecksegment</rdfs:label>
        <rdfs:label xml:lang="en">Girder segment</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#GroundAnchoringDevice -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#GroundAnchoringDevice">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="en">Component that anchors the Foundation to the ground below.</rdfs:comment>
        <rdfs:label xml:lang="de">Erdverankerung</rdfs:label>
        <rdfs:label xml:lang="en">Ground anchoring device</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#Illumination -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#Illumination">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#FinishingComponent"/>
        <rdfs:comment xml:lang="en">Technical system for illuminating the bridge mainly for traffic but also could be also installed for decorative effects.</rdfs:comment>
        <rdfs:label xml:lang="de">Beleuchtung</rdfs:label>
        <rdfs:label xml:lang="en">Illumination</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#MasticAsphalt -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#MasticAsphalt">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#Asphalt"/>
        <rdfs:comment xml:lang="en">Mixture of fine and coarse aggregates and bitumen that can be poured and spread during installation. Therefore, no compaction work is necessary when using mastic asphalt. Mastic asphalt is used as road surface, as floor covering and for waterproofing.</rdfs:comment>
        <rdfs:label xml:lang="de">Gussasphalt</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#MovableBearingComponent -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#MovableBearingComponent">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#Bearing"/>
        <rdfs:label xml:lang="en">Bearing that transmits vertical forces and allows movements in at least one direction.</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#NoiseBarrier -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#NoiseBarrier">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#FinishingComponent"/>
        <rdfs:comment xml:lang="en">Components and technical systems for noise abatement and part of immission control. It is intended to ensure the well-being of humans and animals with regard to noise.</rdfs:comment>
        <rdfs:label xml:lang="de">Laermschutz</rdfs:label>
        <rdfs:label xml:lang="en">Noise barrier</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#Pavement -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#Pavement">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#FinishingComponent"/>
        <rdfs:comment xml:lang="en">Part of a road intended for pedestrian traffic.</rdfs:comment>
        <rdfs:label xml:lang="de">Gehweg</rdfs:label>
        <rdfs:label xml:lang="en">Pavement</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#Pier -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#Pier">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#SubStructureComponent"/>
        <rdfs:comment xml:lang="en">Components that support the ends of spans between these abutments.</rdfs:comment>
        <rdfs:label xml:lang="de">Pfeiler</rdfs:label>
        <rdfs:label xml:lang="en">Pier</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#Pile -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#Pile">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#FoundationComponent"/>
        <rdfs:comment xml:lang="en">Rod-shaped component that reaches a certain depth into the soil and is connected to the Foundation.</rdfs:comment>
        <rdfs:label xml:lang="de">Pfahl</rdfs:label>
        <rdfs:label xml:lang="en">Pile</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#PinBearing -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#PinBearing">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#FixedBearingComponent"/>
        <rdfs:comment xml:lang="en">Fixed bearings that allow tilting about any axis.</rdfs:comment>
        <rdfs:label xml:lang="de">Punktkipplager</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#PotBearings -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#PotBearings">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#FixedBearingComponent"/>
        <rdfs:comment xml:lang="en">Bearing that works on the following principle: A disc made of high-quality natural rubber (elastomer) is enclosed on all sides in a steel pot. Under high pressure, the elastomer behaves like a liquid and, thanks to its deformability, can be tilted about any horizontal axis.</rdfs:comment>
        <rdfs:label xml:lang="en">Pot bearings</rdfs:label>
        <rdfs:label xml:lang="de">Topflager</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#PrefabricatedComponent -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#PrefabricatedComponent">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Component"/>
        <rdfs:comment xml:lang="en">Finished parts made of raw materials or semi-finished products that can be used for construction without further processing.</rdfs:comment>
        <rdfs:label xml:lang="de">Fertigteil</rdfs:label>
        <rdfs:label xml:lang="en">Prefabricated component</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#Pylon -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#Pylon">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#SubStructureComponent"/>
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#SuperStructureComponent"/>
        <rdfs:comment xml:lang="en">In bridge construction, the high towering component over which the suspension cables of suspension bridges run or to which the stay cables of cable-stayed bridges are anchored.</rdfs:comment>
        <rdfs:label xml:lang="de">Pylon</rdfs:label>
        <rdfs:label xml:lang="en">Tower/pylon</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#Railing -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#Railing">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#FinishingComponent"/>
        <rdfs:comment xml:lang="en">Component for the fall protection of persons, which is often installed at the edge of the pavement.</rdfs:comment>
        <rdfs:label xml:lang="de">Geländer</rdfs:label>
        <rdfs:label xml:lang="en">Railing</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#ReinforcingBar -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#ReinforcingBar">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#ReinforcingComponent"/>
        <rdfs:comment xml:lang="en">Serves as reinforcement of reinforced concrete components and is cast with concrete after installation in the formwork.</rdfs:comment>
        <rdfs:label xml:lang="de">Bewehrungsstab</rdfs:label>
        <rdfs:label xml:lang="en">Reinforcing bar</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#ReinforcingComponent -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#ReinforcingComponent">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Component"/>
        <rdfs:comment xml:lang="en">Composite component that is aggregated in concrete components to increase their load-bearing capacity.</rdfs:comment>
        <rdfs:label xml:lang="de">Bewehrungselement einer Bruecke</rdfs:label>
        <rdfs:label xml:lang="en">Reinforcing Component</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#ReinforcingMesh -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#ReinforcingMesh">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#ReinforcingComponent"/>
        <rdfs:comment xml:lang="en">Wire mesh made of welded bars of reinforcing steel, which are used for the reinforcement of flat reinforced concrete components.</rdfs:comment>
        <rdfs:label xml:lang="de">Bewehrungsmatte</rdfs:label>
        <rdfs:label xml:lang="en">Reinforcing mesh</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#RockerBearing -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#RockerBearing">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#FixedBearingComponent"/>
        <rdfs:comment xml:lang="en">Fixed bearing that only allows tilting movements around the bearing axis (one-sided tilting). They are only suitable if no significant tilting movements are to be expected across the bridge axis; i.e. for straight or slightly curved bridges with small bearing spacings as well as rigid cross members and rigid piers.</rdfs:comment>
        <rdfs:label xml:lang="de">Linienkipplager</rdfs:label>
        <rdfs:label xml:lang="en">Rocker bearing</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#RollerBearing -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#RollerBearing">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#MovableBearingComponent"/>
        <rdfs:comment xml:lang="en">One-sided movable Bearings which allow one-sided tilting. They have a limited use like the line tilting bearings. One or more cylindrical rollers are located between the plane-parallel surfaces of the upper and lower bearing plates. In the standard version with one roller, tilting around the roller axis is possible. It is possible to transmit horizontal forces perpendicular to the direction of movement. Since the direction of movement must be perpendicular to the tilting direction, they are not suitable for inclined bridges.</rdfs:comment>
        <rdfs:label xml:lang="de">Rollenlager</rdfs:label>
        <rdfs:label xml:lang="en">Roller bearing</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#SafetyKerb -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#SafetyKerb">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#FinishingComponent"/>
        <rdfs:comment xml:lang="en">Protective device made of wood, concrete, asphalt or steel for securing road users or workplaces on or near roads.</rdfs:comment>
        <rdfs:label xml:lang="en">Safety kerb</rdfs:label>
        <rdfs:label xml:lang="de">Schrammbord</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#SlidingBearing -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#SlidingBearing">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#MovableBearingComponent"/>
        <rdfs:comment xml:lang="en">In the case of sliding bearings movable on one side, 2 guide pads with austenitic sheet steel are attached to the sliding plate. They transmit the horizontal forces via embedded PTFE to the upper bearing plate.</rdfs:comment>
        <rdfs:label xml:lang="de">Gleitlager</rdfs:label>
        <rdfs:label xml:lang="en">Sliding bearings</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#SphericalBearings -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#SphericalBearings">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#FixedBearingComponent"/>
        <rdfs:comment xml:lang="en">Bearing thatenables the displacement and sliding movement in a flat and a curved sliding surface between the steel bearing plates. Spherical bearings generally act as biaxially displaceable pin bearings.</rdfs:comment>
        <rdfs:label xml:lang="de">Kalottenlager</rdfs:label>
        <rdfs:label xml:lang="en">Spherical bearings</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#SubStructureComponent -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#SubStructureComponent">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Component"/>
        <rdfs:comment xml:lang="en">Component that is contained in the BridgeSubStructure zone.</rdfs:comment>
        <rdfs:label xml:lang="en">Substructure Element</rdfs:label>
        <rdfs:label xml:lang="de">Unterbauelement einer Bruecke</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#SuperStructureComponent -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#SuperStructureComponent">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Component"/>
        <rdfs:comment xml:lang="en">Component that is contained in the BridgeSuperStructure zone.</rdfs:comment>
        <rdfs:label xml:lang="en">Bridge superstructure element</rdfs:label>
        <rdfs:label xml:lang="de">Ueberbauelement</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#Tendon -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#Tendon">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#ReinforcingComponent"/>
        <rdfs:comment xml:lang="en">Component made of high-strength steel, which is mainly used for prestressing in prestressed concrete construction.</rdfs:comment>
        <rdfs:label xml:lang="de">Spannglied</rdfs:label>
        <rdfs:label xml:lang="en">Tendon</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#TendonAnchoringDevice -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#TendonAnchoringDevice">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#ReinforcingComponent"/>
        <rdfs:comment xml:lang="en">The task of the TendonAnchoringDevice is to transfer the forces of the tendon to the concrete. This is usually done with anchor plates to which the prestressing steel transmits the forces through wedge anchoring, upset heads or nuts.</rdfs:comment>
        <rdfs:label xml:lang="de">Spanngliedverankerung</rdfs:label>
        <rdfs:label xml:lang="en">Tendon anchoring device</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#TensionComponent -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#TensionComponent">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#SuperStructureComponent"/>
        <rdfs:comment xml:lang="en">Tension component of superstructure</rdfs:comment>
        <rdfs:comment xml:lang="de">Zugglied des Ueberbaus</rdfs:comment>
        <rdfs:label xml:lang="en">Tension component</rdfs:label>
        <rdfs:label xml:lang="de">Zugglied</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/brcomp#TrafficBarrier -->

    <owl:Class rdf:about="https://wisib.de/ontologie/brcomp#TrafficBarrier">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brcomp#FinishingComponent"/>
        <rdfs:comment xml:lang="en">Road components to clarify traffic guidance for road users.</rdfs:comment>
        <rdfs:label xml:lang="de">Leiteinrichtung</rdfs:label>
        <rdfs:label xml:lang="en">Traffic barrier</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bridge#BeamBridge -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bridge#BeamBridge">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="en">The external characteristic of the beam bridge is usually the visible separation of the superstructure (bridge girder) from the substructure (supports, abutments) by bearings. The bearings transfer the loads from the superstructure to the substructures and give the bridge girder the necessary positional stability and movement capability. The cross-sectional shape in the longitudinal direction corresponds externally to a beam, usually the girder height is constant. Superstructures with variable superstructure heights are possible. As a rule, the bottom chord has a curvature corresponding to the moment load, it is vouched. The beam makes optimum use of the strength of the material and is used as a static system for conventional bridges with small to medium spans (approx. 80 m). Economical spans for beam bridges are up to 100 m, approx. 100-200 m for Extradosed bridges and from 200 m for cable-stayed bridges. The beam bridge is frequently used because of its comparatively simple construction. Many bridges over motorways are designed in this way. Beam bridges can be constructed in transverse direction with different cross-section geometries.</rdfs:comment>
        <rdfs:label xml:lang="de">Balkenbrücke</rdfs:label>
        <rdfs:label xml:lang="en">Beam bridge</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bridge#BoxGirderBridge -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bridge#BoxGirderBridge">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/bridge#GirderBridge"/>
        <rdfs:comment xml:lang="en">Bridge in which the main beams comprise girders in the shape of a hollow box. The box girder normally comprises either prestressed concrete, structural steel, or a composite of steel and reinforced concrete. The box is typically rectangular or trapezoidal in cross-section.</rdfs:comment>
        <rdfs:label xml:lang="en">Box girder bridge</rdfs:label>
        <rdfs:label xml:lang="de">Hohlkastenbrücke</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bridge#CompositeBridge -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bridge#CompositeBridge">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="en">Composite steel bridges are structures consisting of steel main girders and a concrete deck slab above them.</rdfs:comment>
        <rdfs:label xml:lang="en">Composite bridge</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bridge#Department -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bridge#Department">
        <rdfs:subClassOf rdf:resource="http://dbpedia.org/ontology/Organisation"/>
        <rdfs:comment xml:lang="en">Responsible department that administrates the bridge and its maintenance.</rdfs:comment>
        <rdfs:label xml:lang="en">Department</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bridge#GirderBridge -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bridge#GirderBridge">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="en">Bridge that uses girders as the means of supporting its deck.</rdfs:comment>
        <rdfs:label xml:lang="en">Girder bridge</rdfs:label>
        <rdfs:label xml:lang="de">Plattenbalken- / Trägerrost- Brücke</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bridge#PedestrianBridge -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bridge#PedestrianBridge">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="en">Bridge designed solely for pedestrians</rdfs:comment>
        <rdfs:label xml:lang="en">Pedestrian Bridge</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bridge#PrestressedConcreteBridge -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bridge#PrestressedConcreteBridge">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://wisib.de/ontologie/brot#containsComponent"/>
                <owl:someValuesFrom rdf:resource="https://wisib.de/ontologie/brcomp#Tendon"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="en">Bridge that uses prestressed concrete as building material.</rdfs:comment>
        <rdfs:label xml:lang="en">Prestressed concrete bridge</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bridge#RailwayBridge -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bridge#RailwayBridge">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="en">Bridge specially designed to guide a railway line and the railways running on it over obstacles.</rdfs:comment>
        <rdfs:label xml:lang="en">Railway bridge</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bridge#ReinforcedConcreteBridge -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bridge#ReinforcedConcreteBridge">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="en">Bridge that uses reinforced concrete as building material.</rdfs:comment>
        <rdfs:label xml:lang="en">Reinforced concrete bridge</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bridge#RoadBridge -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bridge#RoadBridge">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="en">Bridge that can be used by motor vehicles and motor vehicles and usually also by pedestrians, bicycles and other vehicles.</rdfs:comment>
        <rdfs:label xml:lang="en">Road bridge</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bridge#SlabBridge -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bridge#SlabBridge">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="en">Short-span bridge consisting of a reinforced-concrete slab resting on abutments</rdfs:comment>
        <rdfs:label xml:lang="en">Slab bridge</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bridge#Steelbridge -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bridge#Steelbridge">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="en">Bridge that uses mainly steel as building material.</rdfs:comment>
        <rdfs:label xml:lang="en">Steel bridge</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bridge#StoneBridge -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bridge#StoneBridge">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="en">Bridge that uses mainly (natural) stone as building material.</rdfs:comment>
        <rdfs:label xml:lang="en">Stone bridge</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bridge#TransportBridge -->

    <owl:Class rdf:about="https://wisib.de/ontologie/bridge#TransportBridge">
        <rdfs:subClassOf rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="en">Movable bridge that carries a segment of roadway across a river.</rdfs:comment>
        <rdfs:label xml:lang="en">Transport bridge</rdfs:label>
    </owl:Class>
    


    <!-- https://wisib.de/ontologie/bridge#WoodBridge -->

