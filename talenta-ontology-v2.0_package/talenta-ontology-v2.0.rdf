        <rdfs:range rdf:resource="http://vocab.gtfs.org/terms#PickupType"/>
        <rdfs:comment xml:lang="es">Indica si se recogen los pasajeros en una parada como parte del horario normal o si su recogida en dicha parada no se encuentra disponible.</rdfs:comment>
        <rdfs:comment xml:lang="en">Which type of pickup</rdfs:comment>
        <rdfs:label xml:lang="en">Pickup type</rdfs:label>
        <rdfs:label xml:lang="es">tipo de recogida</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:ObjectProperty>
    


