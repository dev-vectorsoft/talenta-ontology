    <!-- http://vocab.gtfs.org/terms#agency -->

    <owl:ObjectProperty rdf:about="http://vocab.gtfs.org/terms#agency">
        <rdfs:range rdf:resource="http://vocab.gtfs.org/terms#Agency"/>
        <rdfs:comment xml:lang="es">Enlaza a una agencia de la que este concepto es parte.</rdfs:comment>
        <rdfs:comment xml:lang="en">links to an agency that this is part of.</rdfs:comment>
        <rdfs:label xml:lang="en">agency</rdfs:label>
        <rdfs:label xml:lang="es">empresa</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:ObjectProperty>
    


    <!-- http://vocab.gtfs.org/terms#destinationStop -->

    <owl:ObjectProperty rdf:about="http://vocab.gtfs.org/terms#destinationStop">
        <rdfs:range rdf:resource="http://vocab.gtfs.org/terms#Stop"/>
        <terms1:comment xml:lang="es">Conectado a to_stop_id en transfers.txt</terms1:comment>
        <terms1:comment xml:lang="en">Map from to_stop_id in transfers.txt</terms1:comment>
        <rdfs:comment xml:lang="es">Enlace al gtfs:Stop hacia el que va el viaje</rdfs:comment>
        <rdfs:comment xml:lang="en">Link to gtfs:Stop to go to</rdfs:comment>
        <rdfs:label xml:lang="en">Destination Stop</rdfs:label>
        <rdfs:label xml:lang="es">parada de destino</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:ObjectProperty>
    


    <!-- http://vocab.gtfs.org/terms#dropOffType -->

    <owl:ObjectProperty rdf:about="http://vocab.gtfs.org/terms#dropOffType">
        <rdfs:range rdf:resource="http://vocab.gtfs.org/terms#DropOffType"/>
        <rdfs:comment xml:lang="es">Indica si los pasajeros se bajan en una parada como parte del horario normal o si no pueden bajar en esa parada.</rdfs:comment>
        <rdfs:comment xml:lang="en">Which type of drop off</rdfs:comment>
        <rdfs:label xml:lang="en">Drop off type</rdfs:label>
        <rdfs:label xml:lang="es">tipo de bajada</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:ObjectProperty>
    


    <!-- http://vocab.gtfs.org/terms#originStop -->

    <owl:ObjectProperty rdf:about="http://vocab.gtfs.org/terms#originStop">
        <rdfs:range rdf:resource="http://vocab.gtfs.org/terms#Stop"/>
        <terms1:comment xml:lang="es">Conectado a from_stop_id en transfers.txt</terms1:comment>
        <terms1:comment xml:lang="en">Map from from_stop_id in transfers.txt</terms1:comment>
        <rdfs:comment xml:lang="es">Enlace al gtfs:Stop desde el que empieza el viaje</rdfs:comment>
        <rdfs:comment xml:lang="en">Link to gtfs:Stop to start from</rdfs:comment>
        <rdfs:label xml:lang="en">Origin Stop</rdfs:label>
        <rdfs:label xml:lang="es">parada de origen</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:ObjectProperty>
    


    <!-- http://vocab.gtfs.org/terms#parentStation -->

    <owl:ObjectProperty rdf:about="http://vocab.gtfs.org/terms#parentStation">
        <rdfs:domain rdf:resource="http://vocab.gtfs.org/terms#Stop"/>
        <rdfs:range rdf:resource="http://vocab.gtfs.org/terms#Station"/>
        <terms1:comment xml:lang="es">Enlaza a una lÃ­nea en stop.txt donde locationType=1.</terms1:comment>
        <terms1:comment xml:lang="en">Links to a row in stop.txt where locationType=1.</terms1:comment>
        <rdfs:comment xml:lang="es">gtfs:parentStation identifica la estaciÃ³n asociada a la parada</rdfs:comment>
        <rdfs:comment xml:lang="en">gtfs:parentStation identifies the station associated with the stop</rdfs:comment>
        <rdfs:label xml:lang="en">Parent Station</rdfs:label>
        <rdfs:label xml:lang="es">estaciÃ³n matriz</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:ObjectProperty>
    


