    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#maxConstructionHeight">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="de">Gibt die maximale Konstruktionshöhe an. Einheit in [m].</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the maximum construction height. 

Unit in [m].</rdfs:comment>
        <rdfs:label xml:lang="de">Konstruktionshöhe max.</rdfs:label>
        <rdfs:label xml:lang="en">maximum construction height</rdfs:label>
    </owl:DatatypeProperty>
    


