    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#maxLongitudinalGradient">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="de">Gibt die maximale Längsneigung der Brückenplatte an. Einheit in [%].</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the maximum longitudinal inclination of the bridge slab. 

Unit in [%].</rdfs:comment>
        <rdfs:label xml:lang="de">Maximale Längsneigung</rdfs:label>
        <rdfs:label xml:lang="en">maximum longitudinal gradient</rdfs:label>
    </owl:DatatypeProperty>
    


