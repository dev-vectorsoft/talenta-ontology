    </owl:Class>
    


    <!-- https://github.com/dev-vectorsoft/talenta/ontology#Car -->

    <owl:Class rdf:about="https://github.com/dev-vectorsoft/talenta/ontology#Car">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#LandVehicle"/>
    </owl:Class>
    


    <!-- https://github.com/dev-vectorsoft/talenta/ontology#Geolocation -->

    <owl:Class rdf:about="https://github.com/dev-vectorsoft/talenta/ontology#Geolocation">
        <rdfs:comment>Geolocation represents the geographic position of an asset or infrastructure element, typically expressed in coordinates (latitude, longitude). It is crucial for tracking and managing the location of assets within a digital twin environment.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/dev-vectorsoft/talenta/ontology#Geometry -->

    <owl:Class rdf:about="https://github.com/dev-vectorsoft/talenta/ontology#Geometry">
        <rdfs:comment>Geometry refers to the spatial dimensions and shape of assets or infrastructure components. It provides a mathematical description of objects in space, which is essential for visualizing and modeling assets in the digital twin.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/dev-vectorsoft/talenta/ontology#Helicopter -->

    <owl:Class rdf:about="https://github.com/dev-vectorsoft/talenta/ontology#Helicopter">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#Aircraft"/>
    </owl:Class>
    


    <!-- https://github.com/dev-vectorsoft/talenta/ontology#LandVehicle -->

    <owl:Class rdf:about="https://github.com/dev-vectorsoft/talenta/ontology#LandVehicle">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#Vehicle"/>
    </owl:Class>
    


    <!-- https://github.com/dev-vectorsoft/talenta/ontology#MaterialProperty -->

    <owl:Class rdf:about="https://github.com/dev-vectorsoft/talenta/ontology#MaterialProperty">
        <rdfs:comment>MaterialProperty encompasses the physical and chemical properties of the materials used in constructing assets and infrastructure. This includes characteristics like strength, durability, and weight, important for maintenance and operational decisions.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/dev-vectorsoft/talenta/ontology#Motorcycle -->

    <owl:Class rdf:about="https://github.com/dev-vectorsoft/talenta/ontology#Motorcycle">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#LandVehicle"/>
    </owl:Class>
    


    <!-- https://github.com/dev-vectorsoft/talenta/ontology#Plane -->

    <owl:Class rdf:about="https://github.com/dev-vectorsoft/talenta/ontology#Plane">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#Aircraft"/>
    </owl:Class>
    


    <!-- https://github.com/dev-vectorsoft/talenta/ontology#Railway -->

    <owl:Class rdf:about="https://github.com/dev-vectorsoft/talenta/ontology#Railway">
