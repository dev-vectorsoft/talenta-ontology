        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.gtfs.org/terms#bikesAllowed -->

    <owl:DatatypeProperty rdf:about="http://vocab.gtfs.org/terms#bikesAllowed">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">Bikes allowed</rdfs:label>
        <rdfs:label xml:lang="es">bicicletas permitidas</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.gtfs.org/terms#block -->

    <owl:DatatypeProperty rdf:about="http://vocab.gtfs.org/terms#block">
        <rdfs:domain rdf:resource="http://vocab.gtfs.org/terms#Trip"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="es">Identifica el bloque al que pertenece el viaje. Un bloque consta de dos o mÃ¡s viajes secuenciales realizados en el mismo vehÃ­culo, en los que un pasajero puede cambiar de viaje si simplemente permanece en el vehÃ­culo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Identifies the block to which the trip within this feed belongs. A block consists of two or more sequential trips made using the same vehicle, where a passenger can transfer from one trip to the next just by staying in the vehicle.</rdfs:comment>
        <rdfs:label xml:lang="en">Block</rdfs:label>
        <rdfs:label xml:lang="es">Bloque</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.gtfs.org/terms#color -->

    <owl:DatatypeProperty rdf:about="http://vocab.gtfs.org/terms#color">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A 6 character hexidecimal color (without #)</rdfs:comment>
        <rdfs:comment xml:lang="es">Un color expresado con 6 caracteres hexadecimales (sin #)</rdfs:comment>
        <rdfs:label xml:lang="en">Color</rdfs:label>
        <rdfs:label xml:lang="es">color</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.gtfs.org/terms#dateAddition -->

    <owl:DatatypeProperty rdf:about="http://vocab.gtfs.org/terms#dateAddition">
        <rdfs:domain rdf:resource="http://vocab.gtfs.org/terms#CalendarDateRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms1:comment xml:lang="es">El campo exception_type en calendar_dates.txt - 1 es cierto, 2 es falso.</terms1:comment>
        <terms1:comment xml:lang="en">The exception_type field in calendar_dates.txt - 1 is true, 2 is false.</terms1:comment>
        <rdfs:comment xml:lang="en">A boolean whether to add (true) or remove (false) a date</rdfs:comment>
        <rdfs:comment xml:lang="es">Booleano que indica si el servicio se ha agregado (cierto) o suprimido (falso) en la fecha especificada</rdfs:comment>
        <rdfs:label xml:lang="en">Date Addition</rdfs:label>
        <rdfs:label xml:lang="es">incorporaciÃ³n de fecha</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.gtfs.org/terms#departureTime -->

    <owl:DatatypeProperty rdf:about="http://vocab.gtfs.org/terms#departureTime">
        <rdfs:domain rdf:resource="http://vocab.gtfs.org/terms#StopTime"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:comment xml:lang="en">Check the original specification for special cases</rdfs:comment>
        <rdfs:comment xml:lang="es">Compruebe la especificaciÃ³n original para casos especiales</rdfs:comment>
        <rdfs:label xml:lang="en">Departure time</rdfs:label>
        <rdfs:label xml:lang="es">hora de salida</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://developers.google.com/transit/gtfs/reference#stop_times_fields"/>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.gtfs.org/terms#direction -->

    <owl:DatatypeProperty rdf:about="http://vocab.gtfs.org/terms#direction">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">A binary property to indicate the direction the trip is going (e.g., outbound/inbound, center/airport)</rdfs:comment>
        <rdfs:comment xml:lang="es">Apunta a un valor binario que indica la direcciÃ³n del viaje (e.g., ida/vuelta, centro/aeropuerto)</rdfs:comment>
        <rdfs:label xml:lang="en">Direction</rdfs:label>
        <rdfs:label xml:lang="es">direcciÃ³n</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.gtfs.org/terms#distanceTraveled -->

    <owl:DatatypeProperty rdf:about="http://vocab.gtfs.org/terms#distanceTraveled">
        <rdfs:domain rdf:resource="http://vocab.gtfs.org/terms#Shape"/>
        <rdfs:domain rdf:resource="http://vocab.gtfs.org/terms#StopTime"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="es">Indica la distancia a una parada desde el primer punto del recorrido. Representa una distancia de viaje real durante la ruta en unidades expresadas como pies o kilÃ³metros. Esta informaciÃ³n permite que quien planifica el viaje determine la porciÃ³n de la forma que se debe trazar al mostrar parte de un viaje en el mapa. Los valores utilizados para gtfs:distanceTraveled se deben incrementar junto con los de gtfs:stopSequence, es decir, no se pueden usar para mostrar el recorrido inverso a lo largo de una ruta.</rdfs:comment>
        <rdfs:comment xml:lang="en">Positions a stop as a distance from the first shape point. It represents a real distance traveled along the route in units such as feet or kilometers. This information allows the trip planner to determine how much of the shape to draw when showing part of a trip on the map. The values used for gtfs:distanceTraveled must increase along with gtfs:stopSequence: they cannot be used to show reverse travel along a route.</rdfs:comment>
        <rdfs:label xml:lang="en">Distance Traveled</rdfs:label>
        <rdfs:label xml:lang="es">distancia recorrida</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.gtfs.org/terms#endTime -->

    <owl:DatatypeProperty rdf:about="http://vocab.gtfs.org/terms#endTime">
        <rdfs:domain rdf:resource="http://vocab.gtfs.org/terms#Frequency"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Define la hora a la que el servicio cambia de frecuencia (o bien finaliza) en la primera parada del viaje.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates the time at which service changes to a different frequency (or ceases) at the first stop in the trip.</rdfs:comment>
        <rdfs:label xml:lang="en">End Time</rdfs:label>
        <rdfs:label xml:lang="es">hora final</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.gtfs.org/terms#friday -->

    <owl:DatatypeProperty rdf:about="http://vocab.gtfs.org/terms#friday">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Service is available on Friday</rdfs:comment>
        <rdfs:comment xml:lang="es">Servicio disponible los viernes</rdfs:comment>
        <rdfs:label xml:lang="en">Friday</rdfs:label>
        <rdfs:label xml:lang="es">viernes</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.gtfs.org/terms#headsign -->

    <owl:DatatypeProperty rdf:about="http://vocab.gtfs.org/terms#headsign">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Esta propiedad apunta al texto que indica el destino del viaje a los pasajeros.</rdfs:comment>
        <rdfs:comment xml:lang="en">The gtfs:headsign property contains the text that appears on a sign that identifies the trip&apos;s destination to passengers.</rdfs:comment>
        <rdfs:label xml:lang="en">Headsign</rdfs:label>
        <rdfs:label xml:lang="es">destino del viaje</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://developers.google.com/transit/gtfs/examples/display-to-users#TripHeadsign"/>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.gtfs.org/terms#headwaySeconds -->

    <owl:DatatypeProperty rdf:about="http://vocab.gtfs.org/terms#headwaySeconds">
        <rdfs:domain rdf:resource="http://vocab.gtfs.org/terms#Frequency"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="es">Indica el perÃ­odo de tiempo (en segundos) entre salidas desde la misma parada (tiempo entre viajes) para este tipo de viaje, durante el intervalo de tiempo especificado mediante start_time y end_time.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates the time between departures from the same stop (headway) for this trip type, during the time interval specified by gtfs:startTime and gtfs:endTime.</rdfs:comment>
        <rdfs:label xml:lang="en">Headway Seconds</rdfs:label>
        <rdfs:label xml:lang="es">tiempo entre viajes</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.gtfs.org/terms#minimumTransferTime -->

    <owl:DatatypeProperty rdf:about="http://vocab.gtfs.org/terms#minimumTransferTime">
        <rdfs:domain rdf:resource="http://vocab.gtfs.org/terms#TransferRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="es">El tiempo mÃ­nimo de transbordo cuando gtfs:transferType es gtfs:MinimumTimeTransfer.</rdfs:comment>
        <rdfs:comment xml:lang="en">The minimum transfer time when the gtfs:transferType is gtfs:MinimumTimeTransfer.</rdfs:comment>
        <rdfs:label xml:lang="en">Minimum Transfer Time</rdfs:label>
        <rdfs:label xml:lang="es">Tiempo mÃ­nimo de transbordo</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.gtfs.org/terms#monday -->

    <owl:DatatypeProperty rdf:about="http://vocab.gtfs.org/terms#monday">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Service is available on Monday</rdfs:comment>
        <rdfs:comment xml:lang="es">Servicio disponible los lunes</rdfs:comment>
        <rdfs:label xml:lang="en">Monday</rdfs:label>
        <rdfs:label xml:lang="es">lunes</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.gtfs.org/terms#pointSequence -->

    <owl:DatatypeProperty rdf:about="http://vocab.gtfs.org/terms#pointSequence">
        <rdfs:domain rdf:resource="http://vocab.gtfs.org/terms#ShapePoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="es">El campo shape_pt_sequence asocia la latitud y longitud de un punto de recorrido con su orden de secuencia en el recorrido. Los valores para shape_pt_sequence deben ser nÃºmeros enteros positivos y crecientes conforme avanza el viaje.</rdfs:comment>
        <rdfs:comment xml:lang="en">The shape_pt_sequence field associates the latitude and longitude of a shape point with its sequence order along the shape. The values for shape_pt_sequence must be non-negative integers, and they must increase along the trip.</rdfs:comment>
        <rdfs:label xml:lang="en">Point Sequence</rdfs:label>
        <rdfs:label xml:lang="es">secuencia de puntos</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.gtfs.org/terms#saturday -->

    <owl:DatatypeProperty rdf:about="http://vocab.gtfs.org/terms#saturday">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Service is available on Saturday</rdfs:comment>
