    <owl:DatatypeProperty rdf:about="https://wisib.de/ontologie/bridge#maxTransverseGradient">
        <rdfs:domain rdf:resource="https://wisib.de/ontologie/brot#Bridge"/>
        <rdfs:comment xml:lang="de">Gibt die maximale Querneigung der Brückenplatte an. Einheit in [%].</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the maximum transverse inclination of the bridge slab. 

Unit in [%].</rdfs:comment>
        <rdfs:label xml:lang="de">maximale Querneigung</rdfs:label>
        <rdfs:label xml:lang="en">maximum transverse gradient</rdfs:label>
    </owl:DatatypeProperty>
    


