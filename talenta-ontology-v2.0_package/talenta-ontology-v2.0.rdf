        </rdfs:domain>
        <rdfs:range rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_of_measure"/>
        <rdfs:comment>For quantity classes this property indicates a commonly-used unit.</rdfs:comment>
        <rdfs:label xml:lang="en">unit of measure</rdfs:label>
        <om-1:alternative_label xml:lang="en">has unit of measure</om-1:alternative_label>
    </owl:ObjectProperty>
    


