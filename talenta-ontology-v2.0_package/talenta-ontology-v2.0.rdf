        <rdfs:subPropertyOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#i72DataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:DatatypeProperty>
    


    <!-- http://ontology.eil.utoronto.ca/5087/1/Time/TimeOntologyDataProperty -->

    <owl:DatatypeProperty rdf:about="http://ontology.eil.utoronto.ca/5087/1/Time/TimeOntologyDataProperty">
        <dc:description>Data property added for organizational purposes, to identify data properties defined in the Time Ontology.</dc:description>
    </owl:DatatypeProperty>
    


    <!-- http://ontology.eil.utoronto.ca/ISO21972/iso21972#exponent -->

    <owl:DatatypeProperty rdf:about="http://ontology.eil.utoronto.ca/ISO21972/iso21972#exponent">
        <rdfs:subPropertyOf rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#i72DataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Unit_exponentiation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">exponent</rdfs:label>
        <om-1:alternative_label xml:lang="en">has exponent</om-1:alternative_label>
