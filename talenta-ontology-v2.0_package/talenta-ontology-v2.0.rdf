        <rdfs:seeAlso rdf:resource="https://developers.google.com/transit/gtfs/reference#transfers_fields"/>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:Class>
    


    <!-- http://vocab.gtfs.org/terms#TransferType -->

    <owl:Class rdf:about="http://vocab.gtfs.org/terms#TransferType">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#gtfsThing"/>
        <terms1:comment xml:lang="es">Si transfer_type en transfers.txt es 0 o vacÃ­o, mapee a gtfs:RecommendedTransfer; si es 1, mapee to gtfs:EnsuredTransfer; si es 2, a gtfs:MinimumTimeTransfer; si es 3, a gtfs:NoTransfer</terms1:comment>
        <terms1:comment xml:lang="en">When transfer_type in transfers.txt is 0 or empty, map to gtfs:RecommendedTransfer, when 1, map to gtfs:EnsuredTransfer, when 2, gtfs:MinimumTimeTransfer, when 3: gtfs:NoTransfer.</terms1:comment>
        <rdfs:comment xml:lang="en">Instances of this class can be used to describe how to handle a transfer rule</rdfs:comment>
        <rdfs:comment xml:lang="es">Instancias de esta clase pueden ser usadas para describir cÃ³mo gestionar las reglas de transbordo</rdfs:comment>
        <rdfs:label xml:lang="es">Tipo de transbordo</rdfs:label>
        <rdfs:label xml:lang="en">Transfer Type</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:Class>
    


    <!-- http://vocab.gtfs.org/terms#TransfersAllowedType -->

    <owl:Class rdf:about="http://vocab.gtfs.org/terms#TransfersAllowedType">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#gtfsThing"/>
        <rdfs:comment xml:lang="en">Instances of this class describe whether tickets remain valid when transferring</rdfs:comment>
        <rdfs:comment xml:lang="es">Las instancias de esta clase describen si los billetes son vÃ¡lidos para realizar transbordos</rdfs:comment>
        <rdfs:label xml:lang="es">Tipo de transbordo permitido</rdfs:label>
        <rdfs:label xml:lang="en">Transfers Allowed Type</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:Class>
    


    <!-- http://vocab.gtfs.org/terms#Trip -->

    <owl:Class rdf:about="http://vocab.gtfs.org/terms#Trip">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#gtfsThing"/>
        <rdfs:comment xml:lang="en">A collection of gtfs:StopTimes followed by a transit vehicle</rdfs:comment>
        <rdfs:comment xml:lang="es">Trayecto de dos o mÃ¡s paradas realizadas por un vehÃ­culo que se produce a una gtfs:StopTime</rdfs:comment>
        <rdfs:label xml:lang="en">Trip</rdfs:label>
        <rdfs:label xml:lang="es">Viaje</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://developers.google.com/transit/gtfs/reference#trips_fields"/>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:Class>
    


    <!-- http://vocab.gtfs.org/terms#WheelchairBoardingStatus -->

    <owl:Class rdf:about="http://vocab.gtfs.org/terms#WheelchairBoardingStatus">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#gtfsThing"/>
        <rdfs:comment xml:lang="en">A class whom&apos;s instances indicate how accessible a gtfs:Trip, gtfs:Stop or gtfs:Station is.</rdfs:comment>
        <rdfs:comment xml:lang="es">Las instancias de esta clase indican como de accesible es un gtfs:Trip, un gtfs:Stop o una gtfs:Station.</rdfs:comment>
        <rdfs:label xml:lang="es">InformaciÃ³n de accesibilidad para silla de ruedas</rdfs:label>
        <rdfs:label xml:lang="en">Wheelchair Boarding Information</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://developers.google.com/transit/gtfs/reference#stops_fields"/>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:Class>
    


    <!-- http://vocab.gtfs.org/terms#Zone -->

    <owl:Class rdf:about="http://vocab.gtfs.org/terms#Zone">
        <rdfs:subClassOf rdf:resource="https://github.com/dev-vectorsoft/talenta/ontology#gtfsThing"/>
        <rdfs:comment xml:lang="es">Las zonas son necesarias si quiere proporcionar informaciÃ³n de tarifas usando gtfs:FareClass</rdfs:comment>
        <rdfs:comment xml:lang="en">Zones are required if you want to provide fare information using gtfs:FareClass</rdfs:comment>
        <rdfs:label xml:lang="es">Zona</rdfs:label>
        <rdfs:label xml:lang="en">Zone</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#Feature -->

    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Feature">
        <rdfs:comment>A Feature describes a specific characteristic, attribute, or function of an asset within the transportation system. This could include properties like speed, capacity, or specific functionalities related to vehicles or infrastructure.</rdfs:comment>
    </owl:Class>
    


