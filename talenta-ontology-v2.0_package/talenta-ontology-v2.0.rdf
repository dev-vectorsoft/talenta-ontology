        <rdfs:domain rdf:resource="http://vocab.gtfs.org/terms#FareClass"/>
        <rdfs:range rdf:resource="http://vocab.gtfs.org/terms#PaymentMethod"/>
        <terms1:comment xml:lang="es">Campo payment_method en fare_attributes. Si es 0, use gtfs:OnBoard; si es 1, use gtfs:BeforeBoarding</terms1:comment>
        <terms1:comment xml:lang="en">payment_method field in fare_attributes. If 0, use gtfs:OnBoard; if 1, use gtfs:BeforeBoarding</terms1:comment>
        <rdfs:comment xml:lang="en">The payment method</rdfs:comment>
        <rdfs:comment xml:lang="es">el mÃ©todo de pago</rdfs:comment>
        <rdfs:label xml:lang="es">MÃ©todo de pago</rdfs:label>
        <rdfs:label xml:lang="en">Payment method</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:ObjectProperty>
    


    <!-- http://vocab.gtfs.org/terms#pickupType -->

