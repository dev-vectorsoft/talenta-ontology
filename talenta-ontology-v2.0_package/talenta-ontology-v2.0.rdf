                <owl:allValuesFrom rdf:resource="http://www.w3.org/2006/time#DurationDescription"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/TransportationSystem/TTI -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/TransportationSystem/TTI">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Ratio"/>
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyThing"/>
        <rdfs:comment>Travel Time Index: a ratio of the inverse speed (travel time) to the inverse of some calculated, threshold speed (travel time).</rdfs:comment>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/TransportationSystem/TTI_Max -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/TransportationSystem/TTI_Max">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/TransportationSystem/TTI"/>
        <rdfs:comment>The Travel Time Index (TTI) calculated against the Maximum throughput speed (average speed at capacity).</rdfs:comment>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/TransportationSystem/TTI_Min -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/TransportationSystem/TTI_Min">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/TransportationSystem/TTI"/>
        <rdfs:comment>The Travel Time Index calculated against the minimum throughput speed.</rdfs:comment>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationComplex -->

