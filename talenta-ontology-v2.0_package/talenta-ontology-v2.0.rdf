        <dc:description>Added for organizational purposes, to identify all classes defined in the Transportation System ontology.</dc:description>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/icity/TransportationSystem/VehicleVolume -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/icity/TransportationSystem/VehicleVolume">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/OM/Quantity"/>
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyThing"/>
