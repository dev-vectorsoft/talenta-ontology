    <!-- http://vocab.gtfs.org/terms#comment -->

    <owl:AnnotationProperty rdf:about="http://vocab.gtfs.org/terms#comment">
        <rdfs:comment xml:lang="en">A comment on the relation between the RDFS ontology and the CSV specification.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un comentario entre la relaciÃ³n entre la ontologÃ­a RDFS y la especificaciÃ³n CSV.</rdfs:comment>
        <rdfs:label xml:lang="es">Comentario de enlace</rdfs:label>
        <rdfs:label xml:lang="en">Mapping comment</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
    </owl:AnnotationProperty>
    


    <!-- http://vocab.gtfs.org/terms#fareUrl -->

    <owl:AnnotationProperty rdf:about="http://vocab.gtfs.org/terms#fareUrl">
        <rdfs:comment xml:lang="es">La URL de una pÃ¡gina web que permite a un usuario comprar online billetes u otros productos de transporte de esa empresa</rdfs:comment>
        <rdfs:comment xml:lang="en">The URL of a web page that allows a rider to purchase tickets or other fare instruments for that agency online</rdfs:comment>
        <rdfs:label xml:lang="es">URL de tarifas</rdfs:label>
        <rdfs:label xml:lang="en">fare URL</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://developers.google.com/transit/gtfs/reference#agency_fields"/>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
        <rdfs:subPropertyOf rdf:resource="http://xmlns.com/foaf/0.1/page"/>
        <rdfs:domain rdf:resource="http://vocab.gtfs.org/terms#Agency"/>
    </owl:AnnotationProperty>
    


