        <rdfs:comment xml:lang="en">Links to the type of vehicle operating on this route</rdfs:comment>
        <rdfs:label xml:lang="en">Route type</rdfs:label>
        <rdfs:label xml:lang="es">tipo de ruta</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://developers.google.com/transit/gtfs/examples/display-to-users#RouteType"/>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:ObjectProperty>
    


    <!-- http://vocab.gtfs.org/terms#service -->

    <owl:ObjectProperty rdf:about="http://vocab.gtfs.org/terms#service">
