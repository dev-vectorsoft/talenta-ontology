    <!-- http://vocab.gtfs.org/terms#transfers -->

    <owl:ObjectProperty rdf:about="http://vocab.gtfs.org/terms#transfers">
        <rdfs:domain rdf:resource="http://vocab.gtfs.org/terms#FareClass"/>
        <rdfs:range rdf:resource="http://vocab.gtfs.org/terms#TransfersAllowedType"/>
        <terms1:comment xml:lang="en">Map to 0 to gtfs:NoTransfersAllowed, 1 to gtfs:OneTransferAllowed, 2 to gtfs:TwoTransfersAllowed and empty to gtfs:UnlimitedTransfersAllowed</terms1:comment>
        <terms1:comment xml:lang="es">Valor 0 si no se permite ningÃºn transbordo (gtfs:NoTransfersAllowed), 1 si se puede realizar un transbordo (gtfs:OneTransferAllowed), 2 si se pueden realizar dos transbordos (gtfs:TwoTransfersAllowed) y deje el campo vacÃ­o si se permite una cantidad ilimitada de transbordos (gtfs:UnlimitedTransfersAllowed)</terms1:comment>
        <rdfs:comment xml:lang="en">The validity of the ticket when transferring</rdfs:comment>
        <rdfs:comment xml:lang="es">Validez del ticket para transbordos</rdfs:comment>
        <rdfs:label xml:lang="en">Transfers</rdfs:label>
        <rdfs:label xml:lang="es">transbordos</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </owl:ObjectProperty>
    


