    <rdf:Description rdf:about="http://vocab.gtfs.org/terms#code">
        <terms1:comment xml:lang="en">This is the stop_code field</terms1:comment>
        <rdfs:comment xml:lang="en">A gtfs:code predicate defines the stop code for a stop.</rdfs:comment>
        <rdfs:label xml:lang="en">Stop Code</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://developers.google.com/transit/gtfs/reference#stops_fields"/>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </rdf:Description>
    <rdf:Description rdf:about="http://vocab.gtfs.org/terms#destinationZone">
        <rdfs:comment xml:lang="en">La zona de destino donde una clase tarifaria se aplica</rdfs:comment>
        <rdfs:comment xml:lang="en">The destination zone where this applies</rdfs:comment>
        <rdfs:label xml:lang="en">Destination Zone</rdfs:label>
        <rdfs:label xml:lang="es">zona de destino</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </rdf:Description>
    <rdf:Description rdf:about="http://vocab.gtfs.org/terms#originZone">
        <rdfs:comment xml:lang="es">La zona de origen donde una clase tarifaria se aplica</rdfs:comment>
        <rdfs:comment xml:lang="en">The origin zone where this applies</rdfs:comment>
        <rdfs:label xml:lang="en">Origin Zone</rdfs:label>
        <rdfs:label xml:lang="es">zona de origen</rdfs:label>
        <ns3:term_status xml:lang="es">inestable</ns3:term_status>
        <ns3:term_status xml:lang="en">unstable</ns3:term_status>
    </rdf:Description>
    <rdf:Description rdf:about="http://vocab.gtfs.org/terms#timeZone">
