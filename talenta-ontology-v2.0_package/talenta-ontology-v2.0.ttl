bmat:Mortar a owl:Class ;
    rdfs:label "Mortar"@en ;
    rdfs:comment "Material used to fill the gaps between blocks and bind them together."@en ;
    rdfs:subClassOf bmat:BuildingMaterial .

brcomp:Asphalt a owl:Class ;
    rdfs:label "Asphalt"@en ;
    rdfs:comment "Natural or technically produced mixture of the binder bitumen and aggregates used in road construction for road pavements."@en ;
    rdfs:subClassOf brot:Coating .

brcomp:Pavement a owl:Class ;
    rdfs:label "Gehweg"@de,
        "Pavement"@en ;
    rdfs:comment "Part of a road intended for pedestrian traffic."@en ;
    rdfs:subClassOf brcomp:FinishingComponent .

brcomp:Pile a owl:Class ;
    rdfs:label "Pfahl"@de,
        "Pile"@en ;
    rdfs:comment "Rod-shaped component that reaches a certain depth into the soil and is connected to the Foundation."@en ;
    rdfs:subClassOf brcomp:FoundationComponent .

brcomp:Railing a owl:Class ;
    rdfs:label "Geländer"@de,
        "Railing"@en ;
    rdfs:comment "Component for the fall protection of persons, which is often installed at the edge of the pavement."@en ;
    rdfs:subClassOf brcomp:FinishingComponent .

brcomp:SafetyKerb a owl:Class ;
    rdfs:label "Schrammbord"@de,
        "Safety kerb"@en ;
    rdfs:comment "Protective device made of wood, concrete, asphalt or steel for securing road users or workplaces on or near roads."@en ;
    rdfs:subClassOf brcomp:FinishingComponent .

bridge:BoxGirderBridge a owl:Class ;
    rdfs:label "Hohlkastenbrücke"@de,
        "Box girder bridge"@en ;
    rdfs:comment "Bridge in which the main beams comprise girders in the shape of a hollow box. The box girder normally comprises either prestressed concrete, structural steel, or a composite of steel and reinforced concrete. The box is typically rectangular or trapezoidal in cross-section."@en ;
    rdfs:subClassOf bridge:GirderBridge .

bridge:CompositeBridge a owl:Class ;
    rdfs:label "Composite bridge"@en ;
    rdfs:comment "Composite steel bridges are structures consisting of steel main girders and a concrete deck slab above them."@en ;
    rdfs:subClassOf brot:Bridge .

bridge:GirderBridge a owl:Class ;
    rdfs:label "Plattenbalken- / Trägerrost- Brücke"@de,
        "Girder bridge"@en ;
    rdfs:comment "Bridge that uses girders as the means of supporting its deck."@en ;
    rdfs:subClassOf brot:Bridge .

bridge:PedestrianBridge a owl:Class ;
    rdfs:label "Pedestrian Bridge"@en ;
    rdfs:comment "Bridge designed solely for pedestrians"@en ;
    rdfs:subClassOf brot:Bridge .

bridge:PrestressedConcreteBridge a owl:Class ;
    rdfs:label "Prestressed concrete bridge"@en ;
    rdfs:comment "Bridge that uses prestressed concrete as building material."@en ;
    rdfs:subClassOf brot:Bridge ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty brot:containsComponent ;
            owl:someValuesFrom brcomp:Tendon ] .

bridge:RailwayBridge a owl:Class ;
    rdfs:label "Railway bridge"@en ;
    rdfs:comment "Bridge specially designed to guide a railway line and the railways running on it over obstacles."@en ;
    rdfs:subClassOf brot:Bridge .

bridge:SlabBridge a owl:Class ;
    rdfs:label "Slab bridge"@en ;
    rdfs:comment "Short-span bridge consisting of a reinforced-concrete slab resting on abutments"@en ;
    rdfs:subClassOf brot:Bridge .

bridge:Steelbridge a owl:Class ;
    rdfs:label "Steel bridge"@en ;
    rdfs:comment "Bridge that uses mainly steel as building material."@en ;
    rdfs:subClassOf brot:Bridge .

bridge:StoneBridge a owl:Class ;
    rdfs:label "Stone bridge"@en ;
    rdfs:comment "Bridge that uses mainly (natural) stone as building material."@en ;
    rdfs:subClassOf brot:Bridge .

bridge:TransportBridge a owl:Class ;
    rdfs:label "Transport bridge"@en ;
    rdfs:comment "Movable bridge that carries a segment of roadway across a river."@en ;
    rdfs:subClassOf brot:Bridge .

bridge:WoodBridge a owl:Class ;
    rdfs:label "Wood bridge"@en ;
    rdfs:comment "Bridge that uses mainly wood as building material."@en ;
    rdfs:subClassOf brot:Bridge .

bridge:Workshop a owl:Class ;
    rdfs:label "Meisterei"@de,
        "Workshop"@en ;
    rdfs:comment "Zuständiger Betrieb / Meisterei für Brückenbauwerk"@de,
        "Responsible company / workshop for constructing the bridge."@en ;
    rdfs:subClassOf ontology:Organisation .

brot:Site a owl:Class ;
    rdfs:subClassOf :BridgeInfrastructure .

brot:SpatialZone a owl:Class ;
    rdfs:subClassOf :BridgeInfrastructure .

brot:SubStructure a owl:Class ;
    rdfs:subClassOf :BridgeInfrastructure .

brot:SuperStructure a owl:Class ;
    rdfs:subClassOf :BridgeInfrastructure .

brot:aggregates a owl:ObjectProperty .

brot:locatedAbove a owl:ObjectProperty .

brot:locatedBelow a owl:ObjectProperty .

brstr:AlignmentOrigin a owl:Class ;
    rdfs:label "Alignment origin"@en ;
    rdfs:comment """Defines the origin of the alignment curve.

Recommended instance: brcomp:Abutment"""@en ;
    rdfs:subClassOf :BridgeInfrastructure .

brstr:StructuralAssessmentDIN1072 a owl:Class ;
    rdfs:label "Structural assessment DIN1072"@en ;
    rdfs:comment "Structural assessment according to the German standard DIN1072."@en ;
    rdfs:subClassOf brstr:StructuralAssessment .

brstr:getsLoadsFrom a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain brot:Component ;
    rdfs:range brot:Component .

brstr:loads a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "loads"@en ;
    rdfs:comment "Relation between a component that transfers loads and the component that receives them."@en ;
    rdfs:domain brot:Component ;
    rdfs:range brot:Component .

brstr:restsOn a owl:ObjectProperty ;
    rdfs:label "liegt auf"@de,
        "rest on"@en ;
    rdfs:comment "Bei dieser Relation ist angegegeben, dass ein Element A sich auf ein anderes Element B stuetzt und das Element A leitet die Lasten zu dem unteren Element B weiter"@de,
        "By this relationship is pointed that a component A rest on an other component B and transmit some load to the lower component B."@en ;
    rdfs:domain brot:Component ;
    rdfs:range brot:Component ;
    rdfs:subPropertyOf brot:adjacentComponent,
        brot:locatedAbove,
        brstr:loads .

ontology:City a owl:Class ;
    rdfs:subClassOf :BridgeInfrastructure .

<http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Population> a owl:Class ;
    rdfs:comment "The govstat Population is specialized for indicator use to include what defines a member of the population, the location of the population, and the time the population was measured." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#defined_by> ],
        [ a owl:Restriction ;
            owl:onClass time:DateTimeDescription ;
            owl:onProperty <http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#for_time_interval> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        OM:OMThing ;
    owl:equivalentClass iso21972:Population .

iso21972:Measurement_scale_category a owl:Class ;
    rdfs:subClassOf iso21972:ISO21972Thing .

iso21972:Ordered_measurement_scale_category a owl:Class ;
    rdfs:subClassOf iso21972:ISO21972Thing .

iso21972:Ratio_scale a owl:Class ;
    rdfs:label "ratio scale"@en ;
    rdfs:subClassOf iso21972:Cardinal_scale .

iso21972:Standard_deviation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass iso21972:Population ;
            owl:onProperty iso21972:std_of ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        iso21972:Parameter .

iso21972:denominator a owl:ObjectProperty ;
    rdfs:label "denominatot"@en ;
    rdfs:domain iso21972:Unit_division ;
    rdfs:range iso21972:Unit_of_measure ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty ;
    om-1:alternative_label "has denominatot"@en .

iso21972:for_time_interval a owl:ObjectProperty ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

iso21972:hecto_kilo_pc a iso21972:Unit_multiple_or_submultiple,
        owl:NamedIndividual ;
    iso21972:prefix iso21972:hecto_kilo ;
    iso21972:singular_unit iso21972:population_cardinality_unit ;
    iso21972:symbol "hecto_kilo_pc" .

iso21972:hour a iso21972:Singular_unit,
        owl:NamedIndividual .

iso21972:interruption a iso21972:Singular_unit,
        owl:NamedIndividual .

iso21972:is_characteristic_of a owl:ObjectProperty ;
    rdfs:domain iso21972:Variable ;
    rdfs:range iso21972:Observation ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

iso21972:is_composed_of a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( iso21972:Population iso21972:Sample ) ] ;
    rdfs:range iso21972:Observation ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty ;
    owl:inverseOf iso21972:member_of .

iso21972:kilowatt a iso21972:Unit_multiple_or_submultiple,
        owl:NamedIndividual ;
    iso21972:prefix iso21972:kilo ;
    iso21972:singular_unit iso21972:watt ;
    iso21972:symbol "kwh" .

iso21972:member_of a owl:ObjectProperty ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

iso21972:metre a iso21972:Singular_unit,
        owl:NamedIndividual ;
    iso21972:symbol "m2" .

iso21972:numerator a owl:ObjectProperty ;
    rdfs:label "numerator"@en ;
    rdfs:domain iso21972:Unit_division ;
    rdfs:range iso21972:Unit_of_measure ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty ;
    om-1:alternative_label "has numerator"@en .

iso21972:numerical_value a owl:DatatypeProperty ;
    rdfs:label "numerical value"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( iso21972:Measure iso21972:Point ) ] ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf iso21972:i72DataProperty ;
    om-1:alternative_label "has numerical value"@en .

iso21972:occurrence a iso21972:Singular_unit,
        owl:NamedIndividual .

iso21972:square_metre a iso21972:Unit_exponentiation,
        owl:NamedIndividual ;
    iso21972:base iso21972:metre ;
    iso21972:exponent 2 .

iso21972:year a iso21972:Singular_unit,
        owl:NamedIndividual .

<http://ontology.eil.utoronto.ca/icity/Change/ChangeOntologyThing> a owl:Class ;
    rdfs:comment "Added for organizational purposes to group the classes defined in the Change Ontology." ;
    rdfs:subClassOf :TransportationSystemThing .

<http://ontology.eil.utoronto.ca/icity/Mereology/hasComponent> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/Mereology/hasProperPart> .

<http://ontology.eil.utoronto.ca/icity/Mereology/properPartOf> a owl:ObjectProperty ;
    dc:description """Something may be a Proper Part of some other thing.
An object cannot be a proper part of itself. Thus, any object must have more than one proper part.
Proper Parthood is transitive.
Proper parthood is dense and so there exist no immediate proper parts; in other words, given some object, whatever proper part, x, we choose, there exists some slightly larger proper part of the object that also has x as a proper part.""" ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/Mereology/MereologyOntologyProperty> .

OM:Capacity a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#defined_by> ],
        OM:OMThing .

OM:CardinalityMeasure a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Cardinality_unit> ;
            owl:onProperty OM:hasUnit ],
        OM:Measure .

OM:Function a owl:Class ;
    rdfs:label "function" ;
    rdfs:subClassOf OM:OMThing .

OM:Geo_Position_unit a owl:Class ;
    rdfs:comment "Reference systems to indicate geographic position." ;
    rdfs:subClassOf OM:Unit .

OM:Length a owl:Class ;
    rdfs:label "length" ;
    rdfs:comment "Length is the amount of space between two geographical points along a curve. It is a base quantity in the International System of Units and other systems of units. Length is speed times time. The metre, a base unit of length in the International System of Units, is defined in terms of speed of light during a certain time interval." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( OM:Measure [ a owl:Restriction ;
                                owl:allValuesFrom OM:LengthUnit ;
                                owl:onProperty OM:hasUnit ] ) ] ;
            owl:onProperty OM:hasValue ],
        OM:Quantity .

OM:System_of_units a owl:Class ;
    rdfs:label "system of units" ;
    rdfs:comment "In order to achieve a coherent, interdependent set of units of measure in the wide variety of units that exist, units are organised in systems of units. A system of units is based on a set of units chosen by convention to be the system’s base units, units that are considered to be mutually independent (i.e., can’t be expressed in terms of each other)." ;
    rdfs:subClassOf OM:OMThing .

<http://ontology.eil.utoronto.ca/icity/SSN/ssnDataProperty> a owl:DatatypeProperty .

<http://ontology.eil.utoronto.ca/icity/SpatialLoc/associatedLocation> a owl:ObjectProperty ;
    rdfs:comment "Describes an approximate location of some object (spatial or non-spatial). For example, a Building has an actual location (represented by it's footprint or 3d massing), but it may also have an associated location(s) of some specific point coordinate. Recurring events may not have an actual location, but may be associated with some location (at which their occurrences are likely to occur)." ;
    rdfs:range geo:Feature ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/SpatialLoc/SpatialLocOntologyProperty> .

<http://ontology.eil.utoronto.ca/icity/SpatialLoc/hasSerialization> a owl:DatatypeProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/SpatialLoc/SpatialLocOntologyDataProperty> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/Intersection> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Node> ;
            owl:onProperty [ owl:inverseOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/accessesComplex> ] ],
        <http://ontology.eil.utoronto.ca/icity/Change/Manifestation>,
        <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationComplex> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/manifestationOf> ;
                        owl:someValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/IntersectionPD> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/IntersectionPD> ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/manifestationOf> ] ) ] .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/IntersectionPD> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/NodePD> ;
            owl:onProperty [ owl:inverseOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/accessesComplex> ] ],
        <http://ontology.eil.utoronto.ca/icity/Change/TimeVaryingConcept>,
        <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationComplexPD> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/hasManifestation> ;
                        owl:someValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Intersection> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Intersection> ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/hasManifestation> ] ) ] .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/Municipality> a owl:Class ;
    rdfs:comment "An urban administrative division with jurisdiction over some area. 	We observe that the properties inMunicipality and inPlanningDistrict will likely apply to other areas of the domain (e.g. land use, building ontologies). It is likely that they will be better defined at a lower (more foundational) level within the ontology, however it is currently not clear where and how this should be done. For now, we define these properties within the Transportation Network System ontology and leave the final organization for a future iteration when the use and related concepts is more clear." ;
    rdfs:subClassOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyThing> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/NetworkPD> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass time:Interval ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/existsAt> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://ontology.eil.utoronto.ca/icity/Change/TimeVaryingConcept>,
        <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyThing> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/hasManifestation> ;
                        owl:someValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Network> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Network> ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/hasManifestation> ] ) ] .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/SignalControlPD> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Arc> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasInflow> ],
        [ a owl:Restriction ;
            owl:onClass time:Interval ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/existsAt> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Node> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/controlFor> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Arc> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasOutflow> ],
        <http://ontology.eil.utoronto.ca/icity/Change/TimeVaryingConcept>,
        <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyThing> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/hasManifestation> ;
                        owl:someValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/SignalControl> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/SignalControl> ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/hasManifestation> ] ) ] .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/endNode> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyProperty> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasControl> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyProperty> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasFreeFlowSpeed> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyProperty> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasInflow> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyProperty> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasOutflow> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyProperty> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasPostedSpeed> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyProperty> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasToll> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyProperty> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasVDF> a owl:ObjectProperty ;
    rdfs:comment "Volume delay functions (VDFs) are defined by a combination of link functional class and adjacent land uses (which can influence roadway performance). The vdf attribute, therefore does double-duty as both the VDF index for link travel time calculations and as an indicator of link functional class." ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyProperty> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/inMunicipality> a owl:ObjectProperty ;
    rdfs:comment "Parts of the transportation network such as nodes and arcs, but also various physical entities, may be associated with (by location or ownership) a Planning District." ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyProperty> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/startNode> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyProperty> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/supportsMode> a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Arc> <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Link> ) ] ;
    rdfs:range <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Mode> ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyProperty> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/vehicle_presence> a owl:NamedIndividual,
        ssn:Stimulus .

<http://ontology.eil.utoronto.ca/icity/Vehicle/VehicleOntologyDataProperty> a owl:DatatypeProperty .

<http://ontology.eil.utoronto.ca/icity/Vehicle/VehicleOntologyProperty> a owl:ObjectProperty ;
    dc:description "Added for organizational purposes, to identify all properties defined in the Vehicle ontology." .

<http://ontology.eil.utoronto.ca/icity/Vehicle/VehicleOntologyThing> a owl:Class ;
    dc:description "Added for organizational purposes, to identify all classes defined in the Vehicle ontology." ;
    rdfs:subClassOf :TransportationSystemThing .

<http://ontology.eil.utoronto.ca/icity/Vehicle/VehiclePD> a owl:Class ;
    dc:description "A Vehicle changes over time. VehiclePD captures the entire entity of a vehicle, i.e. the \"vehicle perdurant\"." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom schema1:QuantitativeValue ;
            owl:onProperty schema1:fuelEfficiency ],
        [ a owl:Restriction ;
            owl:allValuesFrom OM:Quantity ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/Vehicle/hasCargoCapacityLoad> ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema1:QuantitativeValue ;
            owl:onProperty schema1:fuelType ],
        [ a owl:Restriction ;
            owl:allValuesFrom OM:Volume ;
            owl:onProperty schema1:cargoVolume ],
        [ a owl:Restriction ;
            owl:onClass time:Interval ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/existsAt> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty schema1:numberOfAxels ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty schema1:numberOfDoors ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema1:DriveWheelConfigurationValue ;
            owl:onProperty schema1:driveWheelConfiguration ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema1:QuantitativeValue ;
            owl:onProperty schema1:mileageFromOdometer ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:DateTimeDescription ;
            owl:onProperty schema1:productionDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema1:Brand ;
            owl:onProperty schema1:brand ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty schema1:vehicleSeatingCapacity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema1:QuantitativeValue ;
            owl:onProperty schema1:fuelConsumption ],
        <http://ontology.eil.utoronto.ca/icity/Change/TimeVaryingConcept>,
        <http://ontology.eil.utoronto.ca/icity/Vehicle/VehicleOntologyThing> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/hasManifestation> ;
                        owl:someValuesFrom <http://ontology.eil.utoronto.ca/icity/Vehicle/Vehicle> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/Vehicle/Vehicle> ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/hasManifestation> ] ) ] .

dcterms:title a owl:AnnotationProperty .

<http://purl.org/vocommons/voaf#Vocabulary> a owl:Class ;
    rdfs:subClassOf <http://ontology.eil.utoronto.ca/icity/SSN/SSNThing>,
        :SSNThing .

terms1:Agency a owl:Class ;
    rdfs:label "Agency"@en,
        "Empresa"@es ;
    rdfs:comment "An agency operates a certain schedule based transport mode"@en,
        "Una empresa opera un cierto modo de transporte de manera programada"@es ;
    rdfs:seeAlso <https://developers.google.com/transit/gtfs/reference#agency_fields> ;
    rdfs:subClassOf foaf:Agent ;
    ns3:term_status "stable"@en,
        "estable"@es .

terms1:FareClass a owl:Class ;
    rdfs:label "Fare Class"@en,
        "Clase tarifaria"@es ;
    terms1:comment "A gtfs:FareClass corresponds to a row in the fare_attributes.txt file."@en,
        "Una gtfs:FareClass corresponde a una lÃ­nea en fare_attributes.txt."@es ;
    rdfs:comment "A class describing how the fare is calculated."@en,
        "Describe como se calcula la tarifa."@es ;
    rdfs:seeAlso <https://code.google.com/p/googletransitdatafeed/wiki/FareExamples>,
        <https://developers.google.com/transit/gtfs/reference#fare_attributes_fields>,
        <https://developers.google.com/transit/gtfs/reference#fare_rules_fields> ;
    rdfs:subClassOf schema1:PriceSpecification ;
    ns3:term_status "unstable"@en,
        "inestable"@es .

terms1:Service a owl:Class ;
    rdfs:label "Service"@en,
        "Servicio"@es ;
    terms1:comment "A gtfs:Service is a set of gtfs:ServiceRules which can be found in both calendar.txt as calendar_dates.txt"@en,
        "Un gtfs:Service es un conjunto de gtfs:ServiceRules que pueden ser encontradas en calendar.txt y calendar_dates.txt"@es ;
    rdfs:comment "A gtfs:Service identifies a set of dates when a service is available for one or more routes"@en,
        "Un gtfs:Service indica el conjunto de fechas en el que el servicio estÃ¡ disponible para una o mÃ¡s rutas"@es ;
    rdfs:seeAlso <https://developers.google.com/transit/gtfs/reference#calendar_dates_fields>,
        <https://developers.google.com/transit/gtfs/reference#calendar_fields> ;
    rdfs:subClassOf :gtfsThing ;
    ns3:term_status "unstable"@en,
        "inestable"@es .

terms1:ShapePoint a owl:Class ;
    rdfs:label "Shape Point"@en,
        "Punto de recorrido"@es ;
    rdfs:comment "A geographic point within a gtfs:Shape"@en,
        "Punto geogrÃ¡fico dentro de un recorrido (gtfs:Shape)"@es ;
    rdfs:seeAlso <https://developers.google.com/transit/gtfs/reference#shapes_fields> ;
    rdfs:subClassOf :gtfsThing ;
    ns3:term_status "unstable"@en,
        "inestable"@es .

terms1:Station a owl:Class ;
    rdfs:label "Station"@en,
        "EstaciÃ³n"@es ;
    terms1:comment "Map a row in stops.txt to gtfs:Station when the location_type is 1."@en,
        "Mapee una lÃ­nea en stops.txt a gtfs:Station cuando location_type sea 1."@es ;
    rdfs:comment "A physical structure or area that contains one or more stop."@en,
        "Estructura fÃ­sica o Ã¡rea que contiene una o mÃ¡s paradas."@es ;
    rdfs:seeAlso <https://developers.google.com/transit/gtfs/reference#stops_fields> ;
    rdfs:subClassOf :gtfsThing ;
    ns3:term_status "unstable"@en,
        "inestable"@es .

<http://www.opengis.net/def/uom/ISO-8601/0/Gregorian> a owl:NamedIndividual .

xsd:date a rdfs:Datatype .

xsd:dateTimeStamp rdfs:label "sello de tiempo"@es .

xsd:gYearMonth a rdfs:Datatype .

time:DurationDescription a owl:Class ;
    rdfs:label "Duration description"@en,
        "descripción de duración"@es ;
    rdfs:comment "Description of temporal extent structured with separate values for the various elements of a calendar-clock system. The temporal reference system is fixed to Gregorian Calendar, and the range of each of the numeric properties is restricted to xsd:decimal"@en,
        "Descripción de extensión temporal estructurada con valores separados para los distintos elementos de un sistema de horario-calendario. El sistema de referencia temporal se fija al calendario gregoriano, y el intervalo de cada una de las propiedades numéricas se restringe a xsd:decimal."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty time:seconds ],
        [ a owl:Restriction ;
            owl:hasValue <http://www.opengis.net/def/uom/ISO-8601/0/Gregorian> ;
            owl:onProperty time:hasTRS ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty time:hours ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty time:minutes ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty time:months ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty time:years ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty time:weeks ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty time:days ],
        time:GeneralDurationDescription ;
    skos:definition "Description of temporal extent structured with separate values for the various elements of a calendar-clock system. The temporal reference system is fixed to Gregorian Calendar, and the range of each of the numeric properties is restricted to xsd:decimal"@en,
        "Descripción de extensión temporal estructurada con valores separados para los distintos elementos de un sistema de horario-calendario. El sistema de referencia temporal se fija al calendario gregoriano, y el intervalo de cada una de las propiedades numéricas se restringe a xsd:decimal."@es ;
    skos:note "In the Gregorian calendar the length of the month is not fixed. Therefore, a value like \"2.5 months\" cannot be exactly compared with a similar duration expressed in terms of weeks or days."@en,
        "En el calendario gregoriano la longitud de los meses no es fija. Por lo tanto, un valor como \"2,5 meses\" no se puede comparar exactamente con una duración similar expresada en términos de semanas o días."@es .

time:MonthOfYear a owl:Class ;
    rdfs:label "Month of year"@en,
        "mes del año"@es ;
    rdfs:comment "The month of the year"@en,
        "El mes del año."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty time:minute ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty time:second ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:month ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty time:week ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty time:hour ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty time:day ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty time:year ],
        [ a owl:Restriction ;
            owl:hasValue time:unitMonth ;
            owl:onProperty time:unitType ],
        time:DateTimeDescription ;
    skos:definition "The month of the year"@en,
        "El mes del año."@es ;
    skos:editorialNote "Feature at risk - added in 2017 revision, and not yet widely used. "@en,
        "Característica en riesgo - añadida en la revisión de 2017, y no utilizada todavía de forma amplia."@es ;
    skos:note "Membership of the class :MonthOfYear is open, to allow for alternative annual calendars and different month names."@en,
        "La pertenencia a la clase 'mes del año' está abierta, a permitir calendarios anuales alternativos y diferentes nombres de meses."@es .

time:TimeZone a owl:Class ;
    rdfs:label "Time Zone"@en,
        "huso horario"@es ;
    rdfs:comment """A Time Zone specifies the amount by which the local time is offset from UTC. 
	A time zone is usually denoted geographically (e.g. Australian Eastern Daylight Time), with a constant value in a given region. 
The region where it applies and the offset from UTC are specified by a locally recognised governing authority."""@en,
        """Un huso horario especifica la cantidad en que la hora local está desplazada con respecto a UTC.
        Un huso horario normalmente se denota geográficamente (p.ej. el horario de verano del este de Australia), con un valor constante en una región dada.
        La región donde aplica y el desplazamiento desde UTC las especifica una autoridad gubernamental localmente reconocida."""@es ;
    rdfs:subClassOf <http://ontology.eil.utoronto.ca/5087/1/Time/TimeOntologyThing>,
        <http://ontology.eil.utoronto.ca/icity/Time/TimeOntologyThing> ;
    skos:definition """A Time Zone specifies the amount by which the local time is offset from UTC. 
	A time zone is usually denoted geographically (e.g. Australian Eastern Daylight Time), with a constant value in a given region. 
The region where it applies and the offset from UTC are specified by a locally recognised governing authority."""@en,
        """Un huso horario especifica la cantidad en que la hora local está desplazada con respecto a UTC.
    Un huso horario normalmente se denota geográficamente (p.ej. el horario de verano del este de Australia), con un valor constante en una región dada.
    La región donde aplica y el desplazamiento desde UTC las especifica una autoridad gubernamental localmente reconocida."""@es ;
    skos:historyNote """In the original 2006 version of OWL-Time, the TimeZone class, with several properties corresponding to a specific model of time-zones, was defined in a separate namespace "http://www.w3.org/2006/timezone#". 

In the current version a class with same local name is put into the main OWL-Time namespace, removing the dependency on the external namespace. 

An alignment axiom 
	tzont:TimeZone rdfs:subClassOf time:TimeZone . 
allows data encoded according to the previous version to be consistent with the updated ontology. """,
        """En la versión original de OWL-Time de 2006, se definió, en un espacio de nombres diferente "http://www.w3.org/2006/timezone#", la clase 'huso horario', con varias propiedades específicas correspondientes a un modelo específico de huso horario.
    En la versión actual hay una clase con el mismo nombre local en el espacio de nombres de OWL-Time, eliminando la dependencia del espacio de nombres externo.
    Un axioma de alineación permite que los datos codificados de acuerdo con la versión anterior sean consistentes con la ontología actualizada."""@es ;
    skos:note """A designated timezone is associated with a geographic region. However, for a particular region the offset from UTC often varies seasonally, and the dates of the changes may vary from year to year. The timezone designation usually changes for the different seasons (e.g. Australian Eastern Standard Time vs. Australian Eastern Daylight Time). Furthermore, the offset for a timezone may change over longer timescales, though its designation might not.  

Detailed guidance about working with time zones is given in http://www.w3.org/TR/timezone/ ."""@en,
        "An ontology for time zone descriptions was described in [owl-time-20060927] and provided as RDF in a separate namespace tzont:. However, that ontology was incomplete in scope, and the example datasets were selective. Furthermore, since the use of a class from an external ontology as the range of an ObjectProperty in OWL-Time creates a dependency, reference to the time zone class has been replaced with the 'stub' class in the normative part of this version of OWL-Time."@en,
        """Un huso horario designado está asociado con una región geográfica. Sin embargo, para una región particular el desplazamiento desde UTC a menudo varía según las estaciones, y las fechas de los cambios pueden variar de un año a otro. La designación de huso horario  normalmente cambia de una estación a otra (por ejemplo, el horario estándar frente al horario de verano ambos del este de Australia). Además, del desplazamiento para un huso horario puede cambiar sobre escalas de tiempo mayores, aunque su designación no lo haga.
    Se puede encontrar una guía detallada sobre el funcionamiento de husos horarios en http://www.w3.org/TR/timezone/."@es , "En [owl-time-20060927] se describió una ontología para descripciones de husos horarios, y se proporcionó en un espacio de nombres separado tzont:. Sin embargo, dicha ontología estaba incompleta en su alcance, y el ejemplo de conjuntos de datos (datasets) era selectivo. Además, puesto que el uso de una clase de una ontología externa como el rango de una propiedad de objeto en OWL-Time crea una dependencia, la referencia a la clase huso horario se ha reemplazado por una clase que viene a ser un "cajón de sastre" en la en la parte normativa de esta versión de OWL-Time."""@es ;
    skos:scopeNote "In this implementation TimeZone has no properties defined. It should be thought of as an 'abstract' superclass of all specific timezone implementations.",
        "En esta implementación 'huso horario' no tiene definidas propiedades. Se debería pensar como una superclase \"abstracta\" de todas las implementaciones de huso horario específicas."@es .

time:after a owl:ObjectProperty ;
    rdfs:label "after"@en,
        "después"@es ;
    rdfs:comment "Gives directionality to time. If a temporal entity T1 is after another temporal entity T2, then the beginning of T1 is after the end of T2."@en,
        "Asume una dirección en el tiempo. Si una entidad temporal T1 está después de otra entidad temporal T2, entonces el principio de T1 está después del final de T2."@es ;
    rdfs:domain time:TemporalEntity ;
    rdfs:range time:TemporalEntity ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/5087/1/Time/TimeOntologyProperty> ;
    owl:inverseOf time:before ;
    skos:definition "Gives directionality to time. If a temporal entity T1 is after another temporal entity T2, then the beginning of T1 is after the end of T2."@en,
        "Asume una dirección en el tiempo. Si una entidad temporal T1 está después de otra entidad temporal T2, entonces el principio de T1 está después del final de T2."@es .

time:dayOfWeek a owl:ObjectProperty ;
    rdfs:label "day of week"@en,
        "día de la semana"@es ;
    rdfs:comment "El día de la semana, cuyo valor es un miembro de la clase 'día de la semana'.",
        "The day of week, whose value is a member of the class time:DayOfWeek"@en ;
    rdfs:domain time:GeneralDateTimeDescription ;
    rdfs:range time:DayOfWeek ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/5087/1/Time/TimeOntologyProperty> ;
    skos:definition "The day of week, whose value is a member of the class time:DayOfWeek"@en,
        "El día de la semana, cuyo valor es un miembro de la clase 'día de la semana'."@es .

time:hasTime a owl:ObjectProperty ;
    rdfs:label "has time"@en,
        "tiene tiempo"@es ;
    rdfs:comment "Supports the association of a temporal entity (instant or interval) to any thing"@en,
        "Proporciona soporte a la asociación de una entidad temporal (instante o intervalo) a cualquier cosa."@es ;
    rdfs:range time:TemporalEntity ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/5087/1/Time/TimeOntologyProperty>,
        <http://ontology.eil.utoronto.ca/icity/Time/TimeOntologyProperty> ;
    skos:definition "Supports the association of a temporal entity (instant or interval) to any thing"@en,
        "Proporciona soporte a la asociación de una entidad temporal (instante o intervalo) a cualquier cosa."@es ;
    skos:editorialNote "Feature at risk - added in 2017 revision, and not yet widely used. "@en,
        "Característica arriesgada -añadida en la revisión del 2017 que no ha sido todavía utilizada de forma amplia."@es .

time:hour a owl:DatatypeProperty ;
    rdfs:label "hour"@en,
        "hora"@es ;
    rdfs:comment "Hour position in a calendar-clock system."@en,
        "Posición de hora en un sistema calendario-reloj."@es ;
    rdfs:domain time:GeneralDateTimeDescription ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/5087/1/Time/TimeOntologyDataProperty> ;
    skos:definition "Hour position in a calendar-clock system."@en,
        "Posición de hora en un sistema calendario-reloj."@es .

time:intervalBefore a owl:ObjectProperty ;
    rdfs:label "interval before"@en,
        "intervalo anterior"@es ;
    rdfs:comment "If a proper interval T1 is intervalBefore another proper interval T2, then the end of T1 is before the beginning of T2."@en,
        "Si un intervalo propio T1 está antes que otro intervalo propio T2, entonces el final de T1 está antes que el principio de T2."@es ;
    rdfs:domain time:ProperInterval ;
    rdfs:range time:ProperInterval ;
    rdfs:subPropertyOf time:before,
        time:intervalDisjoint ;
    skos:definition "If a proper interval T1 is intervalBefore another proper interval T2, then the end of T1 is before the beginning of T2."@en,
        "Si un intervalo propio T1 está antes que otro intervalo propio T2, entonces el final de T1 está antes que el principio de T2."@es .

time:intervalDuring a owl:ObjectProperty ;
    rdfs:label "interval during"@en,
        "intervalo durante"@es ;
    rdfs:comment "If a proper interval T1 is intervalDuring another proper interval T2, then the beginning of T1 is after the beginning of T2, and the end of T1 is before the end of T2."@en,
        "Si un intervalo propio T1 está durante otro intervalo propio T2, entonces del principio de T1 está después del principio de T2, y el final de T1 está antes que el final de T2."@es ;
    rdfs:domain time:ProperInterval ;
    rdfs:range time:ProperInterval ;
    rdfs:subPropertyOf time:intervalIn ;
    skos:definition "If a proper interval T1 is intervalDuring another proper interval T2, then the beginning of T1 is after the beginning of T2, and the end of T1 is before the end of T2."@en,
        "Si un intervalo propio T1 está durante otro intervalo propio T2, entonces del principio de T1 está después del principio de T2, y el final de T1 está antes que el final de T2."@es .

time:intervalFinishes a owl:ObjectProperty ;
    rdfs:label "interval finishes"@en,
        "intervalo termina"@es ;
    rdfs:comment "If a proper interval T1 is intervalFinishes another proper interval T2, then the beginning of T1 is after the beginning of T2, and the end of T1 is coincident with the end of T2."@en,
        "Si un intervalo propio T1 termina otro intervalo propio T2, entonces del principio de T1 está después del principio de T2, y el final de T1 coincide con el final de T2."@es ;
    rdfs:domain time:ProperInterval ;
    rdfs:range time:ProperInterval ;
    rdfs:subPropertyOf time:intervalIn ;
    skos:definition "If a proper interval T1 is intervalFinishes another proper interval T2, then the beginning of T1 is after the beginning of T2, and the end of T1 is coincident with the end of T2."@en,
        "Si un intervalo propio T1 termina otro intervalo propio T2, entonces del principio de T1 está después del principio de T2, y el final de T1 coincide con el final de T2."@es .

time:intervalMetBy a owl:ObjectProperty ;
    rdfs:label "interval met by"@en,
        "intervalo encontrado por"@es ;
    rdfs:comment "If a proper interval T1 is intervalMetBy another proper interval T2, then the beginning of T1 is coincident with the end of T2."@en,
        "Si un intervalo propio T1 es 'intervalo encontrado por' otro intervalo propio T2, entonces el principio de T1 coincide con el final de T2."@es ;
    rdfs:domain time:ProperInterval ;
    rdfs:range time:ProperInterval ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/5087/1/Time/TimeOntologyProperty> ;
    skos:definition "If a proper interval T1 is intervalMetBy another proper interval T2, then the beginning of T1 is coincident with the end of T2."@en,
        "Si un intervalo propio T1 es 'intervalo encontrado por' otro intervalo propio T2, entonces el principio de T1 coincide con el final de T2."@es .

time:intervalOverlaps a owl:ObjectProperty ;
    rdfs:label "interval overlaps"@en,
        "intervalo se solapa"@es ;
    rdfs:comment "If a proper interval T1 is intervalOverlaps another proper interval T2, then the beginning of T1 is before the beginning of T2, the end of T1 is after the beginning of T2, and the end of T1 is before the end of T2."@en,
        "Asume una dirección en el tiempo. Si una entidad temporal T1 está después de otra entidad temporal T2, entonces el principio de T1 está después del final de T2."@es,
        "Si un intervalo propio T1 se solapa con otro intervalo propio T2, entonces el principio de T1 es anterior al principio de T2, el final de T1 es posterior al principio de T2, y el final de T1 es anterior al final de T2."@es ;
    rdfs:domain time:ProperInterval ;
    rdfs:range time:ProperInterval ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/5087/1/Time/TimeOntologyProperty> ;
    skos:definition "If a proper interval T1 is intervalOverlaps another proper interval T2, then the beginning of T1 is before the beginning of T2, the end of T1 is after the beginning of T2, and the end of T1 is before the end of T2."@en,
        "Si un intervalo propio T1 se solapa con otro intervalo propio T2, entonces el principio de T1 es anterior al principio de T2, el final de T1 es posterior al principio de T2, y el final de T1 es anterior al final de T2."@es .

time:intervalStarts a owl:ObjectProperty ;
    rdfs:label "interval starts"@en,
        "intervalo empieza"@es ;
    rdfs:comment "If a proper interval T1 is intervalStarts another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is before the end of T2."@en,
        "Si un intervalo propio T1 empieza otro intervalo propio T2, entonces del principio de T1 con el principio de T2, y el final de T1 es anterior al final de T2."@es ;
    rdfs:domain time:ProperInterval ;
    rdfs:range time:ProperInterval ;
    rdfs:subPropertyOf time:intervalIn ;
    skos:definition "If a proper interval T1 is intervalStarts another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is before the end of T2."@en,
        "Si un intervalo propio T1 empieza otro intervalo propio T2, entonces del principio de T1 con el final de T2, y el final de T1 es anterior al final de T2."@es .

time:minute a owl:DatatypeProperty ;
    rdfs:label "minute"@en,
        "minuto"@es ;
    rdfs:comment "Minute position in a calendar-clock system."@en,
        "Posición de minuto en un sistema calendario-reloj."@es ;
    rdfs:domain time:GeneralDateTimeDescription ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/5087/1/Time/TimeOntologyDataProperty> ;
    skos:definition "Minute position in a calendar-clock system."@en,
        "Posición de minuto en un sistema calendario-reloj."@es .

time:monthOfYear a owl:ObjectProperty ;
    rdfs:label "month of year"@en,
        "mes del año"@es ;
    rdfs:comment "The month of the year, whose value is a member of the class time:MonthOfYear"@en,
        "El mes del año, cuyo valor es un miembro de la clase 'mes del año'."@es ;
    rdfs:domain time:GeneralDateTimeDescription ;
    rdfs:range time:MonthOfYear ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/5087/1/Time/TimeOntologyProperty>,
        <http://ontology.eil.utoronto.ca/icity/Time/TimeOntologyProperty> ;
    skos:definition "The month of the year, whose value is a member of the class time:MonthOfYear"@en,
        "El mes del año, cuyo valor es un miembro de la clase 'mes del año'."@es ;
    skos:editorialNote "Feature at risk - added in 2017 revision, and not yet widely used. "@en,
        "Característica arriesgada - añadida en la revisión de 2017, y todavía no ampliamente utilizada."@es .

time:timeZone a owl:ObjectProperty ;
    rdfs:label "in time zone"@en,
        "en huso horario"@es ;
    rdfs:comment "The time zone for clock elements in the temporal position"@en ;
    rdfs:domain time:GeneralDateTimeDescription ;
    rdfs:range time:TimeZone ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/5087/1/Time/TimeOntologyProperty> ;
    skos:historyNote """In the original 2006 version of OWL-Time, the range of time:timeZone was a TimeZone class in a separate namespace "http://www.w3.org/2006/timezone#". 
An alignment axiom 
	tzont:TimeZone rdfs:subClassOf time:TimeZone . 
allows data encoded according to the previous version to be consistent with the updated ontology. """,
        """En la versión original de OWL-Time de 2006, el rango de 'en huso horario' se definió en un espacio de nombres diferente "http://www.w3.org/2006/timezone#".
            Un axioma de alineación permite que los datos codificados de acuerdo con la versión anterior sean consistentes con la ontología actualizada."""@es ;
    skos:note """IANA maintains a database of timezones. These are well maintained and generally considered authoritative, but individual items are not available at individual URIs, so cannot be used directly in data expressed using OWL-Time.

DBPedia provides a set of resources corresponding to the IANA timezones, with a URI for each (e.g. http://dbpedia.org/resource/Australia/Eucla). The World Clock service also provides a list of time zones with the description of each available as an individual webpage with a convenient individual URI (e.g. https://www.timeanddate.com/time/zones/acwst). These or other, similar, resources might be used as a value of the time:timeZone property.""",
        """IANA mantiene una base de datos de husos horarios. Éstas están bien mantenidas y generalmente se consideran autorizadas, pero los ítems individuales no están disponibles en URIs individuales, por tanto, no se pueden utilizar directamente en datos expresados utilizando OWL-Time.
            La BDPedia proporciona un conjunto de recursos correspondientes a los husos horarios de IANA, con una URI para cada uno (por ejemplo, http://dbpedia.org/resource/Australia/Eucla). El Servicio de Reloj Mundial también proporciona una lista de husos horarios con la descripción de cada uno de los disponibles como una página Web individual con una URI adecuada individual (por ejemplo, https://www.timeanddate.com/time/zones/acwst). Éstos, y otros recursos similares, se puden usar como un valor de la propiedad 'huso horario'."""@es .

time:unitMonth a owl:NamedIndividual,
        time:TemporalUnit ;
    rdfs:label "Month (unit of temporal duration)"@en ;
    skos:prefLabel "شهر واحد"@ar,
        "Monat"@de,
        "monat"@de,
        "month"@en,
        "mes"@es,
        "mois"@fr,
        "mese"@it,
        "一か月"@jp,
        "한달"@kr,
        "maand"@nl,
        "miesiąc"@pl,
        "один месяц"@ru,
        "一個月"@zh ;
    time:days 0.0 ;
    time:hours 0.0 ;
    time:minutes 0.0 ;
    time:months 1.0 ;
    time:seconds 0.0 ;
    time:weeks 0.0 ;
    time:years 0.0 .

sosa:actsOnProperty a owl:ObjectProperty ;
    rdfs:label "acts on property"@en ;
    schema1:domainIncludes sosa:Actuation ;
    schema1:rangeIncludes sosa:ActuatableProperty ;
    rdfs:comment "Relation between an Actuation and the property of a FeatureOfInterest it is acting upon."@en ;
    rdfs:isDefinedBy sosa: ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/SSN/ssnObjectProperty> ;
    owl:inverseOf sosa:isActedOnBy ;
    skos:definition "Relation between an Actuation and the property of a FeatureOfInterest it is acting upon."@en ;
    skos:example "In the activity (Actuation) of automatically closing a window if the temperature in a room drops below 20 degrees Celsius, the property on which the Actuator acts upon is the state of the window as it changes from being open to being closed. "@en .

sosa:isActedOnBy a owl:ObjectProperty ;
    rdfs:label "is acted on by"@en ;
    schema1:domainIncludes sosa:ActuatableProperty ;
    schema1:rangeIncludes sosa:Actuation ;
    rdfs:comment "Relation between an ActuatableProperty of a FeatureOfInterest and an Actuation changing its state."@en ;
    rdfs:isDefinedBy sosa: ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/SSN/ssnObjectProperty> ;
    skos:definition "Relation between an ActuatableProperty of a FeatureOfInterest and an Actuation changing its state."@en ;
    skos:example "In the activity (Actuation) of automatically closing a window if the temperature in a room drops below 20 degrees Celsius, the property on which the Actuator acts upon is the state of the window as it changes from being open to being closed. "@en .

sosa:isHostedBy a owl:ObjectProperty ;
    rdfs:label "is hosted by"@en ;
    schema1:domainIncludes sosa:Actuator,
        sosa:Platform,
        sosa:Sampler,
        sosa:Sensor ;
    schema1:rangeIncludes sosa:Platform ;
    rdfs:comment "Relation between a Sensor, Actuator, Sampler, or Platform, and the Platform that it is mounted on or hosted by."@en ;
    rdfs:isDefinedBy sosa: ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/SSN/ssnObjectProperty> ;
    skos:definition "Relation between a Sensor, Actuator, Sampler, or Platform, and the Platform that it is mounted on or hosted by."@en .

sosa:madeSampling a owl:ObjectProperty ;
    rdfs:label "made sampling"@en ;
    schema1:domainIncludes sosa:Sampler ;
    schema1:rangeIncludes sosa:Sampling ;
    rdfs:comment "Relation between a Sampler (sampling device or entity) and the Sampling act it performed."@en ;
    rdfs:isDefinedBy sosa: ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/SSN/ssnObjectProperty> ;
    skos:definition "Relation between a Sampler (sampling device or entity) and the Sampling act it performed."@en .

ssn:Deployment a owl:Class ;
    rdfs:label "Deployment"@en ;
    rdfs:comment "Describes the Deployment of one or more Systems for a particular purpose. Deployment may be done on a Platform."@en ;
    rdfs:isDefinedBy ssn: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sosa:Platform ;
            owl:onProperty ssn:deployedOnPlatform ],
        [ a owl:Restriction ;
            owl:allValuesFrom ssn:System ;
            owl:onProperty ssn:deployedSystem ],
        [ a owl:Restriction ;
            owl:allValuesFrom ssn:Property ;
            owl:onProperty ssn:forProperty ],
        <http://ontology.eil.utoronto.ca/icity/SSN/SSNThing>,
        :SSNThing ;
    skos:definition "Describes the Deployment of one or more Systems for a particular purpose. Deployment may be done on a Platform."@en ;
    skos:example "For example, a temperature Sensor deployed on a wall, or a whole network of Sensors deployed for an Observation campaign."@en .

ssn:deployedSystem a owl:ObjectProperty ;
    rdfs:label "deployed system"@en ;
    rdfs:comment "Relation between a Deployment and a deployed System."@en ;
    rdfs:isDefinedBy ssn: ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/SSN/ssnObjectProperty> ;
    owl:inverseOf ssn:hasDeployment ;
    skos:definition "Relation between a Deployment and a deployed System."@en .

ssn:hasDeployment a owl:ObjectProperty ;
    rdfs:label "has deployment"@en ;
    rdfs:comment "Relation between a System and a Deployment, recording that the System is deployed in that Deployment."@en ;
    rdfs:isDefinedBy ssn: ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/SSN/ssnObjectProperty> ;
    skos:definition "Relation between a System and a Deployment, recording that the System is deployed in that Deployment."@en .

ssn:hasProperty a owl:ObjectProperty ;
    rdfs:label "has property"@en ;
    rdfs:comment "Relation between an entity and a Property of that entity."@en ;
    rdfs:isDefinedBy ssn: ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/SSN/ssnObjectProperty> ;
    owl:inverseOf ssn:isPropertyOf ;
    skos:definition "Relation between an entity and a Property of that entity."@en .

ssn:hasSubSystem a owl:ObjectProperty ;
    rdfs:label "has subsystem"@en ;
    rdfs:comment "Relation between a System and its component parts."@en ;
    rdfs:isDefinedBy ssn: ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/SSN/ssnObjectProperty> ;
    skos:definition "Relation between a System and its component parts."@en .

ssn:isPropertyOf a owl:ObjectProperty ;
    rdfs:label "is property of"@en ;
    rdfs:comment "Relation between a Property and the entity it belongs to."@en ;
    rdfs:isDefinedBy ssn: ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/SSN/ssnObjectProperty> ;
    skos:definition "Relation between a Property and the entity it belongs to."@en .

ssn:isProxyFor a owl:ObjectProperty ;
    rdfs:label "is proxy for"@en ;
    rdfs:comment "A relation from a Stimulus to the Property that the Stimulus is serving as a proxy for."@en ;
    rdfs:isDefinedBy ssn: ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/SSN/ssnObjectProperty> ;
    skos:definition "A relation from a Stimulus to the Property that the Stimulus is serving as a proxy for."@en ;
    skos:example "For example, the expansion of quicksilver is a stimulus that serves as a proxy for some temperature property. An increase or decrease in the velocity of spinning cups on a wind sensor is serving as a proxy for the wind speed."@en .

:Car a owl:Class ;
    rdfs:subClassOf :LandVehicle .

:Geometry a owl:Class ;
    rdfs:comment "Geometry refers to the spatial dimensions and shape of assets or infrastructure components. It provides a mathematical description of objects in space, which is essential for visualizing and modeling assets in the digital twin." .

:MaterialProperty a owl:Class ;
    rdfs:comment "MaterialProperty encompasses the physical and chemical properties of the materials used in constructing assets and infrastructure. This includes characteristics like strength, durability, and weight, important for maintenance and operational decisions." .

:Railway a owl:Class ;
    rdfs:subClassOf :TransportationInfrastructure .

:Sachverhalt a owl:Class ;
    rdfs:subClassOf :BridgeInfrastructure .

:Sensor a owl:Class ;
    owl:equivalentClass ssn:System .

:Time a owl:Class ;
    rdfs:comment "Time is a fundamental concept representing the temporal aspects related to assets and infrastructure. This includes timestamps for events such as inspections, repairs, and the operational lifespan of vehicles or structures." .

:Watercraft a owl:Class ;
    rdfs:subClassOf :Vehicle .

