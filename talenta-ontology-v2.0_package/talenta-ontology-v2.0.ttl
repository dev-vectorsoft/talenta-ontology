            owl:allValuesFrom OM:Unit ;
            owl:onProperty OM:hasUnit ],
        OM:OMThing .

OM:Speed a owl:Class ;
    rdfs:label "speed" ;
    rdfs:comment "Speed is the time rate of motion measured by the distance moved over in unit time." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom OM:SpeedUnit ;
                    owl:onProperty OM:hasUnit ] ;
            owl:onProperty OM:hasValue ],
        OM:Quantity .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/Network> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Arc> <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Node> ) ] ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasNetworkComponent> ],
        [ a owl:Restriction ;
            owl:onClass time:TemporalEntity ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/existsAt> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://ontology.eil.utoronto.ca/icity/Change/Manifestation>,
