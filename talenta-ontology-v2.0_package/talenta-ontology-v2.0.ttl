time:ProperInterval a owl:Class ;
    rdfs:label "Proper interval"@en,
        "intervalo propio"@es ;
    rdfs:comment "A temporal entity with non-zero extent or duration, i.e. for which the value of the beginning and end are different"@en,
        "Una entidad temporal con extensión o duración distinta de cero, es decir, para la cual los valores de principio y fin del intervalo son diferentes."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom time:ProperInterval ;
            owl:onProperty time:intervalStarts ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:ProperInterval ;
            owl:onProperty time:intervalFinishes ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:ProperInterval ;
            owl:onProperty time:intervalOverlappedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:ProperInterval ;
            owl:onProperty time:intervalAfter ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:ProperInterval ;
            owl:onProperty time:intervalDuring ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:ProperInterval ;
            owl:onProperty time:intervalContains ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:ProperInterval ;
            owl:onProperty time:intervalMeets ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:ProperInterval ;
            owl:onProperty time:intervalMetBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:ProperInterval ;
            owl:onProperty time:intervalBefore ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:ProperInterval ;
            owl:onProperty time:intervalIn ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:ProperInterval ;
            owl:onProperty time:intervalFinishedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:ProperInterval ;
            owl:onProperty time:intervalOverlaps ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:ProperInterval ;
            owl:onProperty time:intervalStartedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:ProperInterval ;
            owl:onProperty time:intervalEquals ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:ProperInterval ;
            owl:onProperty time:intervalDisjoint ],
        time:Interval ;
    skos:definition "A temporal entity with non-zero extent or duration, i.e. for which the value of the beginning and end are different"@en,
        "Una entidad temporal con extensión o duración distinta de cero, es decir, para la cual los valores de principio y fin del intervalo son diferentes."@es .

