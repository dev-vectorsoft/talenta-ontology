<https://standards.iso.org/iso-iec/5087/-1/ed-1/en/ontology/GenericProperties/genericDataProperty> a owl:DatatypeProperty .

<https://wisib.de/ontologie/abox/germanroadbridge/d1#GermanCompany> a ontology:Organisation,
        owl:NamedIndividual ;
    rdfs:label "GermanCompany"@de ;
    rdfs:comment "GermanCompany"@de .

bmat:NaturalStone a owl:Class ;
    rdfs:label "Natural stone"@en ;
    rdfs:comment "Building material made of stone, as found in nature, as long as it is regarded or acquired as an economic good."@en ;
    rdfs:subClassOf bmat:BuildingMaterial .

bmat:hasBuildingMaterial a owl:ObjectProperty ;
    rdfs:label "hat Baumaterial"@de,
        "has building material"@en ;
    rdfs:comment "Relationship between a construction component and a BuildingMaterial."@en ;
    rdfs:range bmat:BuildingMaterial ;
    owl:propertyChainAxiom ( brot:containsComponent bmat:hasBuildingMaterial ),
        ( brot:aggregates bmat:hasBuildingMaterial ) .

brcomp:Foundation a owl:Class ;
    rdfs:label "Gruendungselement einer Bruecke"@de,
        "Foundation"@en ;
    rdfs:comment "Component for the foundation of abutments and central supports and the transfer of bridge loads."@en ;
    rdfs:subClassOf brcomp:SubStructureComponent .

brcomp:Pier a owl:Class ;
    rdfs:label "Pfeiler"@de,
        "Pier"@en ;
    rdfs:comment "Components that support the ends of spans between these abutments."@en ;
    rdfs:subClassOf brcomp:SubStructureComponent .

brot:Joint a owl:Class ;
    rdfs:subClassOf :BridgeInfrastructure .

brstr:LoadBearingComponent a owl:Class ;
    rdfs:label "Load-bearing element"@en ;
    rdfs:comment "Component that takes loads."@en ;
    rdfs:subClassOf brot:Component .

brstr:Span a owl:Class ;
    rdfs:label "Bridge span"@en ;
    rdfs:comment "Distance between two intermediate piers for a bridge."@en ;
    rdfs:subClassOf brot:SpatialZone .

brstr:StructuralAssessmentSTANAG2021 a owl:Class ;
    rdfs:label "Structural assessment STANAG2021"@en ;
    rdfs:comment "Structural assessment according to the German standard STANAG2021"@en ;
    rdfs:subClassOf brstr:StructuralAssessment .

brstr:movement a owl:DatatypeProperty ;
    rdfs:label "movement"@en ;
    rdfs:comment "Defines at which extend a LoadBearingComponent can move"@en ;
    rdfs:subPropertyOf brstr:degreeOfFreedom .

brstr:rotation a owl:DatatypeProperty ;
    rdfs:label "rotation"@en ;
    rdfs:comment "Defines at which extend a LoadBearingComponent can rotate"@en ;
    rdfs:subPropertyOf brstr:degreeOfFreedom .

<http://dbpedia.org/page/Orientation_(geometry)> a owl:Class ;
    rdfs:subClassOf :BridgeInfrastructure .

<http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Cardinality_unit> a owl:Class ;
    rdfs:label "Cardinality Unit" ;
    rdfs:comment "Just as the meter is the unit of measure for length, a gci:Cardinality_unit is the unit of measure for the size of a set. The gci:Cardinality_unit is a ratio scale: gci:Cardinality_scale, which is a subclass of om:Ratio_scale and is has a zero element (namely zero).",
        "Reused from GCI Foundation Ontology" ;
    rdfs:subClassOf OM:Unit .

<http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#defined_by> a owl:ObjectProperty ;
    rdfs:subPropertyOf om-1:OMProperty .

iso21972:Prefix a owl:Class ;
    rdfs:label "prefix"@en ;
    rdfs:comment "A prefix is a name that precedes a basic unit of measure to indicate a decimal multiple or fraction of the unit. Each prefix has a unique symbol that is prepended to the unit symbol. For example, an electric current of 0.000 000 001 ampere is written by using the SI-prefix nano as 1 nanoampere or 1 nA."@en ;
    rdfs:subClassOf iso21972:ISO21972Thing ;
    owl:disjointUnionOf ( iso21972:Binary_prefix iso21972:SI_prefix ) .

iso21972:Sample a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass iso21972:Population ;
            owl:onProperty iso21972:is_part_of ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso21972:Observation ;
            owl:onProperty iso21972:is_composed_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso21972:Statistic ;
            owl:onProperty iso21972:is_described_by ],
        iso21972:ISO21972Thing .

iso21972:System_of_units a owl:Class ;
    rdfs:subClassOf iso21972:ISO21972Thing ;
    owl:equivalentClass OM:System_of_units .

iso21972:unit_of_measure a owl:ObjectProperty ;
    rdfs:label "unit of measure"@en ;
    rdfs:comment "For quantity classes this property indicates a commonly-used unit." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( iso21972:Application_area iso21972:Cardinal_scale iso21972:Quantity ) ] ;
    rdfs:range iso21972:Unit_of_measure ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty ;
    om-1:alternative_label "has unit of measure"@en .

<http://ontology.eil.utoronto.ca/icity/Change/ChangeOntologyProperty> a owl:ObjectProperty ;
    rdfs:comment "Added for organizational purposes to group properties defined in the Change Ontology." .

<http://ontology.eil.utoronto.ca/icity/Mereology/MereologyOntologyProperty> a owl:ObjectProperty ;
    dc:description "Created for organizational purposes, to identify properties defined in the Mereology ontology." .

OM:TimeUnit a owl:Class ;
    rdfs:label "time unit" ;
    rdfs:subClassOf OM:Unit .

OM:UnitDivision a owl:Class ;
    rdfs:label "unit division" ;
    rdfs:subClassOf OM:Unit .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasNetworkComponent> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/Mereology/hasComponent>,
        <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyProperty> .

terms1:Frequency a owl:Class ;
    rdfs:label "Frequency"@en,
        "Frecuencia"@es ;
    rdfs:comment "An alternative to defining departures and arrivals as StopTimes: define frequencies for transit vehicle"@en,
        "Una alternativa a definir salidas y llegadas como StopTimes: definir frecuencias para vehÃ­culos de transporte pÃºblico"@es ;
    rdfs:seeAlso <https://developers.google.com/transit/gtfs/reference#frequencies_fields> ;
    rdfs:subClassOf :gtfsThing ;
    ns3:term_status "unstable"@en,
        "inestable"@es .

terms1:StopTime a owl:Class ;
    rdfs:label "Stop time"@en,
        "Hora de parada"@es ;
    rdfs:comment "Describes a stop time as part of a trip"@en,
        "Describe una hora de parada como parte de un viaje"@es ;
    rdfs:seeAlso <https://developers.google.com/transit/gtfs/reference#stop_times_fields> ;
    rdfs:subClassOf :gtfsThing ;
    ns3:term_status "unstable"@en,
        "inestable"@es .

terms1:WheelchairBoardingStatus a owl:Class ;
    rdfs:label "Wheelchair Boarding Information"@en,
        "InformaciÃ³n de accesibilidad para silla de ruedas"@es ;
    rdfs:comment "A class whom's instances indicate how accessible a gtfs:Trip, gtfs:Stop or gtfs:Station is."@en,
        "Las instancias de esta clase indican como de accesible es un gtfs:Trip, un gtfs:Stop o una gtfs:Station."@es ;
    rdfs:seeAlso <https://developers.google.com/transit/gtfs/reference#stops_fields> ;
    rdfs:subClassOf :gtfsThing ;
    ns3:term_status "unstable"@en,
        "inestable"@es .

xsd:duration a rdfs:Datatype .

time:DateTimeInterval a owl:Class ;
    rdfs:label "Date-time interval"@en,
        "intervalo de fecha-hora"@es ;
    rdfs:comment "DateTimeInterval is a subclass of ProperInterval, defined using the multi-element DateTimeDescription."@en,
        "'intervalo de fecha-hora' es una subclase de 'intervalo propio', definida utilizando el multi-elemento 'descripción de fecha-hora'."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty time:xsdDateTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:GeneralDateTimeDescription ;
            owl:onProperty time:hasDateTimeDescription ],
        time:ProperInterval ;
    skos:definition "DateTimeInterval is a subclass of ProperInterval, defined using the multi-element DateTimeDescription."@en,
        "'intervalo de fecha-hora' es una subclase de 'intervalo propio', definida utilizando el multi-elemento 'descripción de fecha-hora'."@es ;
    skos:note ":DateTimeInterval can only be used for an interval whose limits coincide with a date-time element aligned to the calendar and timezone indicated. For example, while both have a duration of one day, the 24-hour interval beginning at midnight at the beginning of 8 May in Central Europe can be expressed as a :DateTimeInterval, but the 24-hour interval starting at 1:30pm cannot."@en,
        "'intervalo de fecha-hora' se puede utilizar sólo para un intervalo cuyos límites coinciden con un elemento de fecha-hora alineados con el calendario y la zona horaria indicados. Por ejemplo, aunque ambos tienen una duración de un día, el intervalo de 24 horas que empieza en la media noche del comienzo del 8 mayo en Europa Central se puede expresar como un 'intervalo de fecha-hora', el intervalo de 24 horas que empieza a las 1:30pm no."@es .

time:TimePosition a owl:Class ;
    rdfs:label "Time position"@en,
        "posición de tiempo"@es ;
    rdfs:comment "A temporal position described using either a (nominal) value from an ordinal reference system, or a (numeric) value in a temporal coordinate system. "@en,
        "Una posición temporal descrita utilizando bien un valor (nominal) de un sistema de referencia ordinal, o un valor (numérico) en un sistema de coordenadas temporales."@es ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty time:nominalPosition ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty time:numericPosition ] ) ],
        time:TemporalPosition ;
    skos:definition "A temporal position described using either a (nominal) value from an ordinal reference system, or a (numeric) value in a temporal coordinate system. "@en,
        "Una posición temporal descrita utilizando bien un valor (nominal) de un sistema de referencia ordinal, o un valor (numérico) en un sistema de coordenadas temporales."@es .

time:hasTRS a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Temporal reference system used"@en,
        "sistema de referencia temporal utilizado"@es ;
    rdfs:comment "The temporal reference system used by a temporal position or extent description. "@en,
        "El sistema de referencia temporal utilizado por una posición temporal o descripción de extensión."@es ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( time:GeneralDurationDescription time:TemporalPosition ) ] ;
    rdfs:range time:TRS ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/5087/1/Time/TimeOntologyProperty>,
        <http://ontology.eil.utoronto.ca/icity/Time/TimeOntologyProperty> ;
    skos:definition "The temporal reference system used by a temporal position or extent description. "@en,
        "El sistema de referencia temporal utilizado por una posición temporal o descripción de extensión."@es .

time:month a owl:DatatypeProperty ;
    rdfs:label "month"@en,
        "mes"@es ;
    rdfs:comment """Month position in a calendar-clock system.

The range of this property is not specified, so can be replaced by any specific representation of a calendar month from any calendar. """@en,
        """Posición de mes en un sistema calendario-reloj.
    El rango de esta propiedad no está especificado, por tanto, se puede reemplazar por cualquier representación específica de un mes de calendario de un calendario cualquiera."""@es ;
    rdfs:domain time:GeneralDateTimeDescription ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/5087/1/Time/TimeOntologyDataProperty> ;
    skos:definition """Month position in a calendar-clock system.

The range of this property is not specified, so can be replaced by any specific representation of a calendar month from any calendar. """@en,
        """Posición de mes en un sistema calendario-reloj.
            El rango de esta propiedad no está especificado, por tanto, se puede reemplazar por cualquier representación específica de un mes de calendario de un calendario cualquiera."""@es .

time:year a owl:DatatypeProperty ;
    rdfs:label "year"@en ;
    rdfs:comment """Year position in a calendar-clock system.

The range of this property is not specified, so can be replaced by any specific representation of a calendar year from any calendar. """@en,
        """Posición de año en un sistema calendario-reloj.

l rango de esta propiedad no está especificado, por tanto, se puede reemplazar por cualquier representación específica de un año de calendario de un calendario cualquiera."""@es ;
    rdfs:domain time:GeneralDateTimeDescription ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/5087/1/Time/TimeOntologyDataProperty> .

sosa:ActuatableProperty a owl:Class ;
    rdfs:label "Actuatable Property"@en ;
    rdfs:comment "An actuatable quality (property, characteristic) of a FeatureOfInterest."@en ;
    rdfs:isDefinedBy sosa: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sosa:Actuation ;
            owl:onProperty sosa:isActedOnBy ],
        ssn:Property ;
    skos:definition "An actuatable quality (property, characteristic) of a FeatureOfInterest."@en ;
    skos:example "A window actuator acts by changing the state between a frame and a window. The ability of the window to be opened and closed is its ActuatableProperty."@en .

sosa:isResultOf a owl:ObjectProperty ;
    rdfs:label "is result of"@en ;
    schema1:domainIncludes sosa:Result,
        sosa:Sample ;
    schema1:rangeIncludes sosa:Actuation,
        sosa:Observation,
        sosa:Sampling ;
    rdfs:comment "Relation linking a Result to the Observation or Actuation or act of Sampling that created or caused it."@en ;
    rdfs:isDefinedBy sosa: ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/SSN/ssnObjectProperty> ;
    skos:definition "Relation linking a Result to the Observation or Actuation or act of Sampling that created or caused it."@en .

sosa:madeByActuator a owl:ObjectProperty ;
    rdfs:label "made by actuator"@en ;
    schema1:domainIncludes sosa:Actuation ;
    schema1:rangeIncludes sosa:Actuator ;
    rdfs:comment "Relation linking an Actuation to the Actuator that made that Actuation."@en ;
    rdfs:isDefinedBy sosa: ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/SSN/ssnObjectProperty> ;
    skos:definition "Relation linking an Actuation to the Actuator that made that Actuation."@en .

ssn:Property a owl:Class ;
    rdfs:label "Property"@en ;
    rdfs:comment "A quality of an entity. An aspect of an entity that is intrinsic to and cannot exist without the entity."@en ;
    rdfs:isDefinedBy ssn: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sosa:FeatureOfInterest ;
            owl:onProperty ssn:isPropertyOf ],
        <http://ontology.eil.utoronto.ca/icity/SSN/SSNThing>,
        :SSNThing ;
    skos:definition "A quality of an entity. An aspect of an entity that is intrinsic to and cannot exist without the entity."@en .

ssn:Stimulus a owl:Class ;
    rdfs:label "Stimulus"@en ;
    rdfs:comment "An event in the real world that 'triggers' the Sensor. The properties associated to the Stimulus may be different to the eventual observed ObservableProperty. It is the event, not the object, that triggers the Sensor."@en ;
    rdfs:isDefinedBy ssn: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sosa:ObservableProperty ;
            owl:onProperty ssn:isProxyFor ],
        [ a owl:Restriction ;
            owl:allValuesFrom sosa:Observation ;
            owl:onProperty [ owl:inverseOf ssn:wasOriginatedBy ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom sosa:Sensor ;
            owl:onProperty [ owl:inverseOf ssn:detects ] ],
        <http://ontology.eil.utoronto.ca/icity/SSN/SSNThing>,
        :SSNThing ;
    skos:definition "An event in the real world that 'triggers' the Sensor. The properties associated to the Stimulus may be different to the eventual observed ObservableProperty. It is the event, not the object, that triggers the Sensor."@en .

ssn:wasOriginatedBy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "was originated by"@en ;
    rdfs:comment "Relation between an Observation and the Stimulus that originated it."@en ;
    rdfs:isDefinedBy ssn: ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/SSN/ssnObjectProperty> ;
    skos:definition "Relation between an Observation and the Stimulus that originated it."@en .

:Vehicle a owl:Class ;
    rdfs:comment "A Vehicle is any mobile asset used to transport people or goods within the transportation system. Examples include cars, buses, trains, and bicycles. Vehicles can be monitored for performance, maintenance, and routing in the asset management system." ;
    rdfs:subClassOf :Asset .

