terms1:CalendarDateRule a owl:Class ;
    rdfs:label "Calendar date rule"@en,
        "Regla de fecha de calendario"@es ;
    terms1:comment "a row from calendar_dates.txt"@en,
        "una lÃ­nea en calendar_dates.txt"@es ;
    rdfs:comment "Defines service availability for a specific date"@en,
        "Indica la disponibilidad de servicio para una fecha concreta"@es ;
    rdfs:seeAlso <https://developers.google.com/transit/gtfs/reference#calendar_dates_fields> ;
    rdfs:subClassOf terms1:ServiceRule ;
    ns3:term_status "unstable"@en,
        "inestable"@es .

terms1:FareRule a owl:Class ;
    rdfs:label "Fare Rule"@en,
        "Regla tarifaria"@es ;
    rdfs:comment "A rule which binds a gtfs:FareClass to a part of the network."@en,
        "Una regla que enlaza una clase tarifaria (gtfs:FareClass) a un zona de la red de transporte."@es ;
    rdfs:subClassOf :gtfsThing ;
    ns3:term_status "unstable"@en,
        "inestable"@es .

