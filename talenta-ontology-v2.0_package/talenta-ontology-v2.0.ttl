    owl:versionInfo 1.0,
        1.1,
        1.2,
        "0.1 8 November 2019"@en,
        """8 March 2022:
 - added Difference_Quantity and Sum_Quantity

18 November 2021:
  - replaced w3c time.rdf with ontology.eil.utoronto.ca/5087/1/Time.owl due to parse errors

12 Februrary 2021:
  - Created Geometry as subclass of gis:Geometry in order to specify properties directly
  - Modified Feature (subclass of gis:Feature) to add properties, and remove it as a subclass of Polygon
  - added asWKT as sub property of gis:asWKT, made if functional
  - added hasGeometry as sub property of gis:hasGeometry, made if functional
  - change object property value to be functional

21January2021:
  - added OM v2 properties: hasUnit, hasValue, hasNumericalValue
     but keeping the old properties for dual use at this time"""@en,
        """New modular version of the SSN ontology. 

This ontology was originally developed in 2009-2011 by the W3C Semantic Sensor Networks Incubator Group (SSN-XG). For more information on the group's activities see: http://www.w3.org/2005/Incubator/ssn/. The ontology was revised and modularized in 2015-2017 by the W3C/OGC Spatial Data on the Web Working Group, see: https://www.w3.org/2015/spatial/wiki/Semantic_Sensor_Network_Ontology. 

In particular, (a) the scope is extended to include actuation and sampling; (b) the core concepts and properties are factored out into the SOSA ontology. The SSN ontology imports SOSA and adds formal axiomatization consistent with the text definitions in SOSA, and adds classes and properties to accommodate the scope of the original SSN ontology. """@en ;
    skos:changeNote "2016-06-15 - initial update of OWL-Time - modified to support arbitrary temporal reference systems. ",
        "2016-12-20 - adjust range of time:timeZone to time:TimeZone, moved up from the tzont ontology.  ",
        "2016-12-20 - restore time:Year and time:January which were present in the 2006 version of the ontology, but now marked \"deprecated\". ",
        "2017-02 - intervalIn, intervalDisjoint, monthOfYear added; TemporalUnit subclass of TemporalDuration",
        "2017-04-06 - hasTime, hasXSDDuration added; Number removed; all duration elements changed to xsd:decimal" ;
    skos:historyNote """Update of OWL-Time ontology, extended to support general temporal reference systems. 

Ontology engineering by Simon J D Cox"""@en ;
    adms:relatedDocumentation "Under development. Please see report on iCity Ontology v1.2"^^xsd:gYearMonth,
        "ISO21972",
        "Under development. Please see report on iCity Ontology v1.",
        "Under development. Refer to Report of iCity Ontology v1." .

:Airport a owl:Class ;
    rdfs:subClassOf :TransportationInfrastructure .

:Automobile a owl:Class ;
    rdfs:subClassOf :LandVehicle ;
    owl:equivalentClass :Car .

:Boat a owl:Class ;
    rdfs:subClassOf :Watercraft .

:BridgeName a owl:Class ;
    rdfs:label "Bauwerksname"@de,
        "Bridge name"@en ;
    rdfs:comment "The official name of the bridge" ;
    rdfs:subClassOf :BridgeInfrastructure .

:Bus a owl:Class ;
    rdfs:subClassOf :LandVehicle .

:ConditionRating a owl:Class ;
    rdfs:label "zustandsnote"@de,
        "Condition rating"@en ;
    rdfs:comment "A numerical assessment of the current condition of the bridge structure according to RI-EBW test" ;
    rdfs:subClassOf brstr:StructuralAssessment .

:Helicopter a owl:Class ;
    rdfs:subClassOf :Aircraft .

:Plane a owl:Class ;
    rdfs:subClassOf :Aircraft .

:Tunnel a owl:Class ;
    rdfs:subClassOf :TransportationInfrastructure .

:hasGeolocation a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Geolocation ;
    rdfs:subPropertyOf owl:topObjectProperty .

:hasGeometry a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Geometry ;
    rdfs:subPropertyOf owl:topObjectProperty .

:hasProperty a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :MaterialProperty ;
    rdfs:subPropertyOf owl:topObjectProperty .

:hasRoute a owl:ObjectProperty ;
    rdfs:domain :Train ;
    rdfs:range terms1:Route .

:hasSensor a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Sensor ;
    rdfs:subPropertyOf owl:topObjectProperty .

:hasSleeper a owl:ObjectProperty ;
    rdfs:domain :Railway ;
    rdfs:range :RailwaySleeper ;
    rdfs:subPropertyOf owl:topObjectProperty .

:hasTime a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Time ;
    rdfs:subPropertyOf owl:topObjectProperty .

:hasTrip a owl:ObjectProperty ;
    rdfs:domain :Train ;
    rdfs:range terms1:Trip .

:hoechst_sachverhalt_oben a owl:Class ;
    rdfs:comment "highest classified road above" ;
    rdfs:subClassOf :Sachverhalt .

:hoechst_sachverhalt_unten a owl:Class ;
    rdfs:comment "highest classified road below" ;
    rdfs:subClassOf :Sachverhalt .

:jast_lage a owl:Class ;
    rdfs:comment "Position according to the annual statistics in accordance with ASB-ING Appendix D6" ;
    rdfs:subClassOf :BridgeInfrastructure .

:utm32nCoordinate a owl:DatatypeProperty ;
    rdfs:label "UTM32N-Koordinate"@de,
        "UTM32N coordinate"@en ;
    rdfs:domain :Geolocation ;
    rdfs:range xsd:string .

