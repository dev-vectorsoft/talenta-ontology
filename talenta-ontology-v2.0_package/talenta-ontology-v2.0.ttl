    brstr:alignmentWidth 1.4e+01 ;
    brstr:bears <https://github.com/dev-vectorsoft/talenta/ontology/germanroadbridge#1KO5lzBZj8jQGcpZVjVytA> .

<https://github.com/dev-vectorsoft/talenta/ontology/germanroadbridge#1edHQCUQ5BiufFEMWeCLlQ> a owl:NamedIndividual,
        brcomp:Pier ;
    rdfs:label "Pier-2" ;
    bmat:hasBuildingMaterial <https://wisib.de/ontologie/abox/germanroadbridge/d1#BSt420S>,
        <https://wisib.de/ontologie/abox/germanroadbridge/d1#HOZ350L> ;
    brstr:alignmentWidth 1.4e+01 ;
    brstr:bears <https://github.com/dev-vectorsoft/talenta/ontology/germanroadbridge#1Jsruwj6v82xuNR9o70ozy> .

