    rdfs:domain bmat:NaturalStone .

brcomp:GirderDeck a owl:Class ;
    rdfs:label "Brückenplatte"@de,
        "Deck"@en ;
    rdfs:comment "Obere Platte des Brueckendeckquerschnitts"@de,
