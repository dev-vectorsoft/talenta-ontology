@prefix : <https://github.com/dev-vectorsoft/talenta/ontology#> .
@prefix OM: <http://ontology.eil.utoronto.ca/icity/OM/> .
@prefix WV: <http://www.wurvoc.org/vocabularies/WV/> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix bmat: <https://wisib.de/ontologie/bmat#> .
@prefix brcomp: <https://wisib.de/ontologie/brcomp#> .
@prefix bridge: <https://wisib.de/ontologie/bridge#> .
@prefix brot: <https://wisib.de/ontologie/brot#> .
@prefix brstr: <https://wisib.de/ontologie/brstr#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dc1: <http://purl.org/dc/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix iso21972: <http://ontology.eil.utoronto.ca/ISO21972/iso21972#> .
@prefix ns: <http://creativecommons.org/ns#> .
@prefix ns1: <http://ontorail.org/voc/xmi/ns#> .
@prefix ns2: <http://ontorail.org/voc/ns#> .
@prefix ns3: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix om-1: <http://www.wurvoc.org/vocabularies/om-1.8/> .
@prefix ontology: <http://dbpedia.org/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix schema2: <http://schema.org/#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix terms1: <http://vocab.gtfs.org/terms#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix wgs84_pos: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns:license a owl:AnnotationProperty .

ontology:locationCity a owl:AnnotationProperty .

ontology:manufacturer a owl:AnnotationProperty .

ontology:nearestCity a owl:AnnotationProperty .

<http://http://www.opengis.net/ont/geosparql#Polygon> a owl:Class ;
    rdfs:subClassOf :TransportationSystemThing .

<http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Population_size> a owl:Class ;
    rdfs:label "Population Size" ;
    rdfs:comment "Reused from GCI Foundation ontology: http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl",
        "gci:Population_size is a subclass of om:Quantity.  Its om:unit_of_measure is the gci:population_cardinality_unit. It is also a subclass of gs:Cardinality which provides the cardinality_of property that links to a gs:Population." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Population> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/govstat.owl#cardinality_of> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Population_measure> ;
            owl:onProperty OM:hasValue ],
        OM:Quantity ;
    owl:equivalentClass iso21972:Distinct_count .

iso21972:DifferenceIndicator a owl:Class ;
    rdfs:comment "Difference between term_1 and term_2 (term_1 - term_2)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass iso21972:Quantity ;
            owl:onProperty iso21972:term_1 ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass iso21972:Quantity ;
            owl:onProperty iso21972:term_2 ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        iso21972:Indicator .

iso21972:Fixed_zero_point a owl:Class ;
    rdfs:label "fixed zero point"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "0" ;
            owl:onProperty iso21972:numerical_value ],
        iso21972:Fixed_point .

iso21972:Monetary_unit a owl:Class ;
    rdfs:subClassOf iso21972:ISO21972Thing,
        iso21972:Singular_unit ;
    owl:equivalentClass OM:AmountOfMoneyUnit .

iso21972:RatioIndicator a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass iso21972:Quantity ;
            owl:onProperty iso21972:denominator ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass iso21972:Unit_division ;
            owl:onProperty iso21972:unit_of_measure ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass iso21972:Quantity ;
            owl:onProperty iso21972:numerator ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        iso21972:Indicator .

iso21972:Sample_cardinality a owl:Class ;
    rdfs:subClassOf iso21972:Statistic .

iso21972:Sample_mean a owl:Class ;
    rdfs:subClassOf iso21972:Statistic ;
    owl:disjointWith iso21972:Sample_standard_deviation .

iso21972:Sample_sum a owl:Class ;
    rdfs:subClassOf iso21972:Statistic .

iso21972:SumIndicator a owl:Class ;
    rdfs:comment "Sum of term_1 and term_2 (term_1 + term_2)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass iso21972:Quantity ;
            owl:onProperty iso21972:term_2 ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass iso21972:Quantity ;
            owl:onProperty iso21972:term_1 ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        iso21972:Indicator .

iso21972:Unit a owl:Class ;
    rdfs:subClassOf iso21972:ISO21972Thing .

iso21972:base_quantity a owl:ObjectProperty ;
    rdfs:label "base quantity"@en ;
    rdfs:domain iso21972:System_of_units ;
    rdfs:range iso21972:Quantity ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty ;
    om-1:alternative_label "has base quantity"@en .

iso21972:base_unit a owl:ObjectProperty ;
    rdfs:label "base unit"@en ;
    rdfs:domain iso21972:System_of_units ;
    rdfs:range iso21972:Unit_of_measure ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty ;
    om-1:alternative_label "has base unit"@en .

iso21972:decibel a iso21972:Singular_unit,
        owl:NamedIndividual .

iso21972:derived_quantity a owl:ObjectProperty ;
    rdfs:label "derived quantity"@en ;
    rdfs:domain iso21972:System_of_units ;
    rdfs:range iso21972:Quantity ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty ;
    om-1:alternative_label "has derived quantity"@en .

iso21972:factor a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "factor"@en ;
    rdfs:domain iso21972:Prefix ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf iso21972:i72DataProperty ;
    om-1:alternative_label "has factor"@en .

iso21972:gigapc a iso21972:Unit_multiple_or_submultiple,
        owl:NamedIndividual ;
    iso21972:prefix iso21972:giga ;
    iso21972:singular_unit iso21972:population_cardinality_unit ;
    iso21972:symbol "gigapc" .

iso21972:hasBase a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

iso21972:hasDenominator a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

iso21972:hasNumerator a owl:ObjectProperty ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

iso21972:hasTerm1 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "replaces property: term_1" ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

iso21972:hasTerm2 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "replaces property: term_2" ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

iso21972:hour_per_interruption a iso21972:Unit_division,
        owl:NamedIndividual ;
    iso21972:denominator iso21972:interruption ;
    iso21972:numerator iso21972:hour .

iso21972:interruption_per_year a iso21972:Unit_division,
        owl:NamedIndividual ;
    iso21972:denominator iso21972:year ;
    iso21972:numerator iso21972:interruption .

iso21972:kilopc a iso21972:Unit_multiple_or_submultiple,
        owl:NamedIndividual ;
    iso21972:singular_unit iso21972:population_cardinality_unit ;
    iso21972:symbol "kilopc" .

iso21972:kwh_per_pc a iso21972:Unit_division,
        owl:NamedIndividual ;
    iso21972:denominator iso21972:square_metre ;
    iso21972:numerator iso21972:population_cardinality_unit ;
    iso21972:symbol "kwh_per_pc" .

iso21972:kwh_per_square_metre a iso21972:Unit_division,
        owl:NamedIndividual ;
    iso21972:denominator iso21972:square_metre ;
    iso21972:numerator iso21972:kilowatt_hour ;
    iso21972:symbol "kwh_per_m2" .

iso21972:kwh_per_year a iso21972:Unit_division,
        owl:NamedIndividual ;
    iso21972:denominator iso21972:year ;
    iso21972:numerator iso21972:kilowatt ;
    iso21972:symbol "kwh_per_year" .

iso21972:located_in a owl:ObjectProperty ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

iso21972:measurement_scale a owl:ObjectProperty ;
    rdfs:label "measurement scale"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( iso21972:Application_area iso21972:Point iso21972:Quantity ) ] ;
    rdfs:range iso21972:Measurement_scale ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty ;
    om-1:alternative_label "has measurement scale"@en .

iso21972:megapc a iso21972:Unit_multiple_or_submultiple,
        owl:NamedIndividual ;
    iso21972:prefix iso21972:mega ;
    iso21972:singular_unit iso21972:population_cardinality_unit ;
    iso21972:symbol "megapc" .

iso21972:microgram_per_cubic_metre a iso21972:Unit_division,
        owl:NamedIndividual ;
    iso21972:denominator iso21972:cubic_metre ;
    iso21972:numerator iso21972:microgram .

iso21972:minute-time_per_occurence a iso21972:Unit_division,
        owl:NamedIndividual ;
    iso21972:denominator iso21972:occurrence ;
    iso21972:numerator iso21972:minute-time .

iso21972:occurence_per_hecto_kilo_pc a iso21972:Unit_division,
        owl:NamedIndividual ;
    iso21972:denominator iso21972:hecto_kilo_pc ;
    iso21972:numerator iso21972:occurrence .

iso21972:pc_per_hecto_kilo_pc a iso21972:Unit_division,
        owl:NamedIndividual ;
    iso21972:denominator iso21972:hecto_kilo_pc ;
    iso21972:numerator iso21972:population_cardinality_unit .

iso21972:phenomenon a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "phenomenon"@en ;
    rdfs:domain iso21972:Quantity ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty ;
    om-1:alternative_label "has phenomenon"@en .

iso21972:population_ratio_unit a iso21972:Unit_division,
        owl:NamedIndividual ;
    iso21972:denominator iso21972:population_cardinality_unit ;
    iso21972:numerator iso21972:population_cardinality_unit ;
    dc:description """population_ratio_unit is defined to be an instance of Unit_division. It has two properties:
• whose range is restricted to being a population_cardinality_unit;
• whose range is restricted to being a population_cardinality_unit.

In other words, a population ratio is the ratio of two population cardinalities (i.e., number of members/elements in each population)"""@en .

iso21972:prefix a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "prefix"@en ;
    rdfs:domain iso21972:Unit_multiple_or_submultiple ;
    rdfs:range iso21972:Prefix ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty ;
    om-1:alternative_label "has prefix"@en .

iso21972:rank a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "rank"@en ;
    rdfs:domain iso21972:Ordered_measurement_scale_category ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf iso21972:i72DataProperty ;
    om-1:alternative_label "has rank"@en .

iso21972:singular_unit a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "singular unit"@en ;
    rdfs:domain iso21972:Unit_multiple_or_submultiple ;
    rdfs:range iso21972:Singular_unit ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty ;
    om-1:alternative_label "has singular unit"@en .

iso21972:symbol a owl:DatatypeProperty ;
    rdfs:subPropertyOf iso21972:i72DataProperty .

<http://ontology.eil.utoronto.ca/icity/Mereology/immediateComponentOf> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/Mereology/componentOf> .

<http://ontology.eil.utoronto.ca/icity/Mereology/immediatelyContainedIn> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/Mereology/containedIn> .

OM:Acceleration a owl:Class ;
    rdfs:label "acceleration" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom OM:AccelerationUnit ;
                    owl:onProperty OM:hasUnit ] ;
            owl:onProperty OM:hasValue ],
        OM:Quantity .

OM:Area a owl:Class ;
    rdfs:label "area" ;
    rdfs:comment "Area expresses the two-dimensional size of a defined part of a surface, typically a region bounded by a closed curve. It is a derived quantity in the International System of Units. Area is length squared." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom OM:AreaUnit ;
                    owl:onProperty OM:hasUnit ] ;
            owl:onProperty OM:hasValue ],
        OM:Quantity .

OM:CapacitySize a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass OM:Capacity ;
            owl:onProperty <http://ontology.eil.utoronto.ca/govstat.owl#cardinality_of> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom OM:CardinalityMeasure ;
            owl:onProperty OM:hasValue ],
        OM:Quantity .

OM:Duration a owl:Class ;
    rdfs:label "duration" ;
    rdfs:subClassOf OM:Time .

OM:Mass a owl:Class ;
    rdfs:label "mass" ;
    rdfs:comment "Mass is the amount of matter of a phenomenon. It is a base quantity in the International System of Units. Mass is force divided by acceleration." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom OM:MassUnit ;
                    owl:onProperty OM:hasUnit ] ;
            owl:onProperty OM:hasValue ],
        OM:Quantity .

OM:NAD83 a OM:Geo_Position_unit,
        owl:NamedIndividual ;
    rdfs:comment "North American Datum of 1983. A geodetic reference system." .

OM:ValueOfMoney a owl:Class ;
    rdfs:comment "An amount of money that is defined relative to a particular year." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom OM:MonetaryValue ;
            owl:onProperty OM:hasValue ],
        OM:AmountOfMoney .

OM:WGS84 a OM:Geo_Position_unit,
        owl:NamedIndividual ;
    rdfs:comment "World Geodetic System of 1984. The reference system used by GPS." .

OM:aggregateOf a owl:ObjectProperty ;
    rdfs:domain OM:Quantity ;
    rdfs:subPropertyOf om-1:OMProperty .

OM:aggregateOver a owl:ObjectProperty ;
    rdfs:domain OM:Quantity ;
    rdfs:subPropertyOf om-1:OMProperty .

OM:derived_unit a owl:ObjectProperty ;
    rdfs:subPropertyOf om-1:OMProperty .

OM:hasBaseUnit a owl:ObjectProperty ;
    rdfs:domain OM:System_of_units ;
    rdfs:range OM:Unit ;
    rdfs:subPropertyOf om-1:OMProperty .

OM:hasLength a owl:ObjectProperty ;
    rdfs:range OM:Length ;
    rdfs:subPropertyOf om-1:OMProperty .

<http://ontology.eil.utoronto.ca/icity/SpatialLoc/as_nDLatLon> a owl:DatatypeProperty ;
    rdfs:domain <http://www.opengis.net/ont/sf#Geometry> ;
    rdfs:range <http://franz.com/ns/allegrograph/5.0/geo/nd#_lat_la_-9.+1_+9.+1_+1.-4_+1.-1_lon_lo_-1.8+2_+1.8+2_+1.-4> ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/SpatialLoc/hasSerialization> .

<http://ontology.eil.utoronto.ca/icity/SpatialLoc/containedIn> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/SpatialLoc/SpatialLocOntologyProperty> ;
    owl:inverseOf geo:sfContains .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/LoopDetector> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://ontology.eil.utoronto.ca/icity/TransportationSystem/road_occupancy> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue <http://ontology.eil.utoronto.ca/icity/TransportationSystem/vehicle_volume> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue <http://ontology.eil.utoronto.ca/icity/TransportationSystem/mean_travel_speed> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom geo:Feature ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/SpatialLoc/associatedLocation> ],
        [ a owl:Restriction ;
            owl:hasValue <http://ontology.eil.utoronto.ca/icity/TransportationSystem/vehicle_presence> ;
            owl:onProperty ssn:detects ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( sosa:Observation [ a owl:Restriction ;
                                owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Arc> ;
                                owl:onProperty sosa:hasFeatureOfInterest ] [ a owl:Restriction ;
                                owl:allValuesFrom [ a owl:Class ;
                                        owl:unionOf ( <http://ontology.eil.utoronto.ca/icity/TransportationSystem/MeanTravelSpeed> <http://ontology.eil.utoronto.ca/icity/TransportationSystem/RoadOccupancy> <http://ontology.eil.utoronto.ca/icity/TransportationSystem/VehicleVolume> ) ] ;
                                owl:onProperty sosa:hasResult ] [ a owl:Restriction ;
                                owl:hasValue <http://ontology.eil.utoronto.ca/icity/TransportationSystem/vehicle_presence> ;
                                owl:onProperty ssn:wasOriginatedBy ] ) ] ;
            owl:onProperty sosa:madeObservation ],
        <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyThing>,
        sosa:Sensor .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/MeanTTI_Max> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue OM:average ;
            owl:onProperty OM:hasAggregateFunction ],
        <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TTI_Max> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/MeanTTI_Min> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue OM:average ;
            owl:onProperty OM:hasAggregateFunction ],
        <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TTI_Min> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/PlanningDistrict> a owl:Class ;
    rdfs:comment "We observe that the properties inMunicipality and inPlanningDistrict will likely apply to other areas of the domain (e.g. land use, building ontologies). It is likely that they will be better defined at a lower (more foundational) level within the ontology, however it is currently not clear where and how this should be done. For now, we define these properties within the Transportation Network System ontology and leave the final organization for a future iteration when the use and related concepts is more clear." ;
    rdfs:subClassOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyThing> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/Road> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/RoadSegment> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/aggregationOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/RoadId> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasRoadId> ],
        <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationComplex> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/RoadSegmentId> a owl:Class ;
    rdfs:subClassOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyThing> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/RoadSegmentPD> a owl:Class ;
    rdfs:subClassOf <http://ontology.eil.utoronto.ca/icity/Change/TimeVaryingConcept>,
        <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationComplexPD> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/hasManifestation> ;
                        owl:someValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/RoadSegment> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/RoadSegment> ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/hasManifestation> ] ) ] .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasRoadSegmentId> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyProperty> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasTravelCost> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyProperty> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/inPlanningDistrict> a owl:ObjectProperty ;
    rdfs:comment "Parts of the transportation network such as nodes and arcs, but also various physical entities, may be associated with (by location or ownership) a Planning District." ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyProperty> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/vehicles_per_hour> a <http://ontology.eil.utoronto.ca/icity/TransportationSystem/LaneCapacity_unit>,
        owl:NamedIndividual .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/vehicles_per_hour_per_lane> a <http://ontology.eil.utoronto.ca/icity/TransportationSystem/LinkCapacity_unit>,
        owl:NamedIndividual .

<http://ontology.eil.utoronto.ca/icity/Vehicle/quantity> a owl:Class ;
    rdfs:subClassOf schema1:QuantitativeValue .

ns2:ofPackage a owl:AnnotationProperty .

ns1:alias a owl:AnnotationProperty .

ns1:ea_eleType a owl:AnnotationProperty .

ns1:ea_localid a owl:AnnotationProperty .

ns1:isAbstract a owl:AnnotationProperty .

ns1:isActive a owl:AnnotationProperty .

ns1:isLeaf a owl:AnnotationProperty .

ns1:isRoot a owl:AnnotationProperty .

ns1:isSpecification a owl:AnnotationProperty .

ns1:nType a owl:AnnotationProperty .

ns1:package a owl:AnnotationProperty .

ns1:sType a owl:AnnotationProperty .

ns1:scope a owl:AnnotationProperty .

ns1:tagged a owl:AnnotationProperty .

ns1:tpos a owl:AnnotationProperty .

ns1:visibility a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

