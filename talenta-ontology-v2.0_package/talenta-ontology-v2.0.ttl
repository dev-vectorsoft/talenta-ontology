                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/manifestationOf> ] ) ] .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/TTI> a owl:Class ;
    rdfs:comment "Travel Time Index: a ratio of the inverse speed (travel time) to the inverse of some calculated, threshold speed (travel time)." ;
    rdfs:subClassOf OM:Ratio,
        <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyThing> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/controlFor> a owl:ObjectProperty ;
