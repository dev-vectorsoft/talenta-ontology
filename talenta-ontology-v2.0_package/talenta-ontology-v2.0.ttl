terms1:wheelchairAccessible a owl:ObjectProperty ;
    rdfs:label "wheelchair boarding"@en,
        "accesible para silla de ruedas"@es ;
    terms1:comment "When wheelchair_accessible is 0, map to gtfs:CheckParentStation; if 1 map to gtfs:WheelchairAccessible; if 2 map to gtfs:NotWheelchairAccessible."@en,
        "Si wheelchair_accessible es 0, mapee a gtfs:CheckParentStation; si es 1, mapee a gtfs:WheelchairAccessible; si es 2, mapee a gtfs:NotWheelchairAccessible."@es ;
    rdfs:comment "Wheelchair boardings are possible from the specified stop or station. If this stop is part of a station, there is also a wheelchair accessible path from outside the station towards the stop."@en,
        "La parada o estaciÃ³n especÃ­fica es accesible para silla de ruedas. Si esta parada es parte de una estaciÃ³n, hay tambiÃ©n una ruta accesible desde el exterior de la estaciÃ³n hasta la parada."@es ;
    rdfs:domain terms1:Station,
