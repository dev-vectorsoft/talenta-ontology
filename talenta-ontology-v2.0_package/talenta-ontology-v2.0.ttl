                        owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Link> ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/hasManifestation> ] ) ] .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/Mode> a owl:Class ;
    rdfs:subClassOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyThing> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/RoadSegment> a owl:Class ;
