    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/manifestationOf> ;
                        owl:someValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/NetworkPD> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/NetworkPD> ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/manifestationOf> ] ) ] .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationComplex> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
