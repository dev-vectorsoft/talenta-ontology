<http://ontology.eil.utoronto.ca/icity/TransportationSystem/MeanTravelSpeed> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue OM:average ;
            owl:onProperty OM:hasAggregateFunction ],
        OM:Speed,
        <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyThing> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/NetworkTransfer> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Node> ;
