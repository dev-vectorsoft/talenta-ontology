time:TemporalEntity a owl:Class ;
    rdfs:label "Temporal entity"@en,
        "entidad temporal"@es ;
    rdfs:comment "A temporal interval or instant."@en,
        "Un intervalo temporal o un instante."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom time:TemporalEntity ;
            owl:onProperty time:after ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:TemporalEntity ;
            owl:onProperty time:before ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:duration ;
            owl:onProperty time:hasXSDDuration ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:TemporalDuration ;
            owl:onProperty time:hasTemporalDuration ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:Instant ;
            owl:onProperty time:hasEnd ],
        [ a owl:Restriction ;
            owl:allValuesFrom time:Instant ;
            owl:onProperty time:hasBeginning ],
        <http://ontology.eil.utoronto.ca/5087/1/Time/TimeOntologyThing>,
        <http://ontology.eil.utoronto.ca/icity/SSN/SSNThing>,
        <http://ontology.eil.utoronto.ca/icity/Time/TimeOntologyThing>,
        owl:Thing,
        :SSNThing,
        :TransportationSystemThing ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( time:Instant time:Interval ) ] ;
    skos:definition "A temporal interval or instant."@en,
        "Un intervalo temporal o un instante."@es .

:gtfsThing a owl:Class ;
