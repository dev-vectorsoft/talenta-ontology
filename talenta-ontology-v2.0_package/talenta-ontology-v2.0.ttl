bmat:cementContent a owl:DatatypeProperty ;
    rdfs:label "Zementgehalt"@de,
        "Cement content"@en ;
    rdfs:comment """DATENTYP DES EINGABEWERTES:

xsd:double [Wasser/Zement]

Einheit in [kg/m³]"""@de,
        """TYPE INPUT VALUE: 

xsd:double [watter/cement]

Unit: [kg/m³]"""@en ;
    rdfs:subPropertyOf bmat:concreteAttribute .

bmat:cementDesignation a owl:DatatypeProperty ;
    rdfs:label "Zementbezeichnung"@de,
        "Cement designation"@en ;
    rdfs:comment """Cements according to DIN EN 197-1 are marked by the following information:

- the main type of cement and the standard designation,
- the abbreviation of the cement type,
- the strength class 32.5, 42.5 or 52.5
- the initial strength: N (usual initial strength), R (high initial strength) or L (low initial strength), valid only for CEM III cements and
- a number or two freely selectable lower-case letters in brackets, provided that a manufacturer produces different cements with the same standard designation in a single plant in order to distinguish them from each other (see example).


Normal cements with low hydration heat are additionally marked LH, normal cements with high sulphate resistance SR. For CEM I with high sulphate resistance, the C3A content in the clinker must also be indicated."""@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf bmat:concreteAttribute .

bmat:cementMainConstituents a owl:DatatypeProperty ;
    rdfs:label "Hauptbestandteile vom Zement"@de,
        "Main constituents of the cement"@en ;
    rdfs:comment """(Klassifizierung erfolgt gemaess DIN EN 197-1.)

WERTEVERZEICHNIS:

K - Portlandzementklinker
S - Huettensand (granulierte Hochofenschlacke)
P - Natuerliches Puzzolan
Q - Natuerliches getempertes Puzzolan
V - Kieselsaeurereiche Flugasche
W - Kalkreiche Flugasche
T - Gebrannter Schiefer
LL - Kalkstein (darf einen Massenanteil von 0,20 % nicht ueberschreiten)
L - Kalkstein (darf einen Massenanteil von 0,50 % nicht ueberschreiten)
D - Silicastaub"""@de,
        """ENUMERATION VALUES:

(Classification according to DIN EN 197-1)

K - Portland cement clinker
S - Granulated blastfurnace slag
P - Natural pozzolana
Q - Natural calcined pozzolana
V - Siliceous fly ash
W - Calcareous fly ash
T - Burnt shale
LL- Limestone (shall not exceed 0,20 % by mass)
L- Limestone (shall not exceed 0,50 % by mass)
D - Silica fume"""@en ;
    rdfs:subPropertyOf bmat:concreteAttribute .

bmat:cementType a owl:DatatypeProperty ;
    rdfs:label "Zementart"@de,
        "Cement type"@en ;
    rdfs:comment """(Klassifizierung erfolgt gemaess DIN EN 197-1.)

WERTEVERZEICHNIS:

CEM_I - Portlandzemente
CEM_II - Portlandkompositzemente
CEM_III - Hochofenzemente
CEM_IV - Puzzolanzemente
CEM_V - Kompositzemente"""@de,
        """(Classification is according to DIN EN 197-1.)

ENUMERATION VALUES:

CEM_I - Portland cement
CEM_II - Portland-composite cement
CEM_III - Blastfurnace cement
CEM_IV - Pozzolanic cement
CEM_V - Composite cement"""@en ;
    rdfs:subPropertyOf bmat:concreteAttribute .

bmat:coatDesignation a owl:DatatypeProperty ;
    rdfs:label "Beschichtungsbezeichnung"@de,
        "Coat designation"@en ;
    rdfs:comment "Standardized designation of the coating used on a component."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf bmat:concreteAttribute .

bmat:concreteAdmixture a owl:DatatypeProperty ;
    rdfs:label "Betonzusatzstoffe"@de,
        "Concrete admixture"@en ;
    rdfs:comment "Powdery or liquid additives which influence certain properties of the concrete. They may only be added to the concrete if they do not affect the hardening of the cement, the strength and durability of the concrete and the corrosion protection of the reinforcement. In contrast to concrete admixtures, they must be considered as volume components when preparing the concrete recipe. Aggregates are not counted as concrete admixtures."@en ;
    rdfs:subPropertyOf bmat:concreteAttribute .

bmat:concreteAggregate a owl:DatatypeProperty ;
    rdfs:label "Zuschlagstoff"@de,
        "concrete aggregate"@en ;
    rdfs:comment "Mixture of unbroken and/or broken grains of natural and/or artificial mineral substances."@en ;
    rdfs:subPropertyOf bmat:concreteAttribute .

bmat:concreteStrengthClass a owl:DatatypeProperty ;
    rdfs:label "Druckfestigkeitsklasse des Betons"@de,
        "Class of compression strength of the concrete"@en ;
    rdfs:comment """Concrete can be classified according to its compressive strength.

For the classification, the characteristic strength of cylinders with a diameter of 150 mm and a length of 300 mm (fck,cyl) or of cubes with an edge length of 150 mm (fck,cube) at the test age of 28 days is used.

In principle, the compressive strength for determining the characteristic strength and assigning the strength class according to DIN EN 206-1/DIN 1045-2 shall be demonstrated on test specimens at the age of 28 days."""@en ;
    rdfs:subPropertyOf bmat:concreteAttribute .

bmat:expositionClassConcrete a owl:DatatypeProperty ;
    rdfs:label "Expositionsklasse fuer Beton"@de,
        "Exposition class of concrete"@en ;
    rdfs:comment """In order to ensure sufficient durability, concrete components must be sufficiently resistant to chemical and physical influences from their environment and use. The impacts from the various environmental conditions are classified in exposure classes which can act on the concrete, the reinforcing steel or metallic components and which are not considered as loads in the structural design. This results in the requirements for the composition of the concrete to be used, as well as the concrete covering and the permissible crack width.

The designations of the individual exposure classes are composed of the letter X (for exposure), the identification for the type of damaging influence and a number indicating the intensity of the damaging influences. The following abbreviations are used for the different types of actions:

0 for Zero Risk 
C for carbonation
D for Deicing Salt 
S for Seawater 
F for frost 
A for Chemical Attack
M for Mechanical Abrasion"""@en ;
    rdfs:subPropertyOf bmat:concreteAttribute .

bmat:expositionClassReinforcement a owl:DatatypeProperty ;
    rdfs:label "Expositionsklasse fuer Bewehrungskorrosion"@de,
        "Exposition class of reinforcement corrosion"@en ;
    rdfs:comment """Exposure class for occurring reinforcement corrosion (XC) caused by carbonation

XC1: Dry or permanently wet - indoor components with normal humidity (kitchen, bathroom in residential buildings, etc.)

XC2: Wet, rarely dry - parts of water tanks, foundation components

XC3: Moderate humidity - components with frequent or constant contact with the outside air (open halls), interiors with high humidity (commercial kitchens, bathrooms, laundries), in humid rooms of indoor swimming pools and livestock stables.

XC4: alternating wet and dry - exterior components with direct irrigation, components in water change zones"""@en ;
    rdfs:subPropertyOf bmat:reinforcementAttribute .

bmat:grainSize a owl:DatatypeProperty ;
    rdfs:label "Korngroesseverteilung von Gesteinskoernungen fuer Beton"@de,
        "Grain size distribution of the beton aggregate"@en ;
    rdfs:comment """WERTEVERZEICHNIS:

(Definition nach DIN EN 12620)

GROB 
FEIN
ZSMMNGSTZT_GESTEINSKOE - (natuerlich zusammengesetzte Gesteinskoernung 0/8)
KORNGEMISCH"""@de,
        """ENUMERATION VALUES:

(Classification according to DIN EN 12620)

COARSE
FINE
NAT_COMP_AGGR - (natural composite agregate 0/8)
GRAIN_MIXTURE"""@en ;
    rdfs:subPropertyOf bmat:concreteAttribute .

bmat:hasGroutingMaterial a owl:ObjectProperty ;
    rdfs:label "hat Verpressungsmaterial"@de,
        "has grouting material"@en ;
    rdfs:comment "Relationship between a Tendon component and a BuildingMaterial that is used as grouting material."@en ;
    rdfs:domain brcomp:Tendon ;
    rdfs:range bmat:BuildingMaterial ;
    rdfs:subPropertyOf bmat:hasBuildingMaterial .

bmat:materialAge a owl:DatatypeProperty ;
    rdfs:label "Materialalter"@de,
        "material age"@en ;
    rdfs:comment "Gibt das Jahr an, in dem das Material verbaut wurde."@de,
        "Specifies the year in which the material was installed."@en ;
    rdfs:domain bmat:BuildingMaterial .

bmat:materialStandard a owl:DatatypeProperty ;
    rdfs:label "MaterialNorm"@de,
        "material standard"@en ;
    rdfs:comment "Gibt die Norm an, die zum Zeitpunkt des Materialeinbaus befolgt wurde."@de,
        "Specifies the standard followed at the time of material installation."@en ;
    rdfs:domain bmat:BuildingMaterial .

bmat:moistureClassConcrete a owl:DatatypeProperty ;
    rdfs:label "Feuchtigkeitsklasse fuer Betonkorrosion"@de,
        "Moisture class of beton corrosion"@en ;
    rdfs:comment "The moisture class is a classification of the environmental conditions, which the engineer must always determine according to properties and standard concrete with regard to a possible damaging alkali-silica reaction in concrete."@en ;
    rdfs:subPropertyOf bmat:concreteAttribute .

bmat:reinforcementBreakingStrength a owl:DatatypeProperty ;
    rdfs:label "Bruchgrenze des Bewehrungsstahls"@de,
        "Breaking strength of reinforcing steel"@en ;
    rdfs:comment """DATENTYP DES EINGABEWERTES:

xsd:double [N/mm2]"""@de,
        """TYPE INPUT VALUE:

xsd:double [N/mm2]"""@en ;
    rdfs:subPropertyOf bmat:reinforcementAttribute .

bmat:reinforcementGrade a owl:DatatypeProperty ;
    rdfs:label "Bewehrungsklasse"@de,
        "Reinforcement grade"@en ;
    rdfs:comment "Reinforcement grade based on the tensile strength of the reinforcement."@en ;
    rdfs:subPropertyOf bmat:reinforcementAttribute .

bmat:reinforcementYieldStrength a owl:DatatypeProperty ;
    rdfs:label "Streckgrenze des Bewehrungsstahls"@de,
        "Yield strength of reinforcing steel"@en ;
    rdfs:comment """DATENTYP DES EINGABEWERTES:

xsd:double [N/mm2]"""@de,
        """TYPE INPUT VALUE:

xsd:double [N/mm2]"""@en ;
    rdfs:subPropertyOf bmat:reinforcementAttribute .

bmat:stoneAbrasionResistance a owl:DatatypeProperty ;
    rdfs:label "Abriebfestigkeit"@de,
        "Abrasion resistance"@en ;
    rdfs:comment """Abriebfestigkeit bezieht sich auf die Fähigkeit von Materialien und Strukturen, Abrieb zu widerstehen. Es ist eine Methode des Abnutzens oder Abreibens durch Reibung.

Einheit in [(cm^3)/(50 cm^2)]"""@de,
        """Abrasion resistance refers to the ability of materials and structures to withstand abrasion. It is a method of wearing down or rubbing away by means of friction.

Unit in [(cm^3)/(50 cm^2)]"""@en ;
    rdfs:subPropertyOf bmat:naturalStoneAttribute .

bmat:stoneCompressiveStrength a owl:DatatypeProperty ;
    rdfs:label "Druckfestigkeit"@de,
        "Compressive strength"@en ;
    rdfs:comment """Die Druckfestigkeit ist die Fähigkeit eines Materials oder einer Struktur, Belastungen zu widerstehen, die dazu neigen, die Größe zu verringern.

Einheit in [N/mm^2]"""@de,
        """Compressive strength is the capacity of a material or structure to withstand loads tending to reduce size.

Unit in [N/mm^2]"""@en ;
    rdfs:subPropertyOf bmat:naturalStoneAttribute .

bmat:stoneDensity a owl:DatatypeProperty ;
    rdfs:label "Rohdichte"@de,
        "Density"@en ;
    rdfs:comment """Die Rohdichte, auch scheinbare oder geometrische Dichte oder Raumgewicht genannt, ist die Dichte eines porösen Festkörpers basierend auf dem Volumen einschließlich der Porenräume.

Einheit in [kg/dm^3]"""@de,
        """The bulk density, also called apparent or geometric density or density, is the density of a porous solid based on the volume including the pore spaces.

Unit in [kg/dm^3]"""@en ;
    rdfs:subPropertyOf bmat:naturalStoneAttribute .

bmat:stoneFlexuralStrength a owl:DatatypeProperty ;
    rdfs:label "Biegezugfestigkeit"@de,
        "Flexural strength"@en ;
    rdfs:comment """Die Biegefestigkeit ist eine Materialeigenschaft, definiert als die Spannung in einem Material, kurz bevor es in einem Biegetest nachgibt.

Einheit in [N/mm^2]"""@de,
        """Flexural strength is a material property, defined as the stress in a material just before it yields in a flexure test.

Unit in [N/mm^2]"""@en ;
    rdfs:subPropertyOf bmat:naturalStoneAttribute .

bmat:stoneType a owl:DatatypeProperty ;
    rdfs:label "Steinart"@de,
        "Stone type"@en ;
    rdfs:comment """Natursteinarten:

Sandstein
Kalkstein
Granit
Quarzit
Gneis"""@de,
        """Natural stone types:

Sandstone
Limestone
Granite
Quarzit
Gneiss"""@en ;
    rdfs:subPropertyOf bmat:naturalStoneAttribute .

bmat:stoneWaterAbsorption a owl:DatatypeProperty ;
    rdfs:label "Wasseraufnahme"@de,
        "Water Absorption"@en ;
    rdfs:comment """Die Wasserabsorptionsrate ist eine Gewichtsänderung aufgrund von absorbiertem Wasser.

Einheit in [(cm^3)/(50cm^2)]"""@de,
        """Water absorption rate is change in weight due to absorbed water.

Unit in [(cm^3)/(50cm^2)]"""@en ;
    rdfs:subPropertyOf bmat:naturalStoneAttribute .

brcomp:AbutmentBenching a owl:Class ;
    rdfs:label "Auflagerbank eines Widerlagers"@de,
        "Benching of an abutment"@en ;
    rdfs:comment "Part of a Abutment on which a Bearing is installed."@en ;
    rdfs:subClassOf brcomp:AbutmentComponent .

brcomp:AbutmentChamberWall a owl:Class ;
    rdfs:label "Kammerwand eines Widerlagers"@de,
        "Chamber wall of an abutment"@en ;
    rdfs:comment "Front wall of Abutment."@en ;
    rdfs:subClassOf brcomp:AbutmentComponent .

brcomp:AbutmentFooting a owl:Class ;
    rdfs:label "Fundamentplatte eines Widerlagers"@de ;
    rdfs:comment "Abutment footing"@en,
        "Footing / foundation of Abutment."@en ;
    rdfs:subClassOf brcomp:AbutmentComponent .

brcomp:AbutmentWingWall a owl:Class ;
    rdfs:label "Fluegelwand eines Widerlagers"@de,
        "Wing wall of an abutment"@en ;
    rdfs:comment "Side wall of Abutment."@en ;
    rdfs:subClassOf brcomp:AbutmentComponent .

brcomp:Arch a owl:Class ;
    rdfs:label "Brückenbogen"@de,
        "Arch"@en ;
    rdfs:comment "No clearly visible separation between the superstructure and the substructure . The arch of the bridge loads the transom diagonally outwards. Both vertical and horizontal forces are transmitted into it."@en ;
    rdfs:subClassOf brcomp:SubStructureComponent,
        brcomp:SuperStructureComponent .

brcomp:BearingSeat a owl:Class ;
    rdfs:label "Lagersockel"@de,
        "Bearing seat"@en ;
    rdfs:comment "Component placed on the Bearing and serves to transfer forces over a larger area."@en ;
    rdfs:subClassOf brcomp:SubStructureComponent .

brcomp:BirdsProtection a owl:Class ;
    rdfs:label "Vogelschutz"@de,
        "Birds protection"@en ;
    rdfs:comment "Components for protecting niches or interstices from birds."@en ;
    rdfs:subClassOf brcomp:FinishingComponent .

brcomp:Cable a owl:Class ;
    rdfs:label "Cable"@de,
        "Seil"@de ;
    rdfs:comment "Steel cable that is installed on a Pylon and takes tensile loads from the superstructure."@en ;
    rdfs:subClassOf brcomp:TensionComponent .

brcomp:CableAnchoringDevice a owl:Class ;
    rdfs:label "Seilverankerung"@de,
        "Cable anchoring device"@en ;
    rdfs:comment "Component for anchoring steel cables of a bridge to Pylon."@en ;
    rdfs:subClassOf brcomp:SuperStructureComponent .

brcomp:ConcreteStayTensionComponent a owl:Class ;
    rdfs:label "Zugglieder aus Stahlbeton"@de,
        "Tension component as a concrete stay"@en ;
    rdfs:comment "Concrete components subjected to tensile stress."@en ;
    rdfs:subClassOf brcomp:TensionComponent .

brcomp:ConstructionJoint a owl:Class ;
    rdfs:label "Arbeitsfuge"@de,
        "Construction joint"@en ;
    rdfs:comment "Separation lines within components. They occur, for example, in concrete construction as set-down joints between successive concreting sections. Concreting in several stages is often unavoidable due to the construction process. The aim is to create the best possible bond between the adjacent concreting sections. Since the reinforcement runs through the construction joints, a traditional shuttering of the concreting section with wood would be costly. Today, expanded metal is mostly used for this purpose, which can be easily cut and bent to size and guarantees a certain degree of interlocking of the concreting sections. If, for example, a straight line of joints is desired for aesthetic reasons, formwork panels can be used in combination with a reverse bending connection for the reinforcing irons, which allow subsequent interlocking by bending up the reinforcing bars as the concreting process continues. In engineering structures such as bridges, screw connections are used to connect the reinforcement steel over construction joints due to the higher loads."@en ;
    rdfs:subClassOf brot:Joint .

brcomp:CouplingJoint a owl:Class ;
    rdfs:label "Koppelfuge"@de,
        "Coupling joint"@en ;
    rdfs:comment "Necessary in prestressed concrete construction if the component has to be constructed in several sections, e.g. in bridge construction. The individual components are coupled to each other at the coupling joints and the tendons are connected to each other, e.g. bolted, depending on the prestressing method"@en ;
    rdfs:subClassOf brot:Joint .

brcomp:Drainage a owl:Class ;
    rdfs:label "Entwaesserung"@de,
        "Drainage"@en ;
    rdfs:comment "Technical systems that counteract waterlogging on the bridge construction."@en ;
    rdfs:subClassOf brcomp:FinishingComponent .

brcomp:ElastomericBearings a owl:Class ;
    rdfs:label "Verformungslager"@de,
        "Elastomeric bearings"@en ;
    rdfs:comment "Bearings made of chloroprene rubber (CR) or natural rubber (NR)."@en ;
    rdfs:subClassOf brcomp:FixedBearingComponent .

brcomp:ExpansionJoint a owl:Class ;
    rdfs:label "Dehnungs-/Bewegungsfuge"@de,
        "Expansion/movement joint"@en ;
    rdfs:comment "Joint for interrupting components in order to prevent stress cracking."@en ;
    rdfs:subClassOf brot:Joint .

brcomp:Footing a owl:Class ;
    rdfs:label "Gruendung"@de,
        "Footing"@en ;
    rdfs:comment "Flat foundation which rests on the ground."@en ;
    rdfs:subClassOf brcomp:FoundationComponent .

brcomp:GirderBracing a owl:Class ;
    rdfs:label "Aussteifung (stabfoermiges Component)"@de,
        "Bracing (bar-shaped component)"@en ;
    rdfs:comment "Bracing component aggregated in a Girder."@en ;
    rdfs:subClassOf brcomp:GirderComponent .

brcomp:GirderCrossGirder a owl:Class ;
    rdfs:label "Querbalken"@de,
        "Cross girder"@en ;
    rdfs:comment "Querbalken des Brueckendeckquerschnitts"@de,
        "cross girder of the bridge beam cross-section"@en ;
    rdfs:subClassOf brcomp:GirderComponent .

brcomp:GirderDiaphragm a owl:Class ;
    rdfs:label "Versteifungsdiaphragma"@de,
        "Stiffening diaphgragm"@en ;
    rdfs:comment "Plate-shaped component used for bracing the Girder."@en ;
    rdfs:subClassOf brcomp:GirderComponent .

brcomp:GirderDownPlate a owl:Class ;
    rdfs:label "Girder down plate"@en,
        "Unterplatte"@en ;
    rdfs:comment "Untere Platte des Brueckendeckquerschnitts"@de,
        "Lower plate of the bridge beam cross-section"@en ;
    rdfs:subClassOf brcomp:GirderComponent .

brcomp:GirderMainGirder a owl:Class ;
    rdfs:label "Main girder",
        "Längsbalken"@de ;
    rdfs:comment "Balken in der Längsrichtung des Brückendeckquerschnitts"@de,
        "Girder component in longitudinal direction of the bridge beam cross-section"@en ;
    rdfs:subClassOf brcomp:GirderComponent .

brcomp:GroundAnchoringDevice a owl:Class ;
    rdfs:label "Erdverankerung"@de,
        "Ground anchoring device"@en ;
    rdfs:comment "Component that anchors the Foundation to the ground below."@en ;
    rdfs:subClassOf brcomp:SubStructureComponent .

brcomp:Illumination a owl:Class ;
    rdfs:label "Beleuchtung"@de,
        "Illumination"@en ;
    rdfs:comment "Technical system for illuminating the bridge mainly for traffic but also could be also installed for decorative effects."@en ;
    rdfs:subClassOf brcomp:FinishingComponent .

brcomp:NoiseBarrier a owl:Class ;
    rdfs:label "Laermschutz"@de,
        "Noise barrier"@en ;
    rdfs:comment "Components and technical systems for noise abatement and part of immission control. It is intended to ensure the well-being of humans and animals with regard to noise."@en ;
    rdfs:subClassOf brcomp:FinishingComponent .

brcomp:PinBearing a owl:Class ;
    rdfs:label "Punktkipplager"@de ;
    rdfs:comment "Fixed bearings that allow tilting about any axis."@en ;
    rdfs:subClassOf brcomp:FixedBearingComponent .

brcomp:PrefabricatedComponent a owl:Class ;
    rdfs:label "Fertigteil"@de,
        "Prefabricated component"@en ;
    rdfs:comment "Finished parts made of raw materials or semi-finished products that can be used for construction without further processing."@en ;
    rdfs:subClassOf brot:Component .

brcomp:Pylon a owl:Class ;
    rdfs:label "Pylon"@de,
        "Tower/pylon"@en ;
    rdfs:comment "In bridge construction, the high towering component over which the suspension cables of suspension bridges run or to which the stay cables of cable-stayed bridges are anchored."@en ;
    rdfs:subClassOf brcomp:SubStructureComponent,
        brcomp:SuperStructureComponent .

brcomp:ReinforcingBar a owl:Class ;
    rdfs:label "Bewehrungsstab"@de,
        "Reinforcing bar"@en ;
    rdfs:comment "Serves as reinforcement of reinforced concrete components and is cast with concrete after installation in the formwork."@en ;
    rdfs:subClassOf brcomp:ReinforcingComponent .

brcomp:ReinforcingMesh a owl:Class ;
    rdfs:label "Bewehrungsmatte"@de,
        "Reinforcing mesh"@en ;
    rdfs:comment "Wire mesh made of welded bars of reinforcing steel, which are used for the reinforcement of flat reinforced concrete components."@en ;
    rdfs:subClassOf brcomp:ReinforcingComponent .

brcomp:RockerBearing a owl:Class ;
    rdfs:label "Linienkipplager"@de,
        "Rocker bearing"@en ;
    rdfs:comment "Fixed bearing that only allows tilting movements around the bearing axis (one-sided tilting). They are only suitable if no significant tilting movements are to be expected across the bridge axis; i.e. for straight or slightly curved bridges with small bearing spacings as well as rigid cross members and rigid piers."@en ;
    rdfs:subClassOf brcomp:FixedBearingComponent .

brcomp:RollerBearing a owl:Class ;
    rdfs:label "Rollenlager"@de,
        "Roller bearing"@en ;
    rdfs:comment "One-sided movable Bearings which allow one-sided tilting. They have a limited use like the line tilting bearings. One or more cylindrical rollers are located between the plane-parallel surfaces of the upper and lower bearing plates. In the standard version with one roller, tilting around the roller axis is possible. It is possible to transmit horizontal forces perpendicular to the direction of movement. Since the direction of movement must be perpendicular to the tilting direction, they are not suitable for inclined bridges."@en ;
    rdfs:subClassOf brcomp:MovableBearingComponent .

brcomp:SlidingBearing a owl:Class ;
    rdfs:label "Gleitlager"@de,
        "Sliding bearings"@en ;
    rdfs:comment "In the case of sliding bearings movable on one side, 2 guide pads with austenitic sheet steel are attached to the sliding plate. They transmit the horizontal forces via embedded PTFE to the upper bearing plate."@en ;
    rdfs:subClassOf brcomp:MovableBearingComponent .

brcomp:SphericalBearings a owl:Class ;
    rdfs:label "Kalottenlager"@de,
        "Spherical bearings"@en ;
    rdfs:comment "Bearing thatenables the displacement and sliding movement in a flat and a curved sliding surface between the steel bearing plates. Spherical bearings generally act as biaxially displaceable pin bearings."@en ;
    rdfs:subClassOf brcomp:FixedBearingComponent .

brcomp:TendonAnchoringDevice a owl:Class ;
    rdfs:label "Spanngliedverankerung"@de,
        "Tendon anchoring device"@en ;
    rdfs:comment "The task of the TendonAnchoringDevice is to transfer the forces of the tendon to the concrete. This is usually done with anchor plates to which the prestressing steel transmits the forces through wedge anchoring, upset heads or nuts."@en ;
    rdfs:subClassOf brcomp:ReinforcingComponent .

brcomp:TrafficBarrier a owl:Class ;
    rdfs:label "Leiteinrichtung"@de,
        "Traffic barrier"@en ;
    rdfs:comment "Road components to clarify traffic guidance for road users."@en ;
    rdfs:subClassOf brcomp:FinishingComponent .

brcomp:coatingArea a owl:DatatypeProperty ;
    rdfs:label "Abdichtungsfläche"@de,
        "coating area"@en ;
    rdfs:comment """Gibt die Fläche des abgedichteten Bereichs an.

Einheit in [m²]"""@de,
        """Specifies the area of the used coating on a component.

Unit in [m²]."""@en ;
    rdfs:domain brot:Coating .

brcomp:coatingThickness a owl:DatatypeProperty ;
    rdfs:label "Abdichtungsdicke"@de,
        "coating thickness"@en ;
    rdfs:comment """Dicke (Dichtungsschicht + Schutzschicht)

Einheit in [cm]"""@de,
        """Thickness (sealing layer + protective layer)

Unit in [cm]"""@en ;
    rdfs:domain brot:Coating .

brcomp:concreteCover a owl:DatatypeProperty ;
    rdfs:label "Betondeckung"@de,
        "concrete cover"@en ;
    rdfs:comment "Distance between the concrete surface and the outer edge of a reinforcing steel coated with concrete of a Component."@en .

brcomp:criticalTempSummer a owl:DatatypeProperty ;
    rdfs:label "Kritische Temperatur Sommer"@de,
        "Citical Temperature Summer"@en ;
    rdfs:comment """Gibt die Kritische Temperatur für Lagerbauteile im Sommer an.

Einheit in [Celsius]"""@de,
        """Specifies the critical temperature for a Bearing in summer.

Unit in [Celsius]."""@en ;
    rdfs:domain brcomp:Bearing .

brcomp:criticalTempWinter a owl:DatatypeProperty ;
    rdfs:label "Kritische Temperatur Winter"@de,
        "Citical Temperature Winter"@en ;
    rdfs:comment """Gibt die Kritische Temperatur für Lagerbauteile im Winter an.

Einheit in [Celsius]"""@de,
        """Specifies the critical temperature for a Bearing in winter.

Unit in [Celsius]."""@en ;
    rdfs:domain brcomp:Bearing .

brcomp:diameter a owl:DatatypeProperty ;
    rdfs:label "Durchmesser"@de,
        "diameter"@en ;
    rdfs:comment """Durchmesser für runde Bauobjekte wie z.B. Pfähle, Pfeiler, etc.

Einheit in [m]."""@de,
        """Diameter for round Component such as piles, pillars, etc.

Unit in [m]."""@en ;
    rdfs:domain brot:Component .

brcomp:height a owl:DatatypeProperty ;
    rdfs:label "Höhe"@de,
        "height"@en ;
    rdfs:comment """Gibt die Höhe eines Brückenbauteils an.

Einheit in [m]."""@de,
        """Specifies the height of a bridge component.

Unit in [m]."""@en ;
    rdfs:domain brot:Component .

brcomp:installationYear a owl:DatatypeProperty ;
    rdfs:label "Einbaujahr"@de,
        "installation year"@en ;
    rdfs:comment "Year on which the Component has been installed."@en ;
    rdfs:domain brot:Component ;
    rdfs:range xsd:gYear .

brcomp:length a owl:DatatypeProperty ;
    rdfs:label "Länge"@de,
        "length"@en ;
    rdfs:comment """Gibt die Länge eines Brückenbauteils an.

Einheit in [m]"""@de,
        """Specifies the length of a Component.

Unit in [m]"""@en ;
    rdfs:domain brot:Component .

brcomp:seaWaterContact a owl:DatatypeProperty ;
    rdfs:label "sea water contact"@en ;
    rdfs:comment "Defines whether a Component has contact with sea water"@en ;
    rdfs:domain brot:Component ;
    rdfs:range xsd:boolean .

brcomp:tendonDirection a owl:DatatypeProperty ;
    rdfs:label "Vorspannungsrichtung"@de,
        "tendon direction"@en ;
    rdfs:comment "Gibt die Vorspannungsrichtung an."@de,
        "Defines the tendon direction."@en ;
    rdfs:domain brot:Tendon .

brcomp:tendonInternal a owl:DatatypeProperty ;
    rdfs:label "Interne Vorspannung"@de,
        "internal tendon"@en ;
    rdfs:comment "Gibt an, ob Vorspannung extern oder intern verbaut ist. True bei interner Vorspannung und false bei externer Vorspannung."@de,
        "Defines whether a tendon is external or internal. True if the tendon is internal. False if the tendon is external."@en ;
    rdfs:domain brot:Tendon ;
    rdfs:range xsd:boolean .

brcomp:type a owl:DatatypeProperty ;
    rdfs:label "Typenbezeichnung"@de,
        "type specification"@en ;
    rdfs:comment "Gibt die Bezeichnung des Bauteiltyps an"@de,
        "Specifies the name of the component type."@en ;
    rdfs:domain brot:Component .

brcomp:width a owl:DatatypeProperty ;
    rdfs:label "Breite"@de,
        "width"@en ;
    rdfs:comment """Gibt die Breite eines Brückenbauteils an.

Einheit in [m]."""@de,
        """Specifies the width of a bridge member.

Unit in [m]."""@en ;
    rdfs:domain brot:Component .

bridge:BeamBridge a owl:Class ;
    rdfs:label "Balkenbrücke"@de,
        "Beam bridge"@en ;
    rdfs:comment "The external characteristic of the beam bridge is usually the visible separation of the superstructure (bridge girder) from the substructure (supports, abutments) by bearings. The bearings transfer the loads from the superstructure to the substructures and give the bridge girder the necessary positional stability and movement capability. The cross-sectional shape in the longitudinal direction corresponds externally to a beam, usually the girder height is constant. Superstructures with variable superstructure heights are possible. As a rule, the bottom chord has a curvature corresponding to the moment load, it is vouched. The beam makes optimum use of the strength of the material and is used as a static system for conventional bridges with small to medium spans (approx. 80 m). Economical spans for beam bridges are up to 100 m, approx. 100-200 m for Extradosed bridges and from 200 m for cable-stayed bridges. The beam bridge is frequently used because of its comparatively simple construction. Many bridges over motorways are designed in this way. Beam bridges can be constructed in transverse direction with different cross-section geometries."@en ;
    rdfs:subClassOf brot:Bridge .

bridge:ReinforcedConcreteBridge a owl:Class ;
    rdfs:label "Reinforced concrete bridge"@en ;
    rdfs:comment "Bridge that uses reinforced concrete as building material."@en ;
    rdfs:subClassOf brot:Bridge .

bridge:angle a owl:DatatypeProperty ;
    rdfs:label "Bauwerkswinkel"@de,
        "construction angle"@en ;
    rdfs:comment """Angle of construction related to site.
Unit in  [°]."""@en ;
    rdfs:domain brot:Bridge .

bridge:bridgeArea a owl:DatatypeProperty ;
    rdfs:label "Brückenfläche"@de,
        "bridge area"@en ;
    rdfs:comment "Gibt die Gesamtfläche der Überbauelemente der Brücke an. Einheit in [m²]."@de,
        """Specifies the total area of the superstructure components of the bridge. 
Unit in [m²]."""@en ;
    rdfs:domain brot:Bridge ;
    rdfs:range xsd:positiveInteger .

bridge:bridgeWidth a owl:DatatypeProperty ;
    rdfs:label "Breite"@de,
        "bridge width"@en ;
    rdfs:comment "Gibt die Breite der Brücke an (ohne Ausbau). Einheit in [m]."@de,
        """Specifies the width of the bridge (without extension). 
Unit in [m]."""@en ;
    rdfs:domain brot:Bridge .

bridge:clearHeight a owl:DatatypeProperty ;
    rdfs:label "Lichte Höhe"@de,
        "clear height"@en ;
    rdfs:comment """defines the height which needs to fulfil the following criteria:

- free space between the roadway and the lower edge of the superstructure of a bridge or between its piers or columns;

- vertical space in the cross-section of the road to be kept clear of obstacles

Unit in [m]."""@en ;
    rdfs:domain brot:Bridge .

bridge:clearWidthSingleSpan a owl:DatatypeProperty ;
    rdfs:label "Lichte Weite bei Einfeld"@de,
        "clear width of single span"@en ;
    rdfs:comment """defines the width of a single span which needs to fulfil the following criteria:

- free space between the roadway and the lower edge of the superstructure of a bridge or between its piers or columns;

- vertical space in the cross-section of the road to be kept clear of obstacles

Unit in [m]."""@en ;
    rdfs:domain brot:Bridge .

bridge:completedDataAcquisition a owl:DatatypeProperty ;
    rdfs:label "Datenerf. abgeschl."@de,
        "completed data acquisition"@en ;
    rdfs:comment """Gibt an, ob die Datenerfassung abgeschlossen worden ist.

true = Datenerf. abgeschlossen
false = Datenerf. nicht abgeschlossen / unvollständig"""@de,
        """Indicates whether data acquisition has been completed.

true = data acquisition completed
false = data acquisition not completed / incomplete"""@en ;
    rdfs:domain brot:Bridge ;
    rdfs:range xsd:boolean .

bridge:constructionYear a owl:DatatypeProperty ;
    rdfs:label "Baujahr"@de,
        "construction year"@en ;
    rdfs:comment "Year in which the bridge has been constructed."@en ;
    rdfs:domain brot:Bridge ;
    rdfs:range xsd:gYear .

bridge:curvature a owl:DatatypeProperty ;
    rdfs:label "Krümmung"@de,
        "curvature"@en ;
    rdfs:comment "Gibt die Krümmung der Brückenplatte an. Krümmung kann entweder mit R in [m] angegeben werden oder als \"false\" bzw. nicht gekrümmt."@de,
        "Specifies the curvature of the bridge plate. Curvature can either be specified with radius in [m] or as \"false\" or not curved."@en ;
    rdfs:domain brot:Bridge .

bridge:directionOrigin a owl:ObjectProperty ;
    rdfs:label "Richtungsursprung"@de,
        "direction origin"@en ;
    rdfs:comment "Gibt an, von welcher Himmelsrichtung kommend das Bauwerk errichtet werden soll (BW-Richtung)"@de,
        "Specifies the direction from which the building is to be constructed."@en ;
    rdfs:domain brot:Bridge ;
    rdfs:range <http://dbpedia.org/page/Orientation_(geometry)> .

bridge:directionTarget a owl:ObjectProperty ;
    rdfs:label "Richtungsziel"@de,
        "direction target"@en ;
    rdfs:comment "Gibt an, zu welcher Himmelsrichtung zielend das Bauwerk errichtet werden soll (BW-Richtung)"@de,
        "Indicates the direction in which the building is to be constructed."@en ;
    rdfs:domain brot:Bridge ;
    rdfs:range <http://dbpedia.org/page/Orientation_(geometry)> .

bridge:fileID a owl:DatatypeProperty ;
    rdfs:label "Bauwerksakte-Nr."@de,
        "file ID"@en ;
    rdfs:comment "Referes to the file ID of the corresponding construction file."@en ;
    rdfs:domain brot:Bridge .

bridge:hasMainResponsible a owl:ObjectProperty ;
    rdfs:label "Baulast Konstrukt"@de,
        "has main responsible"@en ;
    rdfs:comment "Relationship between a Bridge and the main responsible dbo:Organisation that administrates the Bridge."@en ;
    rdfs:domain brot:Bridge ;
    rdfs:range ontology:Organisation ;
    rdfs:subPropertyOf bridge:hasResponsible .

bridge:hasResponsibleDepartment a owl:ObjectProperty ;
    rdfs:label "Amt"@de,
        "has responsible department"@en ;
    rdfs:comment "Zuständiges Amt für betroffene Brücke"@de,
        "Relationship between a Bridge and a responsible department that administrates the Bridge."@en ;
    rdfs:domain brot:Bridge ;
    rdfs:range bridge:Department ;
    rdfs:subPropertyOf bridge:hasResponsible .

bridge:hasResponsibleWorkshop a owl:ObjectProperty ;
    rdfs:label "has responsible workshop"@en ;
    rdfs:comment "Relationship between a Bridge and a responsible workshop."@en ;
    rdfs:domain brot:Bridge ;
    rdfs:range bridge:Workshop ;
    rdfs:subPropertyOf bridge:hasResponsible .

bridge:hasUIUAPartner a owl:ObjectProperty ;
    rdfs:label "UI/UA pflichtiger Partner"@de,
        "has UI/UA responsible partner"@en ;
    rdfs:comment "Relationship between a Bridge and a responsible UI/UA responsible partner."@en ;
    rdfs:domain brot:Bridge ;
    rdfs:range ontology:Organisation ;
    rdfs:subPropertyOf bridge:hasResponsible .

bridge:historicPreservation a owl:DatatypeProperty ;
    rdfs:label "Denkmalschutz"@de,
        "historic preservation"@en ;
    rdfs:comment """Gibt an, ob das Bauwerk unter Denkmalschutz steht.

true = Bauwerk unter Denkmalschutz
false = kein Denkmalschutz"""@de,
        """Indicates whether the building is under monument protection.

true = building under monument protection
false = no monument protection"""@en ;
    rdfs:domain brot:Bridge ;
    rdfs:range xsd:boolean .

bridge:maxConstructionHeight a owl:DatatypeProperty ;
    rdfs:label "Konstruktionshöhe max."@de,
        "maximum construction height"@en ;
    rdfs:comment "Gibt die maximale Konstruktionshöhe an. Einheit in [m]."@de,
        """Specifies the maximum construction height. 

Unit in [m]."""@en ;
    rdfs:domain brot:Bridge .

bridge:maxCoveredHeight a owl:DatatypeProperty ;
    rdfs:label "Max. Überschüttungshöhe"@de,
        "maximum covered height"@en ;
    rdfs:comment """Specifies the maximum covered height. 

Unit in [m]."""@en ;
    rdfs:domain brot:Bridge .

bridge:maxLongitudinalGradient a owl:DatatypeProperty ;
    rdfs:label "Maximale Längsneigung"@de,
        "maximum longitudinal gradient"@en ;
    rdfs:comment "Gibt die maximale Längsneigung der Brückenplatte an. Einheit in [%]."@de,
        """Specifies the maximum longitudinal inclination of the bridge slab. 

Unit in [%]."""@en ;
    rdfs:domain brot:Bridge .

bridge:maxTransverseGradient a owl:DatatypeProperty ;
    rdfs:label "maximale Querneigung"@de,
        "maximum transverse gradient"@en ;
    rdfs:comment "Gibt die maximale Querneigung der Brückenplatte an. Einheit in [%]."@de,
        """Specifies the maximum transverse inclination of the bridge slab. 

Unit in [%]."""@en ;
    rdfs:domain brot:Bridge .

bridge:minConstructionHeight a owl:DatatypeProperty ;
    rdfs:label "Konstruktionshöhe min."@de,
        "minimum construction height"@en ;
    rdfs:comment "Gibt die minimale Konstruktionshöhe an. Einheit in [m]."@de,
        """Specifies the minimum construction height.

Unit in [m]."""@en ;
    rdfs:domain brot:Bridge .

bridge:minCoveredHeight a owl:DatatypeProperty ;
    rdfs:label "Min. Überschüttungshöhe"@de,
        "minimum covered height"@en ;
    rdfs:comment """Specifies the minimum covered height.

Unit in [m]."""@en ;
    rdfs:domain brot:Bridge .

bridge:overalLength a owl:DatatypeProperty ;
    rdfs:label "Gesamtlänge"@de,
        "overall length"@en ;
    rdfs:comment "Gibt die Gesamtlänge der Brücke an. Einheit in [m]."@de,
        """Specifies the total length of the bridge.

Unit in [m]."""@en ;
    rdfs:domain brot:Bridge ;
    rdfs:range xsd:positiveInteger .

bridge:overallWidth a owl:DatatypeProperty ;
    rdfs:label "Gesamtbreite"@de,
        "overall width"@en ;
    rdfs:comment "Gibt die Gesamtbreite der Brücke an. Einheit in [m]."@de,
        """Specifies the total width of the bridge. 

Unit in [m]."""@en ;
    rdfs:domain brot:Bridge .

bridge:spacingSuperStructure a owl:DatatypeProperty ;
    rdfs:label "Zwischenraum Überbauten"@de,
        "spacing between superstructures"@en ;
    rdfs:comment "Gibt den Zwischenraum der Überbauten an. Einheit in [m]."@de,
        """Specifies the space between the superstructures. 

Unit in [m]."""@en ;
    rdfs:domain brot:Bridge .

bridge:underTraffic a owl:DatatypeProperty ;
    rdfs:label "Stadium"@de,
        "under traffic"@en ;
    rdfs:comment """Gibt an ob die Brücke einer Verkehrslast ausgesetzt ist bzw. befahren wird.

true = Unter Vekehr / befahren
false = Nicht unter Verkehr / gesperrt"""@de,
        """Indicates whether the bridge is exposed to a traffic load.

true = Under traffic / traffic
false = Not under traffic / blocked"""@en ;
    rdfs:domain brot:Bridge ;
    rdfs:range xsd:boolean .

brot:containsZone a owl:AnnotationProperty .

brot:hasCoating a owl:AnnotationProperty .

brstr:alignmentWidth a owl:DatatypeProperty ;
    rdfs:label "alignment width"@en ;
    rdfs:comment "Entfernung zum Alignment-Referenzpunkt"@de,
        "Distance to alignment reference point"@en .

brstr:assessmentYear a owl:DatatypeProperty ;
    rdfs:label "Einstufung (Jahr)"@de,
        "assessment year"@en ;
    rdfs:comment "The year in which the bridge structure has been assessed regarding the structural capability"@en ;
    rdfs:domain brstr:StructuralAssessment .

brstr:bears a owl:ObjectProperty ;
    rdfs:label "traegt"@de,
        "bears"@en ;
    rdfs:comment "Bei dieser Relation ist angegeben, dass ein Element ein anderes Element traegt, und als Folge die Last bekommt."@de,
        "This relationship points that an element bears an another element, and, as a result, gets some load."@en ;
    rdfs:domain brot:Component ;
    rdfs:range brot:Component ;
    rdfs:subPropertyOf brot:adjacentComponent,
        brot:locatedBelow,
        brstr:getsLoadsFrom ;
    owl:inverseOf brstr:restsOn .

brstr:breakingLimit a owl:DatatypeProperty ;
    rdfs:label "Bruchgrenze"@de,
        "breaking limit"@en ;
    rdfs:comment "Defines the breaking limit of a construction component."@en .

brstr:effectiveSupportCapacity a owl:DatatypeProperty ;
    rdfs:label "Effektive Stützweite"@de,
        "effective support capacity"@en ;
    rdfs:comment """Folgende Werte sind möglich:

- Dezimalwert in [m]

- 'reduced' für reduzierte Stützweite (kennzeichnet zu variierenden Wert)"""@de,
        """The following values are possible:

- Decimal value in [m].

- 'reduced' for reduced span (indicates value to be varied)"""@en ;
    rdfs:domain brstr:LoadBearingComponent .

brstr:hasStructuralAssessment a owl:ObjectProperty ;
    rdfs:label "has structural assessment"@en ;
    rdfs:comment "Relationship between a SpatialZone or Component and its corresponding StructuralAssessment."@en ;
    rdfs:range brstr:StructuralAssessment .

brstr:singleTrackLaneWidth a owl:DatatypeProperty ;
    rdfs:label "Einbahnverkehr"@de,
        "single track lane width"@en ;
    rdfs:comment "The width of a single track lane"@en ;
    rdfs:domain brstr:StructuralAssessmentSTANAG2021 .

brstr:spanWidth a owl:DatatypeProperty ;
    rdfs:label "Stützweite"@de,
        "span width"@en ;
    rdfs:comment "Width which is spanned by a component (bridge, vault, roof, floor slab) between the elements supporting this component (abutment, pier, column, support, load-bearing wall) without other support."@en ;
    rdfs:domain brstr:Span .

brstr:structuralCapabilityLevel a owl:DatatypeProperty ;
    rdfs:label "Tragfähigkeit (nach entsprechender Norm)"@de,
        "structural capability level"@en ;
    rdfs:comment "Structural capability grade based on German standard"@en ;
    rdfs:domain brstr:StructuralAssessment ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions () ] .

brstr:supportHeight a owl:DatatypeProperty ;
    rdfs:label "Stützungshöhe"@de,
        "support height"@en ;
    rdfs:comment "Gibt die Höhe der Stütze bzw. des stützenden Elements im Vergleich zum Nullpunkt an."@de,
        "Specifies the height of the column or supporting element compared to the zero point."@en ;
    rdfs:domain brstr:LoadBearingComponent .

brstr:twoTrackLaneWidth a owl:DatatypeProperty ;
    rdfs:label "Zweibahnverkehr"@de,
        "two track lane width"@en ;
    rdfs:comment "The width of a two track lanes"@en ;
    rdfs:domain brstr:StructuralAssessmentSTANAG2021 .

brstr:xMovement a owl:DatatypeProperty ;
    rdfs:label "Freiheitsgrad (x-Bewegungsrichtung)"@de,
        "X movement"@en ;
    rdfs:comment "Defines at which extend a LoadBearingComponent can move along the x-axis."@en ;
    rdfs:subPropertyOf brstr:movement,
        brstr:xDegreeOfFreedom .

brstr:xRotation a owl:DatatypeProperty ;
    rdfs:label "Freiheitsgrad (x-Rotationsrichtung)"@de,
        "X rotation"@en ;
    rdfs:comment "Defines at which extend a LoadBearingComponent can rotate along the x-axis."@en ;
    rdfs:subPropertyOf brstr:rotation,
        brstr:xDegreeOfFreedom .

brstr:yMovement a owl:DatatypeProperty ;
    rdfs:label "Freiheitsgrad (y-Bewegungsrichtung)"@de,
        "Y movement"@en ;
    rdfs:comment "Defines at which extend a LoadBearingComponent can move along the y-axis."@en ;
    rdfs:subPropertyOf brstr:movement,
        brstr:yDegreeOfFreedom .

brstr:yRotation a owl:DatatypeProperty ;
    rdfs:label "Freiheitsgrad (y-Rotationsrichtung)"@de,
        "Y rotation"@en ;
    rdfs:comment "Defines at which extend a LoadBearingComponent can rotate along the y-axis."@en ;
    rdfs:subPropertyOf brstr:rotation,
        brstr:yDegreeOfFreedom .

brstr:yieldStrength a owl:DatatypeProperty ;
    rdfs:label "Streckgrenze"@de,
        "yield strength"@en ;
    rdfs:comment "Defines the yield strength of a construction component."@en .

brstr:zMovement a owl:DatatypeProperty ;
    rdfs:label "Freiheitsgrad (z-Bewegungsrichtung)"@de,
        "Z movement"@en ;
    rdfs:comment "Defines at which extend a LoadBearingComponent can move along the z-axis."@en ;
    rdfs:subPropertyOf brstr:movement,
        brstr:zDegreeOfFreedom .

brstr:zRotation a owl:DatatypeProperty ;
    rdfs:label "Freiheitsgrad (z-Rotationsrichtung)"@de,
        "Z rotation"@en ;
    rdfs:comment "Defines at which extend a LoadBearingComponent can rotate along the z-axis."@en ;
    rdfs:subPropertyOf brstr:rotation,
        brstr:zDegreeOfFreedom .

ontology:AdministrativeRegion a owl:Class ;
    rdfs:subClassOf :BridgeInfrastructure .

<http://franz.com/ns/allegrograph/5.0/geo/nd#_lat_la_-9.+1_+9.+1_+1.-4_+1.-1_lon_lo_-1.8+2_+1.8+2_+1.-4> a rdfs:Datatype ;
    skos:prefLabel "nD Lat Lon" .

<http://http://www.opengis.net/ont/geosparql#Geometry> a owl:Class ;
    rdfs:subClassOf iso21972:ISO21972Thing .

<http://http://www.opengis.net/ont/geosparql#asWKT> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:subPropertyOf iso21972:i72DataProperty .

<http://http://www.opengis.net/ont/geosparql#hasGeometry> a owl:ObjectProperty ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

<http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Population_measure> a owl:Class ;
    rdfs:label "Population Measure",
        "gci:Cardinality_unit is the unit of measure for the size of a set. The gci:Cardinality_unit is a ratio scale: gci:Cardinality_scale, which is a subclass of om:Ratio_scale and is has a zero element (namely zero)." ;
    rdfs:comment "Reused from GCI Foundation ontology" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Cardinality_unit> ;
            owl:onProperty OM:hasUnit ],
        OM:CardinalityMeasure .

<http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#for_time_interval> a owl:ObjectProperty ;
    rdfs:subPropertyOf om-1:OMProperty .

iso21972:Binary_prefix a owl:Class ;
    rdfs:subClassOf iso21972:ISO21972Thing .

iso21972:Cardinality a owl:Class ;
    rdfs:comment """Cardinality of the Population.
Note that there is no property that links Cardinality to a Variable."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass iso21972:Population ;
            owl:onProperty iso21972:cardinality_of ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        iso21972:Parameter .

iso21972:Cardinality_scale a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue iso21972:fixed_zero_cardinality ;
            owl:onProperty iso21972:zero_element ],
        iso21972:Ratio_scale .

iso21972:Cardinality_unit a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass iso21972:Cardinality_scale ;
            owl:onProperty [ owl:inverseOf iso21972:unit_of_measure ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        iso21972:Singular_unit .

iso21972:City a owl:Class ;
    rdfs:subClassOf iso21972:ISO21972Thing,
        schema1:City .

iso21972:Dimension a owl:Class ;
    rdfs:subClassOf iso21972:ISO21972Thing .

iso21972:Distinct_count a owl:Class ;
    rdfs:comment """Distinct_count class that is a Parameter that represents
         the number of distinct values of a property of the members of a
         Population"""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass iso21972:Population ;
            owl:onProperty iso21972:distinct_count_of ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        iso21972:Parameter .

iso21972:Feature a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass iso21972:Geometry ;
            owl:onProperty iso21972:hasGeometry ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        iso21972:ISO21972Thing,
        wgs84_pos:Feature .

iso21972:Geometry a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://http://www.opengis.net/ont/geosparql#asWKT> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://http://www.opengis.net/ont/geosparql#Geometry> .

iso21972:Interval_scale a owl:Class ;
    rdfs:label "interval scale"@en ;
    rdfs:subClassOf iso21972:Cardinal_scale .

iso21972:Mean a owl:Class ;
    rdfs:comment "Mean represents the mean value of a property all members of the Population have and is specified by the parameter_of_var property."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass iso21972:Population ;
            owl:onProperty iso21972:mean_of ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        iso21972:Parameter ;
    owl:disjointWith iso21972:Standard_deviation .

iso21972:Nominal_scale a owl:Class ;
    rdfs:label "nominal scale"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom iso21972:Measurement_scale_category ;
            owl:onProperty iso21972:element ],
        iso21972:Measurement_scale .

iso21972:Ordinal_scale a owl:Class ;
    rdfs:label "ordinal scale"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom iso21972:Ordered_measurement_scale_category ;
            owl:onProperty iso21972:element ],
        iso21972:Measurement_scale .

iso21972:Phenomenon a owl:Class ;
    rdfs:label "phenomenon"@en ;
    rdfs:comment "A phenomenon is the qualitative object (e.g., food, star, molecule) that has quantifiable (standardized) aspects (e.g, length, mass, time)."@en ;
    rdfs:subClassOf iso21972:ISO21972Thing .

iso21972:Sample_standard_deviation a owl:Class ;
    rdfs:subClassOf iso21972:Statistic .

iso21972:Sum a owl:Class ;
    rdfs:comment "Sum defines the sum over a variable possessed by members of the Population." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass iso21972:Population ;
            owl:onProperty iso21972:sum_of ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        iso21972:Parameter .

iso21972:Vectorial_or_tensorial_character a owl:Class ;
    rdfs:subClassOf iso21972:ISO21972Thing .

iso21972:base a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "base"@en ;
    rdfs:domain iso21972:Unit_exponentiation ;
    rdfs:range iso21972:Unit_of_measure ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty ;
    om-1:alternative_label "has base"@en .

iso21972:cardinality_of a owl:ObjectProperty ;
    rdfs:domain iso21972:Cardinality ;
    rdfs:range iso21972:Population ;
    rdfs:subPropertyOf iso21972:description_of .

iso21972:commonlyHasUnit a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "replaces unit_of_measure"@en ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

iso21972:cubic_metre a iso21972:Unit_exponentiation,
        owl:NamedIndividual ;
    iso21972:base iso21972:metre ;
    iso21972:exponent 3 .

iso21972:defined_by a owl:ObjectProperty ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

iso21972:distinct_count_of a owl:ObjectProperty ;
    rdfs:subPropertyOf iso21972:description_of .

iso21972:exponent a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "exponent"@en ;
    rdfs:domain iso21972:Unit_exponentiation ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf iso21972:i72DataProperty ;
    om-1:alternative_label "has exponent"@en .

iso21972:fixed_zero_cardinality a iso21972:Point,
        owl:NamedIndividual ;
    iso21972:numerical_value 0 .

iso21972:for_city a owl:ObjectProperty ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

iso21972:giga a iso21972:SI_prefix,
        owl:NamedIndividual ;
    iso21972:factor 1000000000 .

iso21972:gram a iso21972:Singular_unit,
        owl:NamedIndividual .

iso21972:hasGeometry a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:subPropertyOf <http://http://www.opengis.net/ont/geosparql#hasGeometry> .

iso21972:hasNumericalValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Replaces property: numerical_value" ;
    rdfs:subPropertyOf iso21972:i72DataProperty .

iso21972:hasPhenomenon a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "replace property: phenomenon"@en ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

iso21972:hasUnit a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "replaces property:unit_of_measure" ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

iso21972:hasValue a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "replaces property: value" ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

iso21972:has_Name a owl:DatatypeProperty ;
    rdfs:subPropertyOf iso21972:i72DataProperty .

iso21972:has_characteristic a owl:ObjectProperty ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty ;
    owl:inverseOf iso21972:is_characteristic_of .

iso21972:hecto_kilo a iso21972:SI_prefix,
        owl:NamedIndividual ;
    iso21972:factor 100000 .

iso21972:is_an_estimate_of a owl:ObjectProperty ;
    rdfs:domain iso21972:Statistic ;
    rdfs:range iso21972:Parameter ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

