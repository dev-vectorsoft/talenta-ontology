bmat:Aluminium a owl:Class ;
    rdfs:label "Aluminium"@en ;
    rdfs:comment "Building material that mainly consists of the chemical element Aluminium (AL, 13)"@en ;
    rdfs:subClassOf bmat:BuildingMaterial .

bmat:ReinforecementSteel a owl:Class ;
    rdfs:label "Reinforcement steel"@en ;
    rdfs:comment "Construction material that serves as reinforcement for reinforced concrete components. Is poured with concrete after installation in the formwork."@en ;
    rdfs:subClassOf bmat:BuildingMaterial .

brcomp:Abutment a owl:Class ;
    rdfs:label "Widerlagerelement"@de,
        "Abutment component"@en ;
    rdfs:comment "Structural component that creates the transition between the bridge structure and the earth dam."@en ;
    rdfs:subClassOf brcomp:SubStructureComponent .

brcomp:FoundationComponent a owl:Class ;
    rdfs:label "Foundation component"@en ;
    rdfs:comment "Component that is aggregated to the Foundation."@en ;
    rdfs:subClassOf brcomp:SubStructureComponent .

brcomp:Girder a owl:Class ;
    rdfs:label "Girder"@en ;
    rdfs:comment "Support beam used in construction. It is the main horizontal support of a structure which supports smaller beams. Girders often have an I-beam cross section composed of two load-bearing flanges separated by a stabilizing web, but may also have a box shape, Z shape, or other forms. A girder is commonly used to build bridges."@en ;
    rdfs:subClassOf brcomp:SuperStructureComponent .

brcomp:MasticAsphalt a owl:Class ;
    rdfs:label "Gussasphalt"@de ;
    rdfs:comment "Mixture of fine and coarse aggregates and bitumen that can be poured and spread during installation. Therefore, no compaction work is necessary when using mastic asphalt. Mastic asphalt is used as road surface, as floor covering and for waterproofing."@en ;
    rdfs:subClassOf brcomp:Asphalt .

brcomp:MovableBearingComponent a owl:Class ;
    rdfs:label "Bearing that transmits vertical forces and allows movements in at least one direction."@en ;
    rdfs:subClassOf brcomp:Bearing .

brcomp:Tendon a owl:Class ;
    rdfs:label "Spannglied"@de,
        "Tendon"@en ;
    rdfs:comment "Component made of high-strength steel, which is mainly used for prestressing in prestressed concrete construction."@en ;
    rdfs:subClassOf brcomp:ReinforcingComponent .

brcomp:TensionComponent a owl:Class ;
    rdfs:label "Zugglied"@de,
        "Tension component"@en ;
    rdfs:comment "Zugglied des Ueberbaus"@de,
        "Tension component of superstructure"@en ;
    rdfs:subClassOf brcomp:SuperStructureComponent .

bridge:Department a owl:Class ;
    rdfs:label "Department"@en ;
    rdfs:comment "Responsible department that administrates the bridge and its maintenance."@en ;
    rdfs:subClassOf ontology:Organisation .

bridge:RoadBridge a owl:Class ;
    rdfs:label "Road bridge"@en ;
    rdfs:comment "Bridge that can be used by motor vehicles and motor vehicles and usually also by pedestrians, bicycles and other vehicles."@en ;
    rdfs:subClassOf brot:Bridge .

brot:Tendon a owl:Class ;
    rdfs:subClassOf :BridgeInfrastructure .

brot:adjacentComponent a owl:ObjectProperty .

brot:containsComponent a owl:ObjectProperty .

brstr:xDegreeOfFreedom a owl:DatatypeProperty ;
    rdfs:label "degree of freedom along to X-axis"@en ;
    rdfs:comment "The degree of freedom at which a LoadBearingComponent can move or rotate along to the x-axis."@en ;
    rdfs:subPropertyOf brstr:degreeOfFreedom .

brstr:yDegreeOfFreedom a owl:DatatypeProperty ;
    rdfs:subPropertyOf brstr:degreeOfFreedom .

brstr:zDegreeOfFreedom a owl:DatatypeProperty ;
    rdfs:subPropertyOf brstr:degreeOfFreedom .

iso21972:Application_area a owl:Class ;
    rdfs:subClassOf iso21972:ISO21972Thing .

iso21972:Cardinal_scale a owl:Class ;
    rdfs:label "cardinal scale"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom iso21972:Fixed_point ;
            owl:onProperty iso21972:element ],
        iso21972:Measurement_scale .

iso21972:Compound_unit a owl:Class ;
    rdfs:label "compound unit"@en ;
    rdfs:subClassOf iso21972:Unit_of_measure .

iso21972:Fixed_point a owl:Class ;
    rdfs:label "fixed point"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( iso21972:Fixed_point iso21972:Measure iso21972:Quantity ) ] ;
            owl:onProperty iso21972:definition ],
        iso21972:Point .

iso21972:Indicator a owl:Class ;
    dc:description "An indicator is a quantity that is a ratio of a numerator and denominator that are also quantities. It has a city and time period associated with it. The numerator and denominator quantities can have different units of measure. One example of a unit of measure is the size of a population. A population_cardinality_unit is defined to be an individual of a Cardinality_unit that is a subclass of a Singular_unit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass iso21972:City ;
            owl:onProperty iso21972:for_city ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass time:DateTimeInterval ;
            owl:onProperty iso21972:for_time_interval ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        iso21972:ISO21972Thing,
        iso21972:Quantity .

iso21972:Unit_multiplication a owl:Class ;
    rdfs:label "unit multiplication"@en ;
    rdfs:subClassOf iso21972:Compound_unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty iso21972:term_1 ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty iso21972:term_2 ] ) ] .

iso21972:definition a owl:ObjectProperty ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

iso21972:element a owl:ObjectProperty ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

iso21972:is_described_by a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( iso21972:Population iso21972:Sample ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( iso21972:Parameter iso21972:Statistic ) ] ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty .

iso21972:term_1 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "term 1"@en ;
    rdfs:domain iso21972:Unit_multiplication ;
    rdfs:range iso21972:Unit_of_measure ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty ;
    om-1:alternative_label "has term 1"@en .

iso21972:term_2 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "term 2"@en ;
    rdfs:domain iso21972:Unit_multiplication ;
    rdfs:range iso21972:Unit_of_measure ;
    rdfs:subPropertyOf iso21972:iso21972ObjectProperty ;
    om-1:alternative_label "has term 2"@en .

OM:AmountOfMoneyUnit a owl:Class ;
    rdfs:label "amount of money unit" ;
    rdfs:subClassOf OM:Unit .

OM:CardinalityUnitPerTime a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Cardinality_unit> ;
            owl:onProperty OM:hasNumerator ],
        [ a owl:Restriction ;
            owl:allValuesFrom OM:TimeUnit ;
            owl:onProperty OM:hasDenominator ],
        OM:UnitDivision .

OM:MonetaryValue a owl:Class ;
    rdfs:comment """A Monetary Value has a numerical value that is relative to a particular date (year).
A Monetary Value is measured with some currency.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom OM:AmountOfMoneyUnit ;
            owl:onProperty OM:hasUnit ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:gYear ;
            owl:onProperty OM:hasRelativeYear ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        OM:Measure .

OM:average a OM:Function,
        owl:NamedIndividual .

OM:hasAggregateFunction a owl:ObjectProperty ;
    rdfs:domain OM:Quantity ;
    rdfs:range OM:Function ;
    rdfs:subPropertyOf om-1:OMProperty .

OM:hasDenominator a owl:ObjectProperty ;
    rdfs:label "has denominator" ;
    rdfs:domain OM:UnitDivision ;
    rdfs:range OM:Unit ;
    rdfs:subPropertyOf om-1:OMProperty .

OM:hasNumerator a owl:ObjectProperty ;
    rdfs:label "has numerator" ;
    rdfs:domain OM:UnitDivision ;
    rdfs:range OM:Unit ;
    rdfs:subPropertyOf om-1:OMProperty .

<http://ontology.eil.utoronto.ca/icity/SpatialLoc/hasLocation> a owl:ObjectProperty ;
    rdfs:comment "A property intended to relate non-spatial objects (e.g. activities) to a location(s) in space." ;
    rdfs:range geo:Feature ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icity/SpatialLoc/SpatialLocOntologyProperty> .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/ArcPD> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass time:Interval ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/existsAt> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationComplexPD> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/accessesComplex> ],
        [ a owl:Restriction ;
            owl:onClass <http://ontology.eil.utoronto.ca/icity/TransportationSystem/NodePD> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/endNode> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://ontology.eil.utoronto.ca/icity/TransportationSystem/NodePD> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/startNode> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://ontology.eil.utoronto.ca/icity/TransportationSystem/LinkPD> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/containedInLink> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://ontology.eil.utoronto.ca/icity/Change/TimeVaryingConcept>,
        <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyThing> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/hasManifestation> ;
                        owl:someValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Arc> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Arc> ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/hasManifestation> ] ) ] .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/Link> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom OM:MonetaryValue ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasToll> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass OM:Speed ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasPostedSpeed> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass OM:Speed ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasFreeFlowSpeed> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Mode> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/supportsMode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/Network> ;
            owl:onProperty [ owl:inverseOf <http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasNetworkComponent> ] ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasNumLanes> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass OM:Quantity ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasVDF> ],
        [ a owl:Restriction ;
            owl:onClass time:TemporalEntity ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/existsAt> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:intersectionOf ( OM:Quantity [ a owl:Restriction ;
                                owl:allValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( [ a owl:Restriction ;
                                                    owl:allValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( <http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#Cardinality_unit> [ a owl:Restriction ;
                                                                        owl:allValuesFrom [ a owl:Restriction ;
                                                                                owl:allValuesFrom [ a owl:Restriction ;
                                                                                        owl:allValuesFrom [ a owl:Restriction ;
                                                                                                owl:allValuesFrom <http://www.opengis.net/ont/gml#Arc> ;
                                                                                                owl:onProperty <http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation-v2.owl#defined_by> ] ;
                                                                                        owl:onProperty <http://ontology.eil.utoronto.ca/govstat.owl#cardinality_of> ] ;
                                                                                owl:onProperty [ owl:inverseOf OM:hasValue ] ] ;
                                                                        owl:onProperty [ owl:inverseOf OM:hasUnit ] ] ) ] ;
                                                    owl:onProperty OM:hasDenominator ] [ a owl:Restriction ;
                                                    owl:allValuesFrom [ a owl:Restriction ;
                                                            owl:allValuesFrom OM:CardinalityUnitPerTime ;
                                                            owl:onProperty OM:hasNumerator ] ;
                                                    owl:onProperty OM:hasUnit ] ) ] ;
                                owl:onProperty OM:hasValue ] ) ] ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/hasLinkCapacity> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://ontology.eil.utoronto.ca/icity/TransportationSystem/ArcPD> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/containsArc> ],
        [ a owl:Restriction ;
            owl:onClass OM:Length ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/associatedLinkLength> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://ontology.eil.utoronto.ca/icity/Change/Manifestation>,
        <http://ontology.eil.utoronto.ca/icity/TransportationSystem/TransportationOntologyThing> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/manifestationOf> ;
                        owl:someValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/LinkPD> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://ontology.eil.utoronto.ca/icity/TransportationSystem/LinkPD> ;
                        owl:onProperty <http://ontology.eil.utoronto.ca/icity/Change/manifestationOf> ] ) ] .

<http://ontology.eil.utoronto.ca/icity/TransportationSystem/LinkPD> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://ontology.eil.utoronto.ca/icity/TransportationSystem/NodePD> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icity/TransportationSystem/endNode> ;
